pragma Singleton
import QtQuick

// Estado comum do DATASHARD: idioma e textos da interface (o catálogo do back-end, arquivos.textos,
// vale por cima destes), mais utilitários de formatação. O Main liga "idioma" e "catalogo".
QtObject {
    id: d
    property string idioma: "pt_BR"
    property var catalogo: ({})
    property var janela: null            // o Main (ações comuns: clique, menu, soltar, renomear…)
    readonly property bool en: idioma === "en"

    function t(k, a) {
        let s = catalogo && catalogo[k] !== undefined ? catalogo[k] : ((en ? _en : _pt)[k] !== undefined ? (en ? _en : _pt)[k] : k)
        if (a) for (const n in a) s = s.split("{" + n + "}").join(a[n])
        return s
    }

    // tipo legível no idioma do app: rótulo do grupo + extensão ("Imagem · PNG"). A descrição do
    // sistema (mime), que mistura idiomas, fica só nas propriedades.
    function tipoDe(it) {
        if (!it) return ""
        if (it.ehPasta) return t("tipo.pasta")
        const r = t("tipo." + (it.grupo || "outro")), nome = it.nome || "", p = nome.lastIndexOf(".")
        return p > 0 && nome.length - p <= 6 ? r + " · " + nome.slice(p + 1).toUpperCase() : r
    }
    // linhas de arquivos.detalhes() com a linha TIPO trocada por tipoDe()
    function linhasDe(d) {
        if (!d || !d.linhas) return []
        const rt = t("det.tipo")
        return d.linhas.map(l => l.rotulo === rt && d.mime !== undefined ? { rotulo: l.rotulo, valor: tipoDe(d) } : l)
    }

    // ---- atalhos configuráveis (arquivos.atalhos: ação → "Ctrl+Shift+A", "F2", "Del", "Space"…)
    readonly property var _nomesTecla: ({
        [Qt.Key_Delete]: "Del", [Qt.Key_Return]: "Return", [Qt.Key_Enter]: "Return", [Qt.Key_Space]: "Space",
        [Qt.Key_Left]: "Left", [Qt.Key_Right]: "Right", [Qt.Key_Up]: "Up", [Qt.Key_Down]: "Down",
        [Qt.Key_Home]: "Home", [Qt.Key_End]: "End", [Qt.Key_PageUp]: "PgUp", [Qt.Key_PageDown]: "PgDown",
        [Qt.Key_Tab]: "Tab", [Qt.Key_Backtab]: "Tab", [Qt.Key_Backspace]: "Backspace", [Qt.Key_Insert]: "Ins",
        [Qt.Key_Plus]: "+", [Qt.Key_Minus]: "-", [Qt.Key_Equal]: "=", [Qt.Key_Escape]: "Esc", [Qt.Key_Menu]: "Menu"
    })
    // sequência de um evento de tecla, no formato do back-end ("" se só modificador)
    function seqDe(e) {
        const k = e.key
        if (k === Qt.Key_Control || k === Qt.Key_Shift || k === Qt.Key_Alt || k === Qt.Key_Meta || k === 0 || k === Qt.Key_unknown) return ""
        let nome = _nomesTecla[k]
        if (!nome && k >= Qt.Key_F1 && k <= Qt.Key_F35) nome = "F" + (k - Qt.Key_F1 + 1)
        if (!nome && k >= 0x20 && k <= 0x7e) nome = String.fromCharCode(k).toUpperCase()
        if (!nome) return ""
        let m = ""
        if (e.modifiers & Qt.ControlModifier) m += "Ctrl+"
        if (e.modifiers & Qt.AltModifier) m += "Alt+"
        if ((e.modifiers & Qt.ShiftModifier) && !(nome === "+" )) m += "Shift+"
        if (e.modifiers & Qt.MetaModifier) m += "Meta+"
        return m + nome
    }
    function _norm(s) {
        s = (s || "").replace(/\s+/g, "")
        const parts = s.split("+"), ult = s.endsWith("++") ? "+" : parts.pop()
        if (s.endsWith("++")) { parts.pop(); parts.pop() }
        const ord = ["Ctrl", "Alt", "Shift", "Meta"]
        const mods = ord.filter(o => parts.some(p => p.toLowerCase() === o.toLowerCase()))
        const al = { "Delete": "Del", "Enter": "Return", "Esc": "Esc", "Escape": "Esc", "PageUp": "PgUp", "PageDown": "PgDown" }
        const t = al[ult] || (ult.length === 1 ? ult.toUpperCase() : ult)
        return mods.concat([t]).join("+")
    }
    // o evento corresponde à ação? (Ctrl++ também casa com Ctrl+= e Ctrl+Shift+=, como no Dolphin)
    function casa(e, acao) {
        const seq = (arquivos.atalhos || {})[acao]
        if (!seq) return false
        const a = _norm(seq), b = _norm(seqDe(e))
        if (a === b) return true
        if (a === "Ctrl++") return b === "Ctrl+=" || b === "Ctrl+Shift+=" || b === "Ctrl+Shift++"
        return false
    }

    // código hex estável de um texto (quando o back-end não manda "codigo"): "0x3FA2C1"
    function hexDe(txt) {
        let h = 2166136261
        for (let i = 0; i < (txt || "").length; i++) { h ^= txt.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0 }
        return "0x" + (h & 0xFFFFFF).toString(16).toUpperCase().padStart(6, "0")
    }
    // código de barras determinístico a partir de um texto (0x3FA2C1 → larguras de barras)
    function barras(txt, n) {
        let h = 2166136261
        const s = String(txt || "")
        for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0 }
        let l = []
        for (let i = 0; i < n; i++) { h ^= h << 13; h ^= h >>> 17; h ^= h << 5; h >>>= 0; l.push(1 + (h % 4)) }
        return l
    }

