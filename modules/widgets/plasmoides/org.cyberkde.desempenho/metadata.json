            {
                "id": "limiar-cpu",
                "chave": "limiarCpu",
                "tipo": "inteiro",
                "min": 10,
                "max": 100,
                "padrao": 85,
                "unidade": "%",
                "nome": "Alerta de CPU acima de",
                "nome_en": "CPU alert above"
            },
            {
                "id": "limiar-temp",
                "chave": "limiarTemp",
                "tipo": "inteiro",
                "min": 40,
                "max": 110,
                "padrao": 85,
                "unidade": "°C",
                "nome": "Alerta de temperatura acima de",
                "nome_en": "Temperature alert above"
            }
        ]
