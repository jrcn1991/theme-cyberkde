        "Name[en]": "CyberKDE · Performance",
        "Description": "CPU por núcleo, memória, GPU, temperaturas, rede e disco no visual do tema",
        "Description[pt_BR]": "CPU por núcleo, memória, GPU, temperaturas, rede e disco no visual do tema",
        "Description[en]": "Per-core CPU, memory, GPU, temperatures, network and disk in the theme style",
        "Icon": "utilities-system-monitor",
        "Category": "System Information",
        "Authors": [
            {
                "Name": "CyberKDE"
            }
        ],
        "License": "GPL-3.0-or-later",
        "Version": "1.0",
