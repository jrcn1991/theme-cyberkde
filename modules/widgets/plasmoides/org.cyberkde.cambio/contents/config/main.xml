<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- último preset de tamanho: "pequeno", "medio" ou "grande" (antigos: compacto, completo) -->
    <entry name="modo" type="String"><default>pequeno</default></entry>
    <!-- interno: o preset de "modo" já foi aplicado uma vez -->
    <entry name="ajustado" type="Bool"><default>false</default></entry>
    <!-- opacidade da superfície dos cartões, em % -->
    <entry name="opacidade" type="Int"><default>95</default><min>30</min><max>100</max></entry>
    <!-- pares separados por vírgula; "USD" sozinho = USD-BRL. O primeiro é o principal (cartão pequeno) -->
    <entry name="moedas" type="String"><default>USD-BRL, EUR-BRL, BTC-BRL</default></entry>
    <!-- intervalo entre cotações, em minutos -->
    <entry name="intervaloMin" type="Int"><default>10</default><min>5</min><max>60</max></entry>
    <!-- dias do gráfico: "7" ou "30" (texto: é opção "escolha" do CLI) -->
    <entry name="periodo" type="String"><default>30</default></entry>
    <!-- par do gráfico (vazio = o principal); muda ao clicar numa linha -->
    <entry name="grafico" type="String"><default></default></entry>
    <!-- interno: últimas cotações e histórico, para mostrar algo sem sinal (JSON) -->
    <entry name="cache" type="String"><default></default></entry>
  </group>
</kcfg>
