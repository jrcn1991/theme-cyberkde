+void KItemListView::setItemsRevealPending(bool pending)
+{
+    m_revealPending = pending;
+    if (pending) {
+        m_revealTimeout->start();
+    } else {
+        m_revealTimeout->stop();
+    }
+}
+
+void KItemListView::revealVisibleItems()
+{
+    m_revealTimeout->stop();
+    if (!m_revealPending) {
+        return;
+    }
+    m_revealPending = false;
+
+    // Honors the global animation speed (System Settings > Animations); 0 means instant.
+    const qreal factor = KConfigGroup(KSharedConfig::openConfig(), QStringLiteral("KDE")).readEntry("AnimationDurationFactor", 1.0);
+    const int duration = qRound(220 * factor);
+
+    QList<int> indexes = m_visibleItems.keys();
+    std::sort(indexes.begin(), indexes.end());
+    const int count = indexes.count();
+
+    // 28 ms between items, but the whole cascade never takes more than ~450 ms.
+    const qreal stagger = count > 1 ? qMin(28.0, 450.0 / (count - 1)) * factor : 0.0;
+
+    for (int order = 0; order < count; ++order) {
+        KItemListWidget *widget = m_visibleItems.value(indexes[order]);
+        stopRevealAnimation(widget);
+        if (duration <= 0) {
+            continue;
+        }
+
+        auto *fade = new QVariantAnimation;
+        fade->setDuration(duration);
+        fade->setEasingCurve(QEasingCurve::OutCubic);
+        fade->setStartValue(0.0);
+        fade->setEndValue(1.0);
+        connect(fade, &QVariantAnimation::valueChanged, widget, [widget](const QVariant &value) {
+            const qreal progress = value.toReal();
+            widget->setOpacity(progress);
+            widget->setTransform(QTransform::fromTranslate(-12.0 * (1.0 - progress), 0.0));
+        });
+
+        auto *cascade = new QSequentialAnimationGroup(this);
+        cascade->addPause(qRound(order * stagger));
+        cascade->addAnimation(fade);
+        connect(cascade, &QAbstractAnimation::finished, this, [this, widget]() {
+            m_revealAnimations.remove(widget);
+        });
+        m_revealAnimations.insert(widget, cascade);
+
+        widget->setOpacity(0.0);
+        widget->setTransform(QTransform::fromTranslate(-12.0, 0.0));
+        cascade->start(QAbstractAnimation::DeleteWhenStopped);
+    }
+}
+
+void KItemListView::stopRevealAnimation(KItemListWidget *widget)
+{
+    if (QAbstractAnimation *cascade = m_revealAnimations.take(widget)) {
+        cascade->stop(); // DeleteWhenStopped also deletes it
+    }
+    widget->setOpacity(1.0);
+    widget->setTransform(QTransform());
+}
