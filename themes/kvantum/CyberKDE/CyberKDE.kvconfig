interior=true
interior.element=tooltip
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.margin=false
text.normal.color=#DCDCE4

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false

[Dialog]
interior=false
