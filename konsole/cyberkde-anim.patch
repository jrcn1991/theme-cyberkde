+CyberFxPalette cyberFxPalette(bool theme, const QColor &accent, const QColor &second, const QColor &warning)
+{
+    if (theme) {
+        // Accent (cyberkde cor), secondary and warning from ~/.config/cyberkde/paleta.
+        return {cyberMix(second, Qt::white, 0.65), second, accent, second, accent, warning};
+    }
+    // The cascade video: white-lavender, gold, red-orange, violet lines.
+    return {QColor(0xF4, 0xEE, 0xFC),
+            QColor(0xF0, 0xD0, 0x5C),
+            QColor(0xD8, 0x3E, 0x1C),
+            QColor(0x8C, 0x78, 0xDA),
+            QColor(0xE4, 0xA8, 0x30),
+            QColor(0xEE, 0x6C, 0x28)};
+}
+
+void cyberFxRead(CyberFxSettings &s)
+{
+    const KConfig config(QStringLiteral("konsolerc"), KConfig::SimpleConfig);
+    const KConfigGroup group(&config, QStringLiteral("CyberKDE"));
+    QFile file(cyberConfigPath(QStringLiteral("cyberkde/cor")));
+    const QColor accent = cyberHex(file.open(QIODevice::ReadOnly) ? QString::fromUtf8(file.readAll()) : QString(), QColor(0xF7, 0x50, 0x49));
+    QFile paletteFile(cyberConfigPath(QStringLiteral("cyberkde/paleta")));
+    const QJsonObject palette = paletteFile.open(QIODevice::ReadOnly) ? QJsonDocument::fromJson(paletteFile.readAll()).object() : QJsonObject();
+    const QColor second = cyberHex(palette.value(QStringLiteral("secundaria")).toString(), QColor(0x5E, 0xF6, 0xFF));
+    const QColor warning = cyberHex(palette.value(QStringLiteral("alerta")).toString(), QColor(0xF0, 0xB5, 0x37));
+
+    const auto level = [&group](const char *key, int fallback) {
+        return qBound(1, group.readEntry(key, fallback), 100) / 100.0;
+    };
+    const auto colors = [&](const char *key) {
+        return cyberFxPalette(group.readEntry(key, QStringLiteral("tema")) != QLatin1String("video"), accent, second, warning);
+    };
+    s.rain = group.readEntry("Chuva", false);
+    s.rainLevel = level("ChuvaIntensidade", 35);
+    s.rainDensity = qBound(1, group.readEntry("ChuvaDensidade", 50), 100);
+    s.rainUp = group.readEntry("ChuvaDirecao", QStringLiteral("cair")) == QLatin1String("subir");
+    s.rainColors = colors("ChuvaCores");
+    s.crt = group.readEntry("Crt", false);
+    s.crtLevel = level("CrtIntensidade", 30);
+    s.crtVignette = group.readEntry("CrtVinheta", true);
+    s.crtCurve = group.readEntry("CrtCurvatura", true);
+    s.sweep = group.readEntry("Varredura", false);
+    s.sweepLevel = level("VarreduraIntensidade", 40);
+    s.sweepInterval = qBound(5, group.readEntry("VarreduraIntervalo", 20), 600);
+    s.sweepColors = colors("VarreduraCores");
+    s.grid = group.readEntry("Grade", false);
+    s.gridLevel = level("GradeIntensidade", 30);
+    s.gridSize = qBound(1, group.readEntry("GradeTamanho", 3), 20);
+    s.gridColors = colors("GradeCores");
+    s.hud = group.readEntry("Hud", false);
+    s.hudLevel = level("HudIntensidade", 60);
+    s.hudData = group.readEntry("HudDados", true);
+    s.hudColors = colors("HudCores");
+    s.sparks = group.readEntry("Faiscas", false);
+    s.sparksLevel = level("FaiscasIntensidade", 60);
+    s.sparksColors = colors("FaiscasCores");
+    s.fail = group.readEntry("Erro", false);
+    s.failLevel = level("ErroIntensidade", 60);
+    s.bell = group.readEntry("Campainha", false);
+    s.bellLevel = level("CampainhaIntensidade", 60);
+    s.bellColors = colors("CampainhaCores");
+}
+
+CyberFxSettings &cyberFxSettings()
+{
+    static CyberFxSettings settings;
+    static bool loaded = false;
+    if (!loaded) {
+        loaded = true;
+        cyberFxRead(settings);
+        // Same debounced file watch as the cascade; connected before the terminals that use it.
+        QObject::connect(cyberCascadeNotifier(), &QTimer::timeout, [] {
+            CyberFxSettings &s = cyberFxSettings();
+            cyberFxRead(s);
+            ++s.generation;
+        });
+    }
+    return settings;
+}
+
+quint32 cyberHash(quint32 x)
+{
+    x ^= x >> 16;
+    x *= 0x7FEB352Du;
+    x ^= x >> 15;
+    x *= 0x846CA68Bu;
+    x ^= x >> 16;
+    return x;
+}
