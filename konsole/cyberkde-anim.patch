+int cyberGlyphIndex(char32_t c)
+{
+    const int index = c < 0x10000 ? CYBER_CASCADE_GLYPHS.indexOf(QChar(char16_t(c))) : -1;
+    return index >= 0 ? index : int(c % char32_t(CYBER_CASCADE_GLYPHS.size()));
+}
