+// Shape of the plume inside the cascade band: every lane is the same hyperbola-like curve, shifted
+// right. It runs along the horizon (the bottom of the band) from the left and turns up near the bend,
+// like the jet in the reference video. h is the height above the horizon.
+struct CyberPlume {
+    float left, right, width, top, horizon, height;
+    float bend; // x where the inner edge goes vertical
+    float spread; // horizontal width of the plume (all lanes) up high
+    float k, eps; // inner edge: x = bend - k / (h + eps)
+
+    CyberPlume(const QRect &band, int textLeft, int textRight)
+    {
+        left = textLeft;
+        right = textRight;
+        width = qMax(1.0f, right - left);
+        top = band.top();
+        horizon = band.bottom();
+        height = qMax(8.0f, horizon - top);
+        bend = left + 0.6f * width;
+        spread = qMin(0.24f * width, 3.6f * height);
+        eps = 0.05f * height;
+        k = (bend - (left + 0.18f * width)) * eps;
+    }
+    float widen(float h) const
+    {
+        return 0.55f + 0.45f * qMin(1.0f, h / height);
+    }
+    float x(float h, float lane) const
+    {
+        return bend + lane * spread * widen(h) - k / (h + eps);
+    }
+    float slope(float h, float lane) const // dx/dh
+    {
+        return k / ((h + eps) * (h + eps)) + (h < height ? lane * spread * 0.45f / height : 0.0f);
+    }
+    float heightAt(float px, float lane) const // where the lane passes over px; < 0 right of it
+    {
+        const float gap = bend + lane * spread * 0.55f - px;
+        return gap > 1.0f ? qMax(0.0f, k / gap - eps) : -1.0f;
+    }
+};
