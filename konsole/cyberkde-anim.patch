+// The settings, and a timer every terminal connects to: it fires (debounced) after the files change.
+QTimer *cyberCascadeNotifier();
+
+CyberCascadeSettings &cyberCascadeSettings()
+{
+    static CyberCascadeSettings settings;
+    static bool loaded = false;
+    if (!loaded) {
+        loaded = true;
+        cyberCascadeRead(settings);
+        cyberCascadeNotifier();
+    }
+    return settings;
+}
+
+QTimer *cyberCascadeNotifier()
+{
+    static QTimer *timer = nullptr;
+    if (timer == nullptr) {
+        timer = new QTimer(qApp);
+        timer->setSingleShot(true);
+        timer->setInterval(150);
+        // Connected before any terminal, so the settings are fresh when the terminals hear the timeout.
+        QObject::connect(timer, &QTimer::timeout, [] {
+            CyberCascadeSettings &s = cyberCascadeSettings();
+            CyberCascadeSettings fresh;
+            cyberCascadeRead(fresh);
+            if (fresh.on != s.on || fresh.lines != s.lines || fresh.stops != s.stops) {
+                fresh.generation = s.generation + 1;
+                s = fresh;
+            }
+        });
+        auto *watch = new KDirWatch(timer);
+        for (const QString &name : {QStringLiteral("konsolerc"), QStringLiteral("cyberkde/cor"), QStringLiteral("cyberkde/paleta")}) {
+            watch->addFile(cyberConfigPath(name));
+        }
+        const auto changed = [] {
+            cyberCascadeNotifier()->start();
+        };
+        QObject::connect(watch, &KDirWatch::dirty, timer, changed);
+        QObject::connect(watch, &KDirWatch::created, timer, changed);
+        QObject::connect(watch, &KDirWatch::deleted, timer, changed);
+    }
+    return timer;
+}
