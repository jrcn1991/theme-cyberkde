+qreal TerminalDisplay::cyberRevealProgress(int x, int y) const
+{
+    if (_cyberBirths.isEmpty() || _screenWindow.isNull()) {
+        return 1.0;
+    }
+    const auto it = _cyberBirths.constFind(cyberCellKey(_screenWindow->currentLine() + y, x));
+    if (it == _cyberBirths.constEnd()) {
+        return 1.0;
+    }
+    return qBound(0.0, (_cyberClock.elapsed() - it.value()) / (CYBER_REVEAL_MS * _cyberFactor), 1.0);
+}
+
+int TerminalDisplay::cyberDetectShift(const Character *newimg, int lines, int columns, int newColumns) const
+{
+    // Full-screen apps (Claude Code, less, vim) repaint instead of scrolling. Find how many rows the
+    // content moved up by sampling a few rows: a row that moved up by k matches old row y + k.
+    // Only rows not yet overwritten in _image are compared, so only upward moves are detected.
+    const auto sameText = [&](int newRow, int oldRow) {
+        const Character *moved = &newimg[newRow * newColumns];
+        const Character *previous = &_image[oldRow * _columns];
+        bool hasText = false;
+        for (int x = 0; x < columns; ++x) {
+            if (moved[x].character != previous[x].character) {
+                return false;
+            }
+            hasText |= !moved[x].isSpace();
+        }
+        return hasText;
+    };
+    const int samples[] = {lines / 4, lines / 2, (lines * 3) / 4};
+    for (int k = 1; k <= qMin(CYBER_MAX_SHIFT, lines / 2); ++k) {
+        int hits = 0;
+        for (const int row : samples) {
+            if (row + k < lines && sameText(row, row + k)) {
+                ++hits;
+            }
+        }
+        if (hits >= 2) {
+            return k;
+        }
+    }
+    return 0;
+}
+
+void TerminalDisplay::cyberNoteFreshCells(const QVector<quint64> &fresh, const QRegion &region, bool imageScrolled)
+{
+    if (_cyberFactor <= 0.0 || _screenWindow.isNull()) {
+        return;
+    }
+    const qint64 now = _cyberClock.elapsed();
+
+    // Big or continuous output (logs, full-screen redraws) is drawn at once, without animation.
+    if (now - _cyberBurstStart > CYBER_BURST_WINDOW_MS) {
+        _cyberBurstStart = now;
+        _cyberBurstCells = 0;
+    }
+    _cyberBurstCells += fresh.size();
+    // Scrolling a full-screen app (Claude Code, less) with the wheel repaints the screen with old
+    // text; while the wheel is in use (see wheelEvent) nothing is animated.
+    const bool calm = _cyberBurstCells <= CYBER_BURST_CELLS && now >= _cyberQuietUntil
+        && (_screenWindow->scrollCount() == 0 || imageScrolled);
+
+    if (calm && !fresh.isEmpty()) {
+        for (const quint64 key : fresh) {
+            _cyberBirths.insert(key, now);
+        }
+        _cyberRevealRegion |= region;
+        _cyberRevealUntil = now + qint64(CYBER_REVEAL_MS * _cyberFactor);
+        cyberFxActivity();
+    }
+
+    // Cursor trail: a translucent block that follows short cursor moves.
+    const QPoint cursor = cursorPosition();
+    if (cursor != _cyberCursorLast) {
+        const QRect oldRect = imageToWidget(highdpi_adjust_rect(QRect(_cyberCursorLast, QSize(1, 1))));
+        const QRect newRect = imageToWidget(highdpi_adjust_rect(QRect(cursor, QSize(1, 1))));
+        const QPoint delta = cursor - _cyberCursorLast;
+        if (calm && _cyberCursorLast.x() >= 0 && qAbs(delta.x()) + qAbs(delta.y()) <= CYBER_TRAIL_MAX_CELLS && hasFocus()) {
+            if (_cyberTrailStart != 0) {
+                // A trail still running is replaced: erase where it was, or it stays on screen.
+                update(_cyberTrailFrom.united(_cyberTrailTo).adjusted(-CYBER_HALO, -CYBER_HALO, CYBER_HALO, CYBER_HALO));
+            }
+            _cyberTrailFrom = oldRect;
+            _cyberTrailTo = newRect;
+            _cyberTrailStart = now;
+        }
+        // Sparks: only for the characters echoed by typing, not for output.
+        if (calm && delta.y() == 0 && delta.x() > 0 && delta.x() <= 4 && !fresh.isEmpty() && fresh.size() <= 8 && now - _cyberLastKey < 250
+            && _cyberCursorLast.x() >= 0 && hasFocus()) {
+            cyberSparksSpawn(newRect);
+        }
+        update(oldRect.adjusted(-CYBER_HALO, -CYBER_HALO, CYBER_HALO, CYBER_HALO));
+        update(newRect.adjusted(-CYBER_HALO, -CYBER_HALO, CYBER_HALO, CYBER_HALO));
+        _cyberCursorLast = cursor;
+    }
+
+    if ((!_cyberRevealRegion.isEmpty() || _cyberTrailStart != 0) && !_cyberTimer->isActive()) {
+        _cyberTimer->start();
+    }
+}
+
+void TerminalDisplay::cyberAnimationTick()
+{
+    const qint64 now = _cyberClock.elapsed();
+    bool running = false;
+
+    if (!_cyberRevealRegion.isEmpty()) {
+        update(_cyberRevealRegion);
+        if (now >= _cyberRevealUntil) {
+            // This last repaint already draws everything settled.
+            _cyberRevealRegion = QRegion();
+            _cyberBirths.clear();
+        } else {
+            running = true;
+        }
+    }
+
+    if (_cyberTrailStart != 0) {
+        update(_cyberTrailFrom.united(_cyberTrailTo).adjusted(-CYBER_HALO, -CYBER_HALO, CYBER_HALO, CYBER_HALO));
+        if (now - _cyberTrailStart >= CYBER_TRAIL_MS * _cyberFactor) {
+            _cyberTrailStart = 0;
+        } else {
+            running = true;
+        }
+    }
+
+    // Data cascade: move the grains and repaint its band only.
+    if (_cyberCascadeOn && (!_cyberGrains.isEmpty() || _cyberEnergy > 0.02f)) {
+        const float dt = qBound(0.001f, float(now - _cyberCascadeLast) / 1000.0f, 0.05f);
+        _cyberCascadeLast = now;
+        cyberCascadeStep(dt);
+        update(cyberCascadeRect());
+        running = true;
+    }
+
+    // Breathing halo: keep repainting the cursor surroundings while the terminal has focus.
+    if (hasFocus() && _cyberFactor > 0.0 && !_screenWindow.isNull() && isCursorOnDisplay()) {
+        const QRect cursorRect = imageToWidget(highdpi_adjust_rect(QRect(_visualCursorPosition, QSize(1, 1))));
+        update(cursorRect.adjusted(-CYBER_HALO - 1, -CYBER_HALO - 1, CYBER_HALO + 1, CYBER_HALO + 1));
+        running = true;
+    }
+
+    if (!running) {
+        _cyberTimer->stop();
+    }
+}
+
+void TerminalDisplay::cyberPaintCursorEffects(QPainter &paint)
+{
+    if (_cyberFactor <= 0.0 || !hasFocus() || _screenWindow.isNull() || !isCursorOnDisplay()) {
+        return;
+    }
+    QColor color = _terminalColor->cursorColor();
+    if (!color.isValid()) {
+        color = _terminalColor->foregroundColor();
+    }
+    const QRect cursorRect = imageToWidget(highdpi_adjust_rect(QRect(_visualCursorPosition, QSize(1, 1))));
+
+    paint.save();
+    paint.setRenderHint(QPainter::Antialiasing, false);
+    paint.setBrush(Qt::NoBrush);
+
+    // Localized glow around the active cursor, breathing slowly while the terminal has focus.
+    const qreal phase = qreal(_cyberClock.elapsed() % CYBER_PULSE_MS) / CYBER_PULSE_MS;
+    const qreal pulse = 0.65 + 0.35 * std::sin(6.283185307179586 * phase);
+    for (int i = 1; i <= CYBER_HALO; ++i) {
+        QColor glow = color;
+        glow.setAlphaF(0.38 * pulse / i);
+        paint.setPen(QPen(glow, 1));
+        paint.drawRect(cursorRect.adjusted(-i, -i, i - 1, i - 1));
+    }
+
+    if (_cyberTrailStart != 0) {
+        const qreal t = qBound(0.0, (_cyberClock.elapsed() - _cyberTrailStart) / (CYBER_TRAIL_MS * _cyberFactor), 1.0);
+        const qreal eased = 1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t);
+        const QRectF from(_cyberTrailFrom);
+        const QRectF to(_cyberTrailTo);
+        const QRectF tail(from.topLeft() + (to.topLeft() - from.topLeft()) * eased, from.size());
+        QColor head = color;
+        head.setAlphaF(0.6 * (1.0 - t));
+        QColor rear = _terminalColor->colorTable()[3]; // ANSI red (table: 0 fg, 1 bg, 2..9 colors 0-7)
+        rear.setAlphaF(0.45 * (1.0 - t));
+        // Same line: a red-to-cyan streak from the tail to the cursor; otherwise a ghost block sliding in.
+        const QRectF streak = qFuzzyCompare(from.top(), to.top()) ? tail.united(to) : tail;
+        QLinearGradient gradient(tail.center(), to.center());
+        gradient.setColorAt(0.0, rear);
+        gradient.setColorAt(1.0, head);
+        paint.fillRect(streak, gradient);
+    }
+
+    paint.restore();
+}
+
+QRect TerminalDisplay::cyberCascadeRect() const
+{
+    if (!_cyberCascadeOn) {
+        return {};
+    }
+    const int top = contentsRect().top() + (_headerBar->isVisible() ? _headerBar->height() : 0);
+    return QRect(QPoint(_contentRect.left() - _margin, top), QPoint(_contentRect.right() + _margin, _contentRect.top() - 1));
+}
+
+void TerminalDisplay::cyberCascadeReload()
+{
+    const CyberCascadeSettings &settings = cyberCascadeSettings();
+    if (settings.generation == _cyberCascadeGen) {
+        return;
+    }
+    _cyberCascadeGen = settings.generation;
+    _cyberAtlasKey.clear(); // the gradient may have changed
+    const bool on = settings.on && _cyberFactor > 0.0;
+    if (on != _cyberCascadeOn || settings.lines != _cyberCascadeLines) {
+        _cyberCascadeOn = on;
+        _cyberCascadeLines = settings.lines;
+        _cyberGrains.clear();
+        _cyberGrains.squeeze();
+        _cyberPool.clear();
+        _cyberEnergy = 0;
+        if (!on) {
+            _cyberAtlas = QPixmap();
+            _cyberLeaderAtlas = QPixmap();
+        }
+        // The text area shrinks or grows by the band; the program in the terminal gets the new size.
+        if (_image != nullptr) {
+            updateImageSize();
+        }
+        update();
+    }
+}
+
+void TerminalDisplay::cyberCascadeBuildAtlas()
+{
+    // Rebuilt only when the font, the terminal colors or the gradient change.
+    const QFont font = _terminalFont->getVTFont();
+    const QColor *table = _terminalColor->colorTable();
+    QList<QColor> leaderColors = {table[ColorFgIndex]};
+    for (int i = 0; i < 8; ++i) {
+        leaderColors << table[Color0Index + i] << table[Color0Index + BASE_COLORS + i];
+    }
+    QString key = font.key() + QString::number(_terminalFont->fontHeight()) + QString::number(_cyberCascadeGen);
+    for (const QColor &color : std::as_const(leaderColors)) {
+        key += color.name();
+    }
+    if (key == _cyberAtlasKey && !_cyberAtlas.isNull()) {
+        return;
+    }
+    _cyberAtlasKey = key;
+    _cyberLeaderColors = leaderColors;
+
+    const int glyphs = CYBER_CASCADE_GLYPHS.size();
+    const QList<QPair<qreal, QColor>> &stops = cyberCascadeSettings().stops;
+
+    // Tiny glyphs and fragments, one row per gradient step.
+    QFont small = font;
+    small.setPixelSize(qMax(6, qRound(_terminalFont->fontHeight() * 0.34)));
+    small.setWeight(QFont::DemiBold);
+    const QFontMetrics metrics(small);
+    // Each cell is a glyph with two fading copies above it: a streak along the flow (the fibres of the video).
+    const int glyphHeight = qMax(5, metrics.ascent() + 1);
+    _cyberCell = QSize(qMax(4, metrics.horizontalAdvance(QLatin1Char('M')) + 1), glyphHeight * 2);
+    QImage image((glyphs + CYBER_CASCADE_CHIPS) * _cyberCell.width(), CYBER_CASCADE_STEPS * _cyberCell.height(), QImage::Format_ARGB32_Premultiplied);
+    image.fill(Qt::transparent);
+    {
+        QPainter painter(&image);
+        painter.setFont(small);
+        painter.setRenderHint(QPainter::Antialiasing);
+        const qreal w = _cyberCell.width();
+        const qreal h = _cyberCell.height();
+        // Fragment shapes (in cell units): shards, a chip, a sliver, a diamond, a dot.
+        const QList<QPolygonF> chips = {QPolygonF({{0.2, 0.3}, {0.8, 0.2}, {0.5, 0.8}}),
+                                        QPolygonF({{0.15, 0.4}, {0.6, 0.15}, {0.85, 0.55}, {0.4, 0.85}}),
+                                        QPolygonF({{0.3, 0.2}, {0.75, 0.35}, {0.6, 0.8}, {0.25, 0.65}}),
+                                        QPolygonF({{0.1, 0.55}, {0.85, 0.35}, {0.9, 0.5}, {0.15, 0.7}}),
+                                        QPolygonF({{0.5, 0.15}, {0.8, 0.5}, {0.5, 0.85}, {0.2, 0.5}}),
+                                        QPolygonF({{0.35, 0.35}, {0.65, 0.35}, {0.65, 0.65}, {0.35, 0.65}})};
+        for (int row = 0; row < CYBER_CASCADE_STEPS; ++row) {
+            const QColor color = cyberGradient(stops, qreal(row) / (CYBER_CASCADE_STEPS - 1));
+            for (int i = 0; i < glyphs; ++i) {
+                const qreal gx = i * w + (w - metrics.horizontalAdvance(CYBER_CASCADE_GLYPHS[i])) / 2;
+                const qreal baseline = (row + 1) * h - 2;
+                const QString text(CYBER_CASCADE_GLYPHS[i]);
+                const QString other(CYBER_CASCADE_GLYPHS[(i * 7 + 3) % glyphs]);
+                painter.setOpacity(0.22);
+                painter.setPen(color.darker(130));
+                painter.drawText(QPointF(gx + 1, baseline - glyphHeight), other);
+                painter.setOpacity(0.5);
+                painter.drawText(QPointF(gx, baseline - glyphHeight * 0.5), text);
+                painter.setOpacity(1.0);
+                painter.setPen(color);
+                painter.drawText(QPointF(gx, baseline), text);
+            }
+            painter.setPen(Qt::NoPen);
+            painter.setBrush(color.lighter(115));
+            for (int c = 0; c < CYBER_CASCADE_CHIPS; ++c) {
+                QPolygonF shape;
+                for (const QPointF &point : chips[c]) {
+                    shape << QPointF((glyphs + c + point.x()) * w, (row + 0.5 + 0.5 * point.y()) * h);
+                }
+                painter.drawPolygon(shape);
+            }
+        }
+    }
+    _cyberAtlas = QPixmap::fromImage(image);
+
+    // Full size glyphs in the terminal colors, for the text that is just leaving.
+    _cyberLeaderCell = QSize(_terminalFont->fontWidth(), _terminalFont->fontHeight());
+    QImage leaders(glyphs * _cyberLeaderCell.width(), leaderColors.size() * _cyberLeaderCell.height(), QImage::Format_ARGB32_Premultiplied);
+    leaders.fill(Qt::transparent);
+    {
+        QPainter painter(&leaders);
+        painter.setFont(font);
+        const QFontMetrics fm(font);
+        for (int row = 0; row < leaderColors.size(); ++row) {
+            painter.setPen(leaderColors[row]);
+            for (int i = 0; i < glyphs; ++i) {
+                painter.drawText(QPointF(i * _cyberLeaderCell.width(), row * _cyberLeaderCell.height() + fm.ascent()), QString(CYBER_CASCADE_GLYPHS[i]));
+            }
+        }
+    }
+    _cyberLeaderAtlas = QPixmap::fromImage(leaders);
+}
+
+void TerminalDisplay::cyberCascadeSpawn(int glyph, float x, float delay, int leaderColor, float lane)
+{
+    if (_cyberGrains.size() >= CYBER_CASCADE_MAX) {
+        return;
+    }
+    const CyberPlume plume(cyberCascadeRect(), _contentRect.left(), _contentRect.right());
+    CyberGrain g{};
+    g.glyph = qint16(glyph);
+    g.leaderColor = qint8(leaderColor);
+    g.lane = lane;
+    g.seed = cyberRandom();
+    g.age = -delay;
+    g.speed = plume.height * (0.8f + 0.7f * cyberRandom());
+    g.bx = x;
+    g.by = plume.horizon + (leaderColor >= 0 ? _terminalFont->fontHeight() * 0.45f : 0.0f);
+    float h = plume.heightAt(x, lane);
+    if (leaderColor < 0) {
+        // Plain grain fills the plume where it shows (the bend and the wall), not the long tail.
+        const float r = cyberRandom();
+        h = plume.height * 0.4f * r * std::sqrt(r);
+    } else if (h < 0.0f) {
+        {
+            // The glyph itself rises from where it was and crumbles away.
+            g.broken = 0.0001f;
+            g.vx = 10.0f + 40.0f * cyberRandom();
+            g.vy = -(0.6f + 0.8f * cyberRandom()) * plume.height;
+            g.age = 0.0f;
+        }
+    }
+    g.h = qMax(0.0f, h);
+    g.x = g.bx;
+    g.y = g.by;
+    _cyberGrains.append(g);
+}
+
+void TerminalDisplay::cyberCascadeEmit(const Character *rows, int rowCount, int columns)
+{
+    const qint64 now = _cyberClock.elapsed();
+    // Never while the wheel is scrolling (same calm as the text reveal), nor in a hidden tab.
+    if (rowCount <= 0 || now < _cyberQuietUntil || !isVisible() || cyberCascadeRect().height() < 8) {
+        return;
+    }
+    cyberCascadeBuildAtlas();
+    const QColor *table = _terminalColor->colorTable();
+    const float fontWidth = _terminalFont->fontWidth();
+    if (_cyberPool.size() < 256) {
+        _cyberPool.reserve(256);
+    }
+    int cells = 0;
+    for (int y = 0; y < rowCount; ++y) {
+        const Character *row = &rows[y * columns];
+        for (int x = 0; x < columns; ++x) {
+            const Character &cell = row[x];
+            if (cell.isSpace() || cell.isRightHalfOfDoubleWide() || cell.character < 0x21) {
+                continue;
+            }
+            const int glyph = cyberGlyphIndex(cell.character);
+            const float px = _contentRect.left() + (x + 0.5f) * fontWidth;
+            // Nearest terminal color for the leaving glyph (true color text is approximated).
+            const QColor color = cell.foregroundColor.color(table);
+            int best = 0;
+            int bestDistance = INT_MAX;
+            for (int i = 0; i < _cyberLeaderColors.size(); ++i) {
+                const QColor &c = _cyberLeaderColors[i];
+                const int d = (c.red() - color.red()) * (c.red() - color.red()) + (c.green() - color.green()) * (c.green() - color.green())
+                    + (c.blue() - color.blue()) * (c.blue() - color.blue());
+                if (d < bestDistance) {
+                    bestDistance = d;
+                    best = i;
+                }
+            }
+            cyberCascadeSpawn(glyph, px, 0.0f, best, cyberRandom());
+            for (int k = 0; k < CYBER_CASCADE_GRAIN_PER_CELL; ++k) {
+                cyberCascadeSpawn(glyph, px + (cyberRandom() - 0.5f) * 4.0f * fontWidth, cyberRandom() * 0.9f, -1, cyberRandom());
+            }
+            const QPair<qint16, float> entry(qint16(glyph), px);
+            if (_cyberPool.size() < 256) {
+                _cyberPool.append(entry);
+            } else {
+                _cyberPool[_cyberPoolNext] = entry;
+                _cyberPoolNext = (_cyberPoolNext + 1) % 256;
+            }
+            ++cells;
+        }
+    }
+    if (cells == 0) {
+        return;
+    }
+    _cyberEnergy = qMin(_cyberEnergy + cells, 600.0f);
+    if (!_cyberTimer->isActive()) {
+        _cyberTimer->start();
+    }
+    if (_cyberGrains.size() <= cells * (CYBER_CASCADE_GRAIN_PER_CELL + 1)) {
+        _cyberCascadeLast = now; // first grains: no stale time step
+    }
+}
+
+void TerminalDisplay::cyberCascadeStep(float dt)
+{
+    if (!isVisible()) {
+        _cyberGrains.clear();
+        _cyberEnergy = 0;
+        return;
+    }
+    const QRect band = cyberCascadeRect();
+    const CyberPlume plume(band, _contentRect.left(), _contentRect.right());
+
+    // Continuous flow: recent glyphs keep feeding the plume while text is leaving, fading after it stops.
+    if (_cyberEnergy > 0.02f && !_cyberPool.isEmpty()) {
+        _cyberSpawnCarry += _cyberEnergy * dt * 3.0f;
+        const float fontWidth = _terminalFont->fontWidth();
+        while (_cyberSpawnCarry >= 1.0f) {
+            _cyberSpawnCarry -= 1.0f;
+            const auto &entry = _cyberPool[int(cyberRandom() * _cyberPool.size())];
+            cyberCascadeSpawn(entry.first, entry.second + (cyberRandom() - 0.5f) * 6.0f * fontWidth, 0.0f, -1, cyberRandom());
+        }
+        _cyberEnergy *= std::exp(-dt / 1.2f);
+    } else {
+        _cyberEnergy = 0;
+        _cyberSpawnCarry = 0;
+    }
+
+    for (int i = 0; i < _cyberGrains.size();) {
+        CyberGrain &g = _cyberGrains[i];
+        g.age += dt;
+        if (g.age < 0.0f) {
+            ++i;
+            continue;
+        }
+        bool dead;
+        if (g.broken > 0.0f) {
+            // Broken off: drifts outwards and up, fading (see cyberPaintCascade).
+            g.broken += dt;
+            g.vx += (40.0f + 60.0f * g.seed) * dt;
+            g.x += g.vx * dt;
+            g.y += g.vy * dt;
+            dead = g.broken > 0.55f + 0.7f * g.seed || g.y < plume.top - 12;
+        } else {
+            const float slope = plume.slope(g.h, g.lane);
+            // Fast along the horizon, slower as it rises.
+            const float speed = g.speed * (1.0f + 4.0f * qBound(0.0f, (plume.bend - g.x) / plume.width, 1.0f));
+            const float rise = speed * dt / std::sqrt(1.0f + slope * slope);
+            g.h += rise;
+            const float laneX = plume.x(g.h, g.lane);
+            const float laneY = plume.horizon - g.h;
+            if (g.leaderColor >= 0 && g.age < CYBER_CASCADE_BLEND) {
+                const float t = g.age / CYBER_CASCADE_BLEND;
+                const float eased = 1.0f - (1.0f - t) * (1.0f - t);
+                g.x = g.bx + (laneX - g.bx) * eased;
+                g.y = g.by + (laneY - g.by) * eased;
+            } else {
+                g.x = laneX;
+                g.y = laneY;
+            }
+            // The outer lanes disintegrate: grains break off into fragments that drift away.
+            if (g.lane > 0.55f && g.age > CYBER_CASCADE_BLEND && g.h > plume.height * (1.3f - g.lane) * (0.3f + g.seed)) {
+                const float norm = 1.0f / std::sqrt(1.0f + slope * slope);
+                g.broken = 0.0001f;
+                g.vx = speed * slope * norm * 0.5f + (20.0f + 90.0f * cyberRandom()) * g.lane;
+                g.vy = -speed * norm * 0.6f;
+            }
+            dead = g.y < plume.top - 12 || g.x > plume.right + 12;
+        }
+        if (dead) {
+            g = _cyberGrains.last();
+            _cyberGrains.removeLast();
+        } else {
+            ++i;
+        }
+    }
+}
+
+void TerminalDisplay::cyberPaintCascade(QPainter &paint, const QRegion &region)
+{
+    const QRect band = cyberCascadeRect();
+    if (band.height() < 8 || !region.intersects(band)) {
+        return;
+    }
+    const CyberPlume plume(band, _contentRect.left(), _contentRect.right());
+    const QList<QPair<qreal, QColor>> &stops = cyberCascadeSettings().stops;
+    paint.save();
+    paint.setClipRect(band);
+
+    // Horizon: a thin glowing line along the top of the text, brighter while the plume flows.
+    const qreal glow = 0.3 + 0.7 * qMin(1.0f, _cyberEnergy / 150.0f + (_cyberGrains.isEmpty() ? 0.0f : 0.3f));
+    QLinearGradient line(plume.left, 0, plume.right, 0);
+    const qreal bendAt = (plume.bend - plume.left) / plume.width;
+    QColor faint = cyberGradient(stops, 0.72);
+    faint.setAlphaF(0.0);
+    line.setColorAt(0.0, faint);
+    faint.setAlphaF(0.35 * glow);
+    line.setColorAt(bendAt * 0.4, faint);
+    QColor hot = cyberGradient(stops, 0.57);
+    hot.setAlphaF(0.95 * glow);
+    line.setColorAt(bendAt, hot);
+    QColor outer = cyberGradient(stops, 0.9);
+    outer.setAlphaF(0.0);
+    line.setColorAt(qMin(1.0, bendAt + 0.3), outer);
+    paint.fillRect(QRectF(plume.left, plume.horizon - 1, plume.width, 2), line);
+
+    if (_cyberGrains.isEmpty() || _cyberAtlas.isNull()) {
+        paint.restore();
+        return;
+    }
+
+    // Body: translucent strips along the inner lanes, the solid bands of the video under the grain.
+    // They brighten with the amount of grain in flight and vanish with it.
+    const qreal body = 0.3 * qMin(1.0, _cyberGrains.size() / 2500.0);
+    if (body > 0.01) {
+        constexpr int strips = 12;
+        constexpr int points = 24;
+        constexpr float solid = 0.62f; // lanes past this only crumble (fragments)
+        paint.setPen(Qt::NoPen);
+        paint.setCompositionMode(QPainter::CompositionMode_Plus);
+        for (int i = 0; i < strips; ++i) {
+            const float inner = solid * i / strips;
+            const float outer = solid * (i + 1) / strips;
+            QPolygonF strip;
+            for (int j = 0; j < points; ++j) {
+                const float h = 1.1f * plume.height * float(j * j) / float((points - 1) * (points - 1));
+                strip << QPointF(plume.x(h, inner), plume.horizon - h);
+            }
+            for (int j = points - 1; j >= 0; --j) {
+                const float h = 1.1f * plume.height * float(j * j) / float((points - 1) * (points - 1));
+                strip << QPointF(plume.x(h, outer), plume.horizon - h);
+            }
+            QColor color = cyberGradient(stops, (inner + outer) / 2);
+            // The innermost strip is the faint fibre edge; the last ones thin out into the fragments.
+            color.setAlphaF(body * (i == 0 ? 0.5 : i >= strips - 2 ? 0.6 : 1.0));
+            paint.setBrush(color);
+            paint.drawPolygon(strip);
+        }
+        paint.setCompositionMode(QPainter::CompositionMode_SourceOver);
+    }
+
+    QVarLengthArray<QPainter::PixmapFragment, 1024> grains;
+    QVarLengthArray<QPainter::PixmapFragment, 512> chips;
+    QVarLengthArray<QPainter::PixmapFragment, 256> leaders;
+    const qreal cw = _cyberCell.width();
+    const qreal ch = _cyberCell.height();
+    const int glyphs = CYBER_CASCADE_GLYPHS.size();
+    const quint32 frame = quint32(_cyberClock.elapsed() / 70); // flicker changes ~14 times a second
+    for (const CyberGrain &g : std::as_const(_cyberGrains)) {
+        if (g.age < 0.0f) {
+            continue;
+        }
+        const quint32 hash = (quint32(g.seed * 16777216.0f) ^ (frame * 2654435761u)) * 2246822519u;
+        const float noise = float(hash >> 8) / 16777216.0f; // 0..1, per grain and frame
+        const float flicker = 0.72f + 0.28f * noise;
+        int step = qBound(0, int(g.lane * (CYBER_CASCADE_STEPS - 1) + (g.seed - 0.5f) * 3.0f), CYBER_CASCADE_STEPS - 1);
+        if (g.broken > 0.0f) {
+            const float life = 0.55f + 0.7f * g.seed;
+            const float left = 1.0f - g.broken / life;
+            // Fragments are white-lavender to violet, the farther the darker.
+            step = qBound(CYBER_CASCADE_STEPS / 2, int((0.55f + 0.45f * (1.0f - left) + 0.1f * g.seed) * (CYBER_CASCADE_STEPS - 1)), CYBER_CASCADE_STEPS - 1);
+            const int shape = g.seed < 0.7f ? int(g.glyph) % CYBER_CASCADE_CHIPS : -1; // some stay glyphs while crumbling
+            const qreal scale = shape >= 0 ? 0.9 + 2.4 * g.seed * left : 1.0;
+            const QPainter::PixmapFragment f = QPainter::PixmapFragment::create(QPointF(g.x, g.y),
+                                                                                QRectF((shape >= 0 ? glyphs + shape : g.glyph) * cw, step * ch, cw, ch),
+                                                                                scale,
+                                                                                scale,
+                                                                                0,
+                                                                                qBound(0.0f, left * flicker, 1.0f));
+            if (shape >= 0) {
+                chips.append(f);
+            } else {
+                grains.append(f);
+            }
+            continue;
+        }
+        const float fadeIn = qMin(1.0f, g.age / 0.15f);
+        float opacity = fadeIn * flicker;
+        if (g.leaderColor >= 0 && g.age < CYBER_CASCADE_BLEND) {
+            const float t = g.age / CYBER_CASCADE_BLEND;
+            const qreal scale = 1.0 - 0.55 * t;
+            leaders.append(QPainter::PixmapFragment::create(QPointF(g.x, g.y),
+                                                            QRectF(g.glyph * _cyberLeaderCell.width(),
+                                                                   g.leaderColor * _cyberLeaderCell.height(),
+                                                                   _cyberLeaderCell.width(),
+                                                                   _cyberLeaderCell.height()),
+                                                            scale,
+                                                            scale,
+                                                            0,
+                                                            1.0 - t));
+            opacity = t * flicker;
+        }
+        grains.append(QPainter::PixmapFragment::create(QPointF(g.x, g.y), QRectF(g.glyph * cw, step * ch, cw, ch), 1, 1, 0, opacity));
+    }
+    paint.setRenderHint(QPainter::SmoothPixmapTransform, false);
+    paint.setCompositionMode(QPainter::CompositionMode_Plus); // dense grain glows, like the video
+    paint.drawPixmapFragments(grains.constData(), grains.size(), _cyberAtlas);
+    paint.setCompositionMode(QPainter::CompositionMode_SourceOver);
+    paint.setRenderHint(QPainter::SmoothPixmapTransform, true);
+    paint.drawPixmapFragments(chips.constData(), chips.size(), _cyberAtlas);
+    paint.drawPixmapFragments(leaders.constData(), leaders.size(), _cyberLeaderAtlas);
+    paint.restore();
+}
+
+/* CyberKDE alternative effects ------------------------------------------------------------------ */
+
+void TerminalDisplay::cyberCommandFailed()
+{
+    if (!cyberFxSettings().fail || _cyberFactor <= 0.0 || _screenWindow.isNull() || !isVisible()) {
+        return;
+    }
+    // The shell reports the exit code right before its next prompt: the prompt goes on the cursor line.
+    const Screen *screen = _screenWindow->screen();
+    _cyberFailLine = screen->getHistLines() + screen->getCursorY();
+    _cyberFailStart = _cyberClock.elapsed();
+    cyberFxWake();
+}
+
+void TerminalDisplay::cyberFxWake()
+{
+    if (!_cyberFxTimer->isActive()) {
+        _cyberFxLast = _cyberClock.elapsed();
+        _cyberFxTimer->start();
+    }
+}
+
+void TerminalDisplay::cyberFxActivity()
+{
+    // Output and typing keep new drops coming for a while; an idle terminal lets the rain run out and stop.
+    if (cyberFxSettings().rain && _cyberFactor > 0.0) {
+        _cyberRainUntil = _cyberClock.elapsed() + CYBER_RAIN_LINGER_MS;
+        cyberFxWake();
+    }
+}
+
+void TerminalDisplay::cyberFxReload()
+{
+    const CyberFxSettings &fx = cyberFxSettings();
+    if (fx.generation == _cyberFxGen) {
+        return;
+    }
+    _cyberFxGen = fx.generation;
+    const bool animate = _cyberFactor > 0.0;
+    _cyberStaticKey.clear();
+    _cyberScanTile = QPixmap();
+    _cyberRainKey.clear();
+    if (fx.rain && animate) {
+        cyberFxActivity(); // shows at once when switched on
+    } else {
+        _cyberDrops.clear();
+        _cyberRainUntil = 0;
+        _cyberRainAtlas = QPixmap();
+    }
+    if (!fx.sparks) {
+        _cyberSparks.clear();
+    }
+    if (!fx.fail) {
+        _cyberFailStart = 0;
+    }
+    if (!fx.bell) {
+        _cyberBellStart = 0;
+    }
+    if (fx.sweep && animate) {
+        if (!_cyberSweepTimer->isActive() && _cyberSweepStart == 0) {
+            _cyberSweepTimer->start(qMin(fx.sweepInterval, 2) * 1000); // the first pass soon after switching on
+        }
+    } else {
+        _cyberSweepTimer->stop();
+        _cyberSweepStart = 0;
+    }
+    if (fx.hud && fx.hudData) {
+        if (!_cyberHudClock->isActive()) {
+            _cyberHudClock->start(60000 - int(QTime::currentTime().msecsSinceStartOfDay() % 60000));
+        }
+    } else {
+        _cyberHudClock->stop();
+    }
+    update();
+}
+
+bool TerminalDisplay::cyberFxFixedBackdrop() const
+{
+    // Layers fixed to the window, and short accents over the text: the scroll shortcut (moving the
+    // pixels with the text) would drag them along and leave copies behind.
+    const CyberFxSettings &fx = cyberFxSettings();
+    return fx.grid || fx.crt || !_cyberDrops.isEmpty() || _cyberSweepStart != 0 || !_cyberSparks.isEmpty() || _cyberFailStart != 0;
+}
+
+QRect TerminalDisplay::cyberFxArea(bool belowCascade) const
+{
+    // The terminal surface: inside the frame, below the header bar, beside the scroll bar.
+    QRect area = contentsRect();
+    area.setTop(area.top() + (_headerBar->isVisible() ? _headerBar->height() : 0));
+    if (!_scrollBar->isHidden()) {
+        if (_scrollBar->scrollBarPosition() == Enum::ScrollBarLeft) {
+            area.setLeft(area.left() + _scrollBar->width());
+        } else if (_scrollBar->scrollBarPosition() == Enum::ScrollBarRight) {
+            area.setRight(area.right() - _scrollBar->width());
+        }
+    }
+    if (belowCascade && _cyberCascadeOn) {
+        area.setTop(_contentRect.top()); // the band above belongs to the data cascade
+    }
+    return area;
+}
+
+QRect TerminalDisplay::cyberSweepRect(qint64 now) const
+{
+    const QRect area = cyberFxArea(true);
+    const int band = 3 * _terminalFont->fontHeight();
+    const qreal t = qBound(0.0, (now - _cyberSweepStart) / (CYBER_SWEEP_MS * _cyberFactor), 1.0);
+    return QRect(area.left(), area.top() - band + qRound(t * (area.height() + band)), area.width(), band);
+}
+
+void TerminalDisplay::cyberSweepBegin()
+{
+    const CyberFxSettings &fx = cyberFxSettings();
+    if (!fx.sweep || _cyberFactor <= 0.0) {
+        return;
+    }
+    // Only in the window in use: a hidden tab, a window in the background or the wheel scrolling skip this pass.
+    if (isVisible() && (hasFocus() || window()->isActiveWindow()) && _cyberClock.elapsed() >= _cyberQuietUntil) {
+        _cyberSweepStart = _cyberClock.elapsed();
+        _cyberSweepLast = QRect();
+        cyberFxWake();
+    } else {
+        _cyberSweepTimer->start(fx.sweepInterval * 1000);
+    }
+}
+
+void TerminalDisplay::cyberBellPulse()
+{
+    // One pulse at a time, and a pause after it: a burst of bells never turns into flashing.
+    if (!cyberFxSettings().bell || _cyberFactor <= 0.0 || !isVisible() || _cyberBellStart != 0) {
+        return;
+    }
+    _cyberBellStart = _cyberClock.elapsed();
+    cyberFxWake();
+}
+
+void TerminalDisplay::cyberSparksSpawn(const QRect &cursorRect)
+{
+    const CyberFxSettings &fx = cyberFxSettings();
+    if (!fx.sparks || _cyberFactor <= 0.0) {
+        return;
+    }
+    // A few sparks from the foot of the character just typed (left of the cursor), fanning upwards.
+    const int count = 3 + qRound(6 * fx.sparksLevel);
+    const float x = cursorRect.left();
+    const float y = cursorRect.bottom() - cursorRect.height() * 0.2f;
+    for (int i = 0; i < count && _cyberSparks.size() < CYBER_SPARKS_MAX; ++i) {
+        const float angle = 3.14159265f * (1.12f + 0.76f * cyberRandom());
+        const float speed = 70.0f + 110.0f * cyberRandom();
+        CyberSpark spark;
+        spark.x = x + (cyberRandom() - 0.7f) * cursorRect.width();
+        spark.y = y;
+        spark.vx = std::cos(angle) * speed;
+        spark.vy = std::sin(angle) * speed;
+        spark.age = 0.0f;
+        spark.life = float((0.28 + 0.26 * cyberRandom()) * _cyberFactor);
+        _cyberSparks.append(spark);
+    }
+    cyberFxWake();
+}
+
+void TerminalDisplay::cyberRainStep(float dt)
+{
+    const CyberFxSettings &fx = cyberFxSettings();
+    const qint64 now = _cyberClock.elapsed();
+    const int fw = _terminalFont->fontWidth();
+    const int fh = _terminalFont->fontHeight();
+    const QRect area = cyberFxArea(true);
+
+    // New drops only while the terminal is in use (focus and recent activity).
+    if (fx.rain && now < _cyberRainUntil && hasFocus() && _columns > 0) {
+        const float target = qMax(1.0f, _columns * fx.rainDensity / 100.0f * 0.5f);
+        if (_cyberDrops.size() < target && cyberRandom() < dt * target * 1.5f) {
+            CyberDrop drop;
+            drop.column = int(cyberRandom() * _columns);
+            drop.length = 5.0f + 12.0f * cyberRandom();
+            drop.speed = 3.0f + 6.0f * cyberRandom(); // slow: an ambient flow, not a downpour
+            drop.seed = cyberHash(quint32(now) * 7919u + quint32(drop.column));
+            drop.head = fx.rainUp ? _lines + 2.0f * cyberRandom() : -2.0f * cyberRandom();
+            _cyberDrops.append(drop);
+        }
+    }
+
+    for (int i = 0; i < _cyberDrops.size();) {
+        CyberDrop &drop = _cyberDrops[i];
+        const int before = int(std::floor(drop.head));
+        drop.head += (fx.rainUp ? -drop.speed : drop.speed) * dt;
+        const int after = int(std::floor(drop.head));
+        const int length = int(std::ceil(drop.length));
+        if (before != after) {
+            // The whole trail changes when the head steps: repaint the column from the tail to the head.
+            const int first = fx.rainUp ? after : after - length - 1;
+            const int last = fx.rainUp ? after + length + 1 : after;
+            update(QRect(_contentRect.left() + int(drop.column) * fw, _contentRect.top() + first * fh, fw, (last - first + 1) * fh) & area);
+        }
+        const bool gone = fx.rainUp ? drop.head + drop.length < -1.0f : drop.head - drop.length > _lines + 1.0f;
+        if (gone) {
+            drop = _cyberDrops.last();
+            _cyberDrops.removeLast();
+        } else {
+            ++i;
+        }
+    }
+}
+
+void TerminalDisplay::cyberRainBuildAtlas()
+{
+    const QFont font = _terminalFont->getVTFont();
+    const int fw = _terminalFont->fontWidth();
+    const int fh = _terminalFont->fontHeight();
+    const QString key = font.key() + QString::number(fw) + QLatin1Char('x') + QString::number(fh) + QLatin1Char('/') + QString::number(_cyberFxGen);
+    if (key == _cyberRainKey && !_cyberRainAtlas.isNull()) {
+        return;
+    }
+    _cyberRainKey = key;
+    const CyberFxPalette &colors = cyberFxSettings().rainColors;
+    const int glyphs = CYBER_RAIN_GLYPHS.size();
+    QImage image(glyphs * fw, CYBER_RAIN_STEPS * fh, QImage::Format_ARGB32_Premultiplied);
+    image.fill(Qt::transparent);
+    {
+        QPainter painter(&image);
+        painter.setFont(font);
+        for (int row = 0; row < CYBER_RAIN_STEPS; ++row) {
+            // Bright tip, then the middle color, ending in the tail color.
+            const qreal t = qreal(row) / (CYBER_RAIN_STEPS - 1);
+            painter.setPen(t < 0.2 ? cyberMix(colors.head, colors.mid, t / 0.2) : cyberMix(colors.mid, colors.tail, (t - 0.2) / 0.8));
+            for (int i = 0; i < glyphs; ++i) {
+                const QRect cell(i * fw, row * fh, fw, fh);
+                painter.setClipRect(cell); // fallback fonts may draw wider than a cell
+                painter.drawText(cell, Qt::AlignCenter, QString(CYBER_RAIN_GLYPHS[i]));
+            }
+        }
+    }
+    _cyberRainAtlas = QPixmap::fromImage(image);
+}
+
+void TerminalDisplay::cyberFxTick()
+{
+    const CyberFxSettings &fx = cyberFxSettings();
+    const qint64 now = _cyberClock.elapsed();
+    const float dt = qBound(0.001f, float(now - _cyberFxLast) / 1000.0f, 0.1f);
+    _cyberFxLast = now;
+    const bool frozen = now < _cyberQuietUntil || !isVisible(); // the wheel is scrolling, or a hidden tab
+    const QRect area = cyberFxArea();
+    bool running = false;
+
+    if (!_cyberDrops.isEmpty() || (fx.rain && now < _cyberRainUntil && hasFocus())) {
+        if (!frozen) {
+            cyberRainStep(dt);
+        }
+        running = true;
+    }
+
+    if (_cyberSweepStart != 0) {
+        const QRect band = cyberSweepRect(now).adjusted(0, -1, 0, 1);
+        update(band.united(_cyberSweepLast));
+        _cyberSweepLast = band;
+        if (now - _cyberSweepStart >= CYBER_SWEEP_MS * _cyberFactor) {
+            _cyberSweepStart = 0;
+            _cyberSweepTimer->start(fx.sweepInterval * 1000);
+        } else {
+            running = true;
+        }
+    }
+
+    if (!_cyberSparks.isEmpty()) {
+        QRectF bounds;
+        for (int i = 0; i < _cyberSparks.size();) {
+            CyberSpark &spark = _cyberSparks[i];
+            spark.age += dt;
+            if (spark.age >= spark.life) {
+                spark = _cyberSparks.last();
+                _cyberSparks.removeLast();
+                continue;
+            }
+            spark.vy += 420.0f * dt; // gravity
+            spark.vx *= 1.0f - 2.0f * dt;
+            spark.x += spark.vx * dt;
+            spark.y += spark.vy * dt;
+            bounds |= QRectF(spark.x - 1, spark.y - 1, 2, 2);
+            ++i;
+        }
+        const QRect now = bounds.toAlignedRect().adjusted(-8, -8, 8, 8);
+        update(now.united(_cyberSparksLast));
+        _cyberSparksLast = _cyberSparks.isEmpty() ? QRect() : now;
+        running |= !_cyberSparks.isEmpty();
+    } else if (!_cyberSparksLast.isNull()) {
+        update(_cyberSparksLast);
+        _cyberSparksLast = QRect();
+    }
+
+    if (_cyberFailStart != 0 && !_screenWindow.isNull()) {
+        const int row = _cyberFailLine - _screenWindow->currentLine();
+        const int fh = _terminalFont->fontHeight();
+        update(QRect(area.left(), _contentRect.top() + row * fh - 1, area.width(), fh + 2));
+        if (now - _cyberFailStart >= CYBER_FAIL_MS * _cyberFactor) {
+            _cyberFailStart = 0;
+        } else {
+            running = true;
+        }
+    }
+
+    if (_cyberBellStart != 0) {
+        const qint64 elapsed = now - _cyberBellStart;
+        if (elapsed <= CYBER_BELL_MS * _cyberFactor + CYBER_FX_FRAME_MS) {
+            const int w = CYBER_BELL_WIDTH;
+            update(QRect(area.left(), area.top(), area.width(), w));
+            update(QRect(area.left(), area.bottom() - w + 1, area.width(), w));
+            update(QRect(area.left(), area.top(), w, area.height()));
+            update(QRect(area.right() - w + 1, area.top(), w, area.height()));
+        }
+        if (elapsed >= CYBER_BELL_MS * _cyberFactor + 700) {
+            _cyberBellStart = 0; // pause over: the next bell may pulse again
+        } else {
+            running = true;
+        }
+    }
+
+    if (!running) {
+        _cyberFxTimer->stop();
+    }
+}
+
+void TerminalDisplay::cyberPaintBackdrop(QPainter &paint, const QRegion &region)
+{
+    const CyberFxSettings &fx = cyberFxSettings();
+    if (!fx.grid && !fx.crt && _cyberDrops.isEmpty() && _cyberSweepStart == 0) {
+        return;
+    }
+    const QRect full = cyberFxArea();
+    const QRect area = cyberFxArea(true);
+    const int fw = _terminalFont->fontWidth();
+    const int fh = _terminalFont->fontHeight();
+
+    // Static layers (grid, CRT) are drawn once per size, font and settings.
+    const QString key = QStringLiteral("%1x%2+%3+%4 %5x%6 %7 %8")
+                            .arg(full.width())
+                            .arg(full.height())
+                            .arg(_contentRect.left())
+                            .arg(_contentRect.top())
+                            .arg(fw)
+                            .arg(fh)
+                            .arg(_cyberFxGen)
+                            .arg(_cyberCascadeOn);
+    if (key != _cyberStaticKey) {
+        _cyberStaticKey = key;
+        _cyberGridPixmap = QPixmap();
+        _cyberCrtPixmap = QPixmap();
+    }
+
+    const QRegion clip = region & area;
+    if (clip.isEmpty()) {
+        return;
+    }
+    paint.save();
+    paint.setClipRegion(clip);
+
+    if (fx.grid) {
+        if (_cyberGridPixmap.isNull() && !area.isEmpty()) {
+            QImage image(area.size(), QImage::Format_ARGB32_Premultiplied);
+            image.fill(Qt::transparent);
+            QPainter painter(&image);
+            // Squares on the text cells, brighter towards the bottom like a holographic floor.
+            const int stepY = qMax(8, fx.gridSize * fh);
+            const int stepX = qMax(8, qRound(qreal(stepY) / fw) * fw);
+            const int x0 = ((_contentRect.left() - area.left()) % stepX + stepX) % stepX;
+            const int y0 = ((_contentRect.top() - area.top()) % stepY + stepY) % stepY;
+            const qreal alpha = 0.22 * fx.gridLevel;
+            QColor near = fx.gridColors.line;
+            QColor far = near;
+            near.setAlphaF(alpha);
+            far.setAlphaF(alpha * 0.4);
+            QLinearGradient fade(0, 0, 0, area.height());
+            fade.setColorAt(0, far);
+            fade.setColorAt(1, near);
+            painter.setPen(QPen(QBrush(fade), 1));
+            for (int x = x0; x < area.width(); x += stepX) {
+                painter.drawLine(x, 0, x, area.height());
+            }
+            for (int y = y0; y < area.height(); y += stepY) {
+                painter.drawLine(0, y, area.width(), y);
+            }
+            // Brighter nodes on the crossings.
+            near.setAlphaF(qMin(1.0, alpha * 2.4));
+            far.setAlphaF(qMin(1.0, alpha * 0.9));
+            fade.setColorAt(0, far);
+            fade.setColorAt(1, near);
+            painter.setPen(QPen(QBrush(fade), 1));
+            for (int y = y0; y < area.height(); y += stepY) {
+                for (int x = x0; x < area.width(); x += stepX) {
+                    painter.drawLine(x - 2, y, x + 2, y);
+                    painter.drawLine(x, y - 2, x, y + 2);
+                }
+            }
+            painter.end();
+            _cyberGridPixmap = QPixmap::fromImage(image);
+        }
+        for (const QRect &rect : clip) {
+            paint.drawPixmap(rect, _cyberGridPixmap, rect.translated(-area.topLeft()));
+        }
+    }
+
+    if (!_cyberDrops.isEmpty()) {
+        cyberRainBuildAtlas();
+        QVarLengthArray<QPainter::PixmapFragment, 512> glyphs;
+        const int glyphCount = CYBER_RAIN_GLYPHS.size();
+        const quint32 tick = quint32(_cyberClock.elapsed() / 150);
+        const qreal base = 0.7 * fx.rainLevel;
+        for (const CyberDrop &drop : std::as_const(_cyberDrops)) {
+            const int head = int(std::floor(drop.head));
+            const int length = int(std::ceil(drop.length));
+            const int left = _contentRect.left() + int(drop.column) * fw;
+            const int first = fx.rainUp ? head : head - length;
+            if (!clip.intersects(QRect(left, _contentRect.top() + first * fh, fw, (length + 1) * fh))) {
+                continue;
+            }
+            for (int k = 0; k <= length; ++k) {
+                const int row = fx.rainUp ? head + k : head - k;
+                if (row < 0 || row >= _lines) {
+                    continue;
+                }
+                const qreal t = qreal(k) / (length + 1);
+                const qreal alpha = base * (k == 0 ? 1.0 : 0.8 * std::pow(1.0 - t, 1.2));
+                const int step = qMin(CYBER_RAIN_STEPS - 1, int(t * CYBER_RAIN_STEPS));
+                // Each cell keeps its glyph for a while; the tip changes faster.
+                const quint32 change = k == 0 ? tick : (tick + (drop.seed >> (k % 8))) / 6;
+                const int glyph = int(cyberHash(drop.seed ^ (quint32(row) * 2654435761u) ^ (change * 40503u)) % quint32(glyphCount));
+                glyphs.append(QPainter::PixmapFragment::create(QPointF(left + fw / 2.0, _contentRect.top() + (row + 0.5) * fh),
+                                                               QRectF(glyph * fw, step * fh, fw, fh),
+                                                               1,
+                                                               1,
+                                                               0,
+                                                               alpha));
+            }
+        }
+        paint.drawPixmapFragments(glyphs.constData(), glyphs.size(), _cyberRainAtlas);
+    }
+
+    if (_cyberSweepStart != 0) {
+        // A soft band with a brighter leading edge, lighting the background only (the text is drawn after).
+        const QRect band = cyberSweepRect(_cyberClock.elapsed());
+        const qreal alpha = 0.5 * fx.sweepLevel;
+        QColor color = fx.sweepColors.line;
+        QLinearGradient glow(0, band.top(), 0, band.bottom());
+        color.setAlphaF(0.0);
+        glow.setColorAt(0.0, color);
+        color.setAlphaF(alpha * 0.35);
+        glow.setColorAt(0.8, color);
+        color.setAlphaF(alpha);
+        glow.setColorAt(1.0, color);
+        paint.setCompositionMode(QPainter::CompositionMode_Plus);
+        paint.fillRect(band, glow);
+        color.setAlphaF(qMin(1.0, alpha * 1.8));
+        paint.fillRect(QRect(band.left(), band.bottom(), band.width(), 1), color);
+    }
+
+    paint.restore();
+}
+
+void TerminalDisplay::cyberPaintOverlay(QPainter &paint, const QRegion &region)
+{
+    const CyberFxSettings &fx = cyberFxSettings();
+    if (!fx.crt && !fx.hud && _cyberSparks.isEmpty() && _cyberFailStart == 0 && _cyberBellStart == 0) {
+        return;
+    }
+    const QRect area = cyberFxArea();
+    const QRegion clip = region & area;
+    if (clip.isEmpty()) {
+        return;
+    }
+    const qint64 now = _cyberClock.elapsed();
+    const int fw = _terminalFont->fontWidth();
+    const int fh = _terminalFont->fontHeight();
+    paint.save();
+    paint.setClipRegion(clip);
+
+    // Sparks: short glowing streaks, from the bright tip color to the tail color as they die.
+    if (!_cyberSparks.isEmpty()) {
+        paint.setRenderHint(QPainter::Antialiasing, true);
+        paint.setCompositionMode(QPainter::CompositionMode_Plus);
+        for (const CyberSpark &spark : std::as_const(_cyberSparks)) {
+            const qreal t = spark.age / spark.life;
+            QColor color = t < 0.3 ? fx.sparksColors.head : t < 0.65 ? fx.sparksColors.mid : fx.sparksColors.tail;
+            color.setAlphaF(qBound(0.0, fx.sparksLevel * (1.0 - t * t), 1.0));
+            paint.setPen(QPen(color, 1.8, Qt::SolidLine, Qt::RoundCap));
+            paint.drawLine(QPointF(spark.x, spark.y), QPointF(spark.x - spark.vx * 0.045, spark.y - spark.vy * 0.045));
+        }
+        paint.setCompositionMode(QPainter::CompositionMode_SourceOver);
+        paint.setRenderHint(QPainter::Antialiasing, false);
+    }
+
+    // Error glitch: the prompt after a failed command is torn for a moment, then keeps a fading red mark.
+    if (_cyberFailStart != 0 && !_screenWindow.isNull()) {
+        const int row = _cyberFailLine - _screenWindow->currentLine();
+        if (row >= 0 && row < _lines) {
+            const QRect line(_contentRect.left(), _contentRect.top() + row * fh, _columns * fw, fh);
+            const qreal elapsed = now - _cyberFailStart;
+            const qreal t = qBound(0.0, elapsed / (CYBER_FAIL_MS * _cyberFactor), 1.0);
+            const QColor red = _terminalColor->colorTable()[3]; // ANSI red (table: 0 fg, 1 bg, 2..9 colors 0-7)
+            QColor cyan = _terminalColor->cursorColor();
+            if (!cyan.isValid()) {
+                cyan = fx.sparksColors.mid;
+            }
+            if (elapsed < CYBER_FAIL_TEAR_MS * _cyberFactor) {
+                // Two quick states of translucent red and cyan slices; the text underneath never moves.
+                const quint32 phase = elapsed < CYBER_FAIL_TEAR_MS * _cyberFactor / 2 ? 1 : 2;
+                paint.setCompositionMode(QPainter::CompositionMode_Plus);
+                for (quint32 i = 0; i < 7; ++i) {
+                    const quint32 h = cyberHash(quint32(_cyberFailStart) * 31u + phase * 977u + i * 7u);
+                    const int cells = 2 + int(h % 16);
+                    const int x = line.left() + int((h >> 8) % quint32(qMax(1, _columns))) * fw - fw;
+                    const int y = line.top() + int((h >> 16) % quint32(qMax(1, fh - 3)));
+                    QColor color = i % 3 == 2 ? cyan : red;
+                    color.setAlphaF(0.45 * fx.failLevel);
+                    paint.fillRect(QRect(x, y, cells * fw, 2 + int(h >> 28) % 4), color);
+                }
+                paint.setCompositionMode(QPainter::CompositionMode_SourceOver);
+            }
+            const qreal fade = (1.0 - t) * (1.0 - t);
+            QColor mark = red;
+            mark.setAlphaF(qMin(1.0, 0.95 * fx.failLevel * fade));
+            paint.fillRect(QRect(qMax(area.left() + 1, line.left() - qMin(_margin, 7)), line.top() + 1, 3, fh - 2), mark);
+            const qreal reach = 1.0 - std::pow(1.0 - qMin(1.0, t * 2.5), 3.0);
+            mark.setAlphaF(0.75 * fx.failLevel * fade);
+            paint.fillRect(QRectF(line.left(), line.bottom(), line.width() * reach, 1), mark);
+        }
+    }
+
+    // CRT: fine scanlines over everything, a vignette and curved dark corners.
+    if (fx.crt) {
+        if (_cyberScanTile.isNull()) {
+            QImage tile(64, 48, QImage::Format_ARGB32_Premultiplied);
+            tile.fill(Qt::transparent);
+            QPainter painter(&tile);
+            for (int y = 2; y < tile.height(); y += 3) {
+                painter.fillRect(0, y, tile.width(), 1, QColor(0, 0, 0, qRound(255 * qMin(1.0, 0.5 * fx.crtLevel))));
+            }
+            painter.end();
+            _cyberScanTile = QPixmap::fromImage(tile);
+        }
+        for (const QRect &rect : clip) {
+            paint.drawTiledPixmap(rect, _cyberScanTile, QPoint((rect.x() - area.x()) % 64, (rect.y() - area.y()) % 48));
+        }
+        if ((fx.crtVignette || fx.crtCurve) && _cyberCrtPixmap.isNull() && !area.isEmpty()) {
+            QImage image(area.size(), QImage::Format_ARGB32_Premultiplied);
+            image.fill(Qt::transparent);
+            QPainter painter(&image);
+            painter.setRenderHint(QPainter::Antialiasing);
+            const QRectF local(0, 0, area.width(), area.height());
+            if (fx.crtVignette) {
+                // Elliptic: untouched in the middle, darker towards the corners.
+                QRadialGradient vignette(QPointF(0, 0), 1.0);
+                vignette.setColorAt(0.0, Qt::transparent);
+                vignette.setColorAt(0.62, Qt::transparent);
+                vignette.setColorAt(1.0, QColor(0, 0, 0, qRound(255 * qMin(1.0, 0.85 * fx.crtLevel))));
+                QBrush brush(vignette);
+                brush.setTransform(QTransform::fromScale(local.width() / 2 * 1.4142, local.height() / 2 * 1.4142)
+                                   * QTransform::fromTranslate(local.width() / 2, local.height() / 2));
+                painter.fillRect(local, brush);
+            }
+            if (fx.crtCurve) {
+                // Rounded glass: dark corners and a faint highlight along the edge of the tube.
+                const qreal radius = qBound(10.0, qMin(local.width(), local.height()) / 22.0, 28.0);
+                QPainterPath outside;
+                outside.addRect(local);
+                QPainterPath glass;
+                glass.addRoundedRect(local.adjusted(1, 1, -1, -1), radius, radius);
+                painter.fillPath(outside.subtracted(glass), QColor(0, 0, 0, 235));
+                painter.setPen(QPen(QColor(255, 255, 255, qRound(40 * fx.crtLevel)), 1));
+                painter.setBrush(Qt::NoBrush);
+                painter.drawRoundedRect(local.adjusted(1.5, 1.5, -1.5, -1.5), radius, radius);
+            }
+            painter.end();
+            _cyberCrtPixmap = QPixmap::fromImage(image);
+        }
+        if (!_cyberCrtPixmap.isNull()) {
+            for (const QRect &rect : clip) {
+                paint.drawPixmap(rect, _cyberCrtPixmap, rect.translated(-area.topLeft()));
+            }
+        }
+    }
+
+    if (fx.hud && !area.isEmpty()) {
+        const QString key = QStringLiteral("%1x%2+%3+%4 %5x%6 %7 %8x%9 ")
+                                .arg(area.width())
+                                .arg(area.height())
+                                .arg(_contentRect.left() - area.left())
+                                .arg(_contentRect.top() - area.top())
+                                .arg(fw)
+                                .arg(fh)
+                                .arg(_cyberFxGen)
+                                .arg(_columns)
+                                .arg(_lines)
+            + QTime::currentTime().toString(QStringLiteral("HH:mm"));
+        if (key != _cyberHudKey || _cyberHudPixmap.isNull()) {
+            _cyberHudKey = key;
+            QImage image(area.size(), QImage::Format_ARGB32_Premultiplied);
+            image.fill(Qt::transparent);
+            QPainter painter(&image);
+            painter.translate(-area.topLeft());
+            cyberPaintHud(painter, area);
+            painter.end();
+            _cyberHudPixmap = QPixmap::fromImage(image);
+        }
+        // It lives in the margins: skip the text area, where most repaints happen.
+        const QRegion margins = clip - QRect(_contentRect.left(), _contentRect.top(), _columns * fw, _lines * fh);
+        for (const QRect &rect : margins) {
+            paint.drawPixmap(rect, _cyberHudPixmap, rect.translated(-area.topLeft()));
+        }
+    }
+
+    // Bell: one soft glow along the border in the alert color, rising fast and fading out.
+    if (_cyberBellStart != 0) {
+        const qreal t = (now - _cyberBellStart) / (CYBER_BELL_MS * _cyberFactor);
+        if (t < 1.0) {
+            const qreal rise = qMin(1.0, t / 0.12);
+            const qreal envelope = t < 0.12 ? rise * rise * (3 - 2 * rise) : std::pow(1.0 - (t - 0.12) / 0.88, 2.0);
+            paint.setBrush(Qt::NoBrush);
+            for (int i = 0; i < CYBER_BELL_WIDTH; ++i) {
+                QColor color = fx.bellColors.alert;
+                color.setAlphaF(qBound(0.0, 0.8 * fx.bellLevel * envelope * std::pow(1.0 - qreal(i) / CYBER_BELL_WIDTH, 2.0), 1.0));
+                paint.setPen(QPen(color, 1));
+                paint.drawRect(area.adjusted(i, i, -i - 1, -i - 1));
+            }
+        }
+    }
+
+    paint.restore();
+}
+
+void TerminalDisplay::cyberPaintHud(QPainter &paint, const QRect &area)
+{
+    // Corner brackets, rulers and a few data labels, all in the margins around the text.
+    const CyberFxSettings &fx = cyberFxSettings();
+    const int fw = _terminalFont->fontWidth();
+    const int fh = _terminalFont->fontHeight();
+    QColor line = fx.hudColors.line;
+    line.setAlphaF(qMin(1.0, 0.2 + 0.6 * fx.hudLevel));
+    QColor faint = line;
+    faint.setAlphaF(line.alphaF() * 0.4);
+    QColor label = fx.hudColors.label;
+    label.setAlphaF(qMin(1.0, 0.25 + 0.65 * fx.hudLevel));
+
+    const QRect box = area.adjusted(2, 2, -3, -3);
+    const int arm = qBound(8, qMin(box.width(), box.height()) / 10, 28);
+    paint.setRenderHint(QPainter::Antialiasing, false);
+    paint.setPen(QPen(line, 1));
+    paint.drawLine(box.topLeft(), box.topLeft() + QPoint(arm, 0));
+    paint.drawLine(box.topLeft(), box.topLeft() + QPoint(0, arm));
+    paint.drawLine(box.topRight(), box.topRight() - QPoint(arm, 0));
+    paint.drawLine(box.topRight(), box.topRight() + QPoint(0, arm));
+    paint.drawLine(box.bottomLeft(), box.bottomLeft() + QPoint(arm, 0));
+    paint.drawLine(box.bottomLeft(), box.bottomLeft() - QPoint(0, arm));
+    paint.drawLine(box.bottomRight(), box.bottomRight() - QPoint(arm, 0));
+    paint.drawLine(box.bottomRight(), box.bottomRight() - QPoint(0, arm));
+    for (const QPoint &corner : {box.topLeft(), box.topRight() - QPoint(1, 0), box.bottomLeft() - QPoint(0, 1), box.bottomRight() - QPoint(1, 1)}) {
+        paint.fillRect(QRect(corner, QSize(2, 2)), label);
+    }
+
+    const int topRoom = _contentRect.top() - area.top();
+    const int leftRoom = _contentRect.left() - area.left();
+    const int textBottom = _contentRect.top() + _lines * fh;
+    const int bottomRoom = area.bottom() + 1 - textBottom;
+    // Rulers: a tick every 10 columns on the top edge and every 5 lines on the left one.
+    paint.setPen(QPen(faint, 1));
+    if (topRoom >= 6) {
+        for (int c = 10; c < _columns; c += 10) {
+            const int x = _contentRect.left() + c * fw;
+            if (x > box.left() + arm && x < box.right() - arm) {
+                paint.drawLine(x, box.top(), x, box.top() + (c % 50 == 0 ? 3 : 1));
+            }
+        }
+    }
+    if (leftRoom >= 6) {
+        for (int l = 5; l < _lines; l += 5) {
+            const int y = _contentRect.top() + l * fh;
+            if (y > box.top() + arm && y < box.bottom() - arm) {
+                paint.drawLine(box.left(), y, box.left() + (l % 25 == 0 ? 3 : 1), y);
+            }
+        }
+    }
+
+    if (!fx.hudData) {
+        return;
+    }
+    QFont small = _terminalFont->getVTFont();
+    // With the data cascade on, the top margin is its band: the labels stay along its upper edge.
+    const int labelRoom = qMin(_cyberCascadeOn ? qMax(_margin, 10) : topRoom, bottomRoom);
+    small.setPixelSize(qBound(6, labelRoom - 3, 9));
+    small.setCapitalization(QFont::AllUppercase);
+    small.setLetterSpacing(QFont::PercentageSpacing, 112);
+    small.setWeight(QFont::DemiBold);
+    paint.setFont(small);
+    const QFontMetrics metrics(small);
+    const auto row = [&](int top, int room, const QString &left, const QString &right) {
+        if (room < 8) {
+            return;
+        }
+        const int baseline = top + (room + metrics.capHeight()) / 2;
+        const int leftX = box.left() + arm + 6;
+        const int rightX = box.right() - arm - 6 - metrics.horizontalAdvance(right);
+        const int leftEnd = leftX + metrics.horizontalAdvance(left);
+        paint.setPen(label);
+        paint.drawText(leftX, baseline, left);
+        paint.drawText(rightX, baseline, right);
+        // A thin line joining the labels, like the frames of the reference HUD.
+        if (rightX - leftEnd > 40) {
+            paint.fillRect(QRect(leftEnd + 8, baseline - metrics.capHeight() / 2, rightX - leftEnd - 16, 1), faint);
+        }
+    };
+    row(area.top(),
+        _cyberCascadeOn ? qMin(topRoom, qMax(_margin, 10)) : topRoom,
+        QStringLiteral("CyberKDE//tty"),
+        QStringLiteral("%1×%2").arg(_columns).arg(_lines));
+    const QString sessionLabel = session() ? QStringLiteral("ses %1 // link").arg(session()->sessionId(), 2, 10, QLatin1Char('0')) : QStringLiteral("link");
+    row(textBottom, bottomRoom, sessionLabel, QTime::currentTime().toString(QStringLiteral("HH:mm")));
+}
