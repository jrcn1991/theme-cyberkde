+QColor cyberGradient(const QList<QPair<qreal, QColor>> &stops, qreal t)
+{
+    for (int i = 1; i < stops.size(); ++i) {
+        if (t <= stops[i].first) {
+            const qreal span = stops[i].first - stops[i - 1].first;
+            return cyberMix(stops[i - 1].second, stops[i].second, span > 0 ? (t - stops[i - 1].first) / span : 1.0);
+        }
+    }
+    return stops.last().second;
+}
