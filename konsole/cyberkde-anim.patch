+QColor cyberHex(const QString &text, const QColor &fallback)
+{
+    const QColor color = QColor::fromString(text.trimmed());
+    return color.isValid() ? color : fallback;
+}
+
+QColor cyberMix(const QColor &a, const QColor &b, qreal t)
+{
+    return QColor::fromRgbF(a.redF() + (b.redF() - a.redF()) * t, a.greenF() + (b.greenF() - a.greenF()) * t, a.blueF() + (b.blueF() - a.blueF()) * t);
+}
