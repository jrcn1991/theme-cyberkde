+// Cheap per-process random numbers for the cascade (xorshift).
+float cyberRandom()
+{
+    static quint32 state = 0x9E3779B9u;
+    state ^= state << 13;
+    state ^= state >> 17;
+    state ^= state << 5;
+    return float(state & 0xFFFFFF) / float(0x1000000);
+}
