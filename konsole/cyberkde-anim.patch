+// CyberKDE animation tuning (milliseconds / cells); scaled by the KDE animation speed.
+constexpr qreal CYBER_REVEAL_MS = 300;
+constexpr qreal CYBER_TRAIL_MS = 240;
+constexpr int CYBER_BURST_WINDOW_MS = 300;
+constexpr int CYBER_BURST_CELLS = 6000; // more than this within the window is drawn at once
+constexpr int CYBER_QUIET_MS = 600; // no animation this long after a mouse wheel scroll
+constexpr int CYBER_TRAIL_MAX_CELLS = 40;
+constexpr int CYBER_HALO = 4;
+constexpr int CYBER_PULSE_MS = 1600; // halo breathing period
+constexpr int CYBER_MAX_SHIFT = 24; // redraw-style scrolls detected up to this many lines
+
+quint64 cyberCellKey(int line, int column)
+{
+    return (quint64(quint32(line)) << 16) | quint16(column);
+}
