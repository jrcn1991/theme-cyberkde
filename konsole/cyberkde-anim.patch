+void cyberCascadeRead(CyberCascadeSettings &s)
+{
+    // A fresh read of the file (not the app's shared konsolerc object, which may hold unsaved changes).
+    const KConfig config(QStringLiteral("konsolerc"), KConfig::SimpleConfig);
+    const KConfigGroup group(&config, QStringLiteral("CyberKDE"));
+    s.on = group.readEntry("Cascata", false);
+    s.lines = qBound(2, group.readEntry("CascataLinhas", 5), 20);
+    s.stops.clear();
+    if (group.readEntry("CascataCores", QStringLiteral("video")) == QLatin1String("tema")) {
+        // Theme colors: accent (cyberkde cor) on the inner edge, warning, then the secondary color.
+        QFile file(cyberConfigPath(QStringLiteral("cyberkde/cor")));
+        const QColor accent = cyberHex(file.open(QIODevice::ReadOnly) ? QString::fromUtf8(file.readAll()) : QString(), QColor(0xF7, 0x50, 0x49));
+        QFile paletteFile(cyberConfigPath(QStringLiteral("cyberkde/paleta")));
+        const QJsonObject palette = paletteFile.open(QIODevice::ReadOnly) ? QJsonDocument::fromJson(paletteFile.readAll()).object() : QJsonObject();
+        const QColor second = cyberHex(palette.value(QStringLiteral("secundaria")).toString(), QColor(0x5E, 0xF6, 0xFF));
+        const QColor warning = cyberHex(palette.value(QStringLiteral("alerta")).toString(), accent);
+        const QColor white(0xF4, 0xF0, 0xFC);
+        s.stops = {{0.00, accent.darker(260)},
+                   {0.06, accent.darker(150)},
+                   {0.14, accent},
+                   {0.30, warning},
+                   {0.46, cyberMix(warning, white, 0.5)},
+                   {0.58, cyberMix(second, white, 0.8)},
+                   {0.74, second},
+                   {1.00, second.darker(190)}};
+    } else {
+        // The reference video: dark olive fibres, red, orange, gold, white-lavender, violet.
+        s.stops = {{0.00, QColor(0x3A, 0x2C, 0x12)},
+                   {0.05, QColor(0x8C, 0x5C, 0x22)},
+                   {0.11, QColor(0xD8, 0x3E, 0x1C)},
+                   {0.20, QColor(0xEE, 0x6C, 0x28)},
+                   {0.31, QColor(0xE4, 0xA8, 0x30)},
+                   {0.45, QColor(0xF0, 0xD0, 0x5C)},
+                   {0.57, QColor(0xF4, 0xEE, 0xFC)},
+                   {0.71, QColor(0xC4, 0xB4, 0xF4)},
+                   {0.86, QColor(0x8C, 0x78, 0xDA)},
+                   {1.00, QColor(0x56, 0x44, 0xA8)}};
+    }
+}
