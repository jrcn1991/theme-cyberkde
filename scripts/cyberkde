declare -A konsole_param_nome_en=([intensidade]="Intensity" [densidade]="Density" [direcao]="Direction" [cores]="Colors" [tamanho]="Size" [vinheta]="Vignette" [curvatura]="Curvature" [intervalo]="Interval (s)" [dados]="Readouts")

konsole_efeito_linha() {  # id -> linha da tabela
  local l
  for l in "${konsole_efeitos_tabela[@]}"; do [[ ${l%%|*} == "$1" ]] && { printf '%s\n' "$l"; return 0; }; done
  return 1
}
konsole_pref() { kreadconfig6 --file "$efeitos_file" --group "konsole-$1" --key "$2" --default "$3" 2>/dev/null; }

# O Konsole tem estes efeitos? A marca é a chave VarreduraIntervalo na biblioteca (vieram no mesmo patch).
konsole_tem_efeitos() { konsole_lib_tem "${1:-}" VarreduraIntervalo; }  # prefixo

# Integração do shell para o konsole-erro, sem tocar no ~/.bashrc: o perfil do tema abre o bash com
# --rcfile neste arquivo, que carrega o ~/.bashrc de sempre (o /etc/bash.bashrc o bash lê sozinho) e
# acrescenta as marcas OSC 133 (o mesmo esquema do vte-2.91.sh). Fora do perfil CyberKDE, ou com o
# konsole-erro desligado, nada muda. Só para bash (o shell da usuária); outro shell: aviso.
konsole_shell_rc="$config/cyberkde/konsole-shell.sh"
konsole_perfil="$data/konsole/CyberKDE.profile"
konsole_shell_integrar() {  # on|off
  if [[ $1 == on && ${SHELL##*/} == bash ]]; then
    put_file "$konsole_shell_rc" <<'EOF'
# CyberKDE: integração semântica do shell (OSC 133) para o efeito konsole-erro.
# O perfil CyberKDE do Konsole abre o bash com --rcfile neste arquivo, só com o efeito ligado
# ("cyberkde efeito konsole-erro on"); o "cyberkde off" o remove. Primeiro, o ~/.bashrc de sempre.
if [[ -f ~/.bashrc ]]; then . ~/.bashrc; fi
if [[ $- == *i* && -n ${KONSOLE_VERSION:-} && $PS1 != *']133;'* ]]; then
  PS1='\[\e]133;D;$?\e\\\e]133;A\e\\\]'"$PS1"'\[\e]133;B\e\\\]'
  PS0='\e]133;C\e\\'"${PS0:-}"
fi
EOF
    set_key "$konsole_perfil" General Command "/bin/bash --rcfile $konsole_shell_rc"
  else
    chave_restaurar "$konsole_perfil" General Command
  fi
}
konsole_integracao_ativa() {
  grep -qs '133;' "$HOME/.bashrc" && return 0
  [[ -s $konsole_shell_rc ]] && grep -qsF -- "--rcfile $konsole_shell_rc" "$konsole_perfil" &&
    [[ $(kreadconfig6 --file konsolerc --group "Desktop Entry" --key DefaultProfile) == CyberKDE.profile ]]
}

# Grava um efeito no konsolerc (pela fase konsole-anim): ligado e todos os parâmetros. Animado com
# movimento reduzido ou mínimo: desligado (a escolha guardada volta com o completo).
konsole_efeito_aplicar() {  # id
  local id=$1 linha chave anima params p nome suf tipo faixa padrao v ligado
  linha=$(konsole_efeito_linha "$id") || return 0
  [[ -s $efeitos_file ]] && grep -q "^\[konsole-$id\]" "$efeitos_file" || return 0
  IFS='|' read -r _ chave anima params <<<"$linha"
  ligado=$(konsole_pref "$id" ligado false)
  [[ $ligado == true ]] || ligado=false
  if [[ $anima == 1 && $(movimento_nivel) != completo ]]; then ligado=false; fi
  set_key konsolerc CyberKDE "$chave" "$ligado"
  IFS=',' read -ra params <<<"$params"
  for p in "${params[@]}"; do
    IFS=':' read -r nome suf tipo faixa padrao <<<"$p"
    v=$(konsole_pref "$id" "$nome" "$padrao")
    set_key konsolerc CyberKDE "$chave$suf" "$v"
  done
  if [[ $id == erro ]]; then konsole_shell_integrar "$([[ $ligado == true ]] && echo on || echo off)"; fi
}
efeitos_konsole_aplicar() {  # cascata + os oito (fase konsole-anim, movimento)
  efeito_cascata_aplicar
  local l
  for l in "${konsole_efeitos_tabela[@]}"; do konsole_efeito_aplicar "${l%%|*}"; done
}

konsole_efeito_estado() {  # id -> objeto JSON
  local id=$1 linha chave anima params p nome suf tipo faixa padrao v campos="" disp=false depois=false
  linha=$(konsole_efeito_linha "$id") || return 0
  IFS='|' read -r _ chave anima params <<<"$linha"
  v=$(konsole_pref "$id" ligado false); [[ $v == true ]] || v=false
  campos="\"ligado\":$v"
  IFS=',' read -ra params <<<"$params"
  for p in "${params[@]}"; do
    IFS=':' read -r nome suf tipo faixa padrao <<<"$p"
    v=$(konsole_pref "$id" "$nome" "$padrao")
    case $tipo in
      int) [[ $v =~ ^[0-9]+$ ]] || v=$padrao; campos+=",\"$nome\":$v" ;;
      bool) [[ $v == true ]] && campos+=",\"$nome\":true" || campos+=",\"$nome\":false" ;;
      *) campos+=",\"$nome\":$(json_str "$v")" ;;
    esac
  done
  v=$(kreadconfig6 --file konsolerc --group CyberKDE --key "$chave" --default false)
  campos+=",\"aplicado\":$([[ $v == true ]] && echo true || echo false)"
  if konsole_tem_efeitos "$(konsole_prefixo_em_uso)"; then disp=true; fi
  if konsole_tem_efeitos "$(patched_prefix konsole)"; then depois=true; fi
  campos+=",\"disponivel\":$disp,\"disponivelAoReligar\":$depois"
  if [[ $anima == 1 ]]; then campos+=",\"pausadoPeloMovimento\":$([[ $(movimento_nivel) != completo ]] && echo true || echo false)"; fi
  if [[ $id == erro ]]; then campos+=",\"integracaoShell\":$(konsole_integracao_ativa && echo true || echo false)"; fi
  printf '{%s}' "$campos"
}

konsole_efeito_json() {  # id -> item da lista de efeitos
  local id=$1 linha chave anima params p nome suf tipo faixa padrao opcoes="" o previa
  linha=$(konsole_efeito_linha "$id") || return 0
  IFS='|' read -r _ chave anima params <<<"$linha"
  IFS=',' read -ra params <<<"$params"
  for p in "${params[@]}"; do
    IFS=':' read -r nome suf tipo faixa padrao <<<"$p"
    o="\"id\":\"$nome\",\"nome\":$(json_str "${konsole_param_nome[$nome]:-$nome}"),\"nome_en\":$(json_str "${konsole_param_nome_en[$nome]:-$nome}")"
    case $tipo in
      int) o+=",\"tipo\":\"inteiro\",\"min\":${faixa%-*},\"max\":${faixa#*-},\"padrao\":$padrao" ;;
      bool) o+=",\"tipo\":\"escolha\",\"padrao\":\"$([[ $padrao == true ]] && echo on || echo off)\",\"valores\":[\"on\",\"off\"]" ;;
      enum) o+=",\"tipo\":\"escolha\",\"padrao\":\"$padrao\",\"valores\":$(json_list ${faixa//\// })" ;;  # json_list já põe os []
    esac
    opcoes+="${opcoes:+,}{$o}"
  done
  previa="$project/assets/previas/konsole/$id.webp"
  [[ -f $previa ]] || previa=""
  printf '{"id":"konsole-%s","grupo":"terminal","nome":%s,"nome_en":%s,"descricao":%s,"descricao_en":%s,"tipo":"liga","previa":%s,"opcoes":[%s],"estado":%s}' \
    "$id" "$(json_str "${konsole_efeito_nome[$id]}")" "$(json_str "${konsole_efeito_nome_en[$id]}")" \
    "$(json_str "${konsole_efeito_desc[$id]}")" "$(json_str "${konsole_efeito_desc_en[$id]}")" \
    "$(json_caminho "$previa")" "$opcoes" "$(konsole_efeito_estado "$id")"
}

#   cyberkde efeito konsole-<id> [on|off] [intensidade N] [cores tema|video] [<parâmetro> valor]... [--json]
#   (os parâmetros também como --<parâmetro> valor; bool = on|off). Saída: 0 · 2 uso · 3 ocupado
konsole_efeito_cmd() {  # id args...
  local id=$1 linha chave anima params p nome suf tipo faixa padrao acao="" arg v
  shift
  linha=$(konsole_efeito_linha "$id")
  IFS='|' read -r _ chave anima params <<<"$linha"
  IFS=',' read -ra params <<<"$params"
  local -A novo=() tipo_de=() faixa_de=()
  local nomes=""
  for p in "${params[@]}"; do
    IFS=':' read -r nome suf tipo faixa padrao <<<"$p"
    tipo_de[$nome]=$tipo faixa_de[$nome]=$faixa nomes+=" $nome"
  done
  local uso
  uso=$(t "uso: cyberkde efeito konsole-$id [on|off]$(for n in $nomes; do printf ' [%s …]' "$n"; done) [--json]" \
    "usage: cyberkde efeito konsole-$id [on|off]$(for n in $nomes; do printf ' [%s …]' "$n"; done) [--json]")
  while (( $# )); do
    arg=${1#--}; shift
    case $arg in
      on | off) acao=$arg ;;
      *)
        [[ -n ${tipo_de[$arg]:-} && $# -gt 0 ]] || cor_exit 2 "$uso"
        v=$1; shift
        case ${tipo_de[$arg]} in
          int) [[ $v =~ ^[0-9]+$ ]] && (( v >= ${faixa_de[$arg]%-*} && v <= ${faixa_de[$arg]#*-} )) ||
                 cor_exit 2 "$(t "$arg: de ${faixa_de[$arg]/-/ a }" "$arg: ${faixa_de[$arg]/-/ to }")" ;;
          bool) case $v in on) v=true ;; off) v=false ;; *) cor_exit 2 "$(t "$arg: on ou off" "$arg: on or off")" ;; esac ;;
          enum) [[ /${faixa_de[$arg]}/ == */"$v"/* ]] || cor_exit 2 "$(t "$arg: ${faixa_de[$arg]//\// ou }" "$arg: ${faixa_de[$arg]//\// or }")" ;;
        esac
        novo[$arg]=$v ;;
    esac
  done
  local -a avisos=()
  if [[ -n $acao || ${#novo[@]} -gt 0 ]]; then
    take_lock || cor_exit 3 "$(t "ocupado: outra execução do cyberkde está em andamento" "busy: another cyberkde run is in progress")"
    mkdir -p -- "$(dirname -- "$efeitos_file")"
    local w=(kwriteconfig6 --file "$efeitos_file" --group "konsole-$id")
    "${w[@]}" --key ligado "$( [[ $acao == on ]] && echo true || { [[ $acao == off ]] && echo false || konsole_pref "$id" ligado false; } )"
    for nome in "${!novo[@]}"; do "${w[@]}" --key "$nome" "${novo[$nome]}"; done
    if fase_ligada konsole-anim; then
      (fase_atual=konsole-anim; konsole_efeito_aplicar "$id")
    else
      avisos+=("$(t "O Konsole animado (fase konsole-anim) está desligado: a escolha foi guardada e vale no próximo cyberkde on." "The animated Konsole (konsole-anim part) is off: the choice was saved and applies on the next cyberkde on.")")
    fi
  fi
  local estado
  estado=$(konsole_efeito_estado "$id")
  if [[ $(konsole_pref "$id" ligado false) == true ]]; then
    if [[ $estado == *'"pausadoPeloMovimento":true'* ]]; then
      avisos+=("$(t "Movimento $(movimento_nivel): este efeito animado fica desligado até cyberkde efeito movimento completo." "Motion $(movimento_nivel): this animated effect stays off until cyberkde efeito movimento completo.")")
    fi
    if [[ $estado != *'"disponivel":true'* ]]; then
      if [[ $estado == *'"disponivelAoReligar":true'* ]]; then
        avisos+=("$(t "O Konsole do lançador ainda não tem este efeito; a compilação mais nova tem. Rode cyberkde on konsole-anim e abra um Konsole novo." "The launcher's Konsole does not have this effect yet; the newer build does. Run cyberkde on konsole-anim and open a new Konsole.")")
      else
        avisos+=("$(t "O Konsole animado instalado é anterior a estes efeitos: valem depois de atualizar (cyberkde animados com o pacote novo, ou cyberkde konsole-build)." "The installed animated Konsole predates these effects: they apply after updating it (cyberkde animados with the new package, or cyberkde konsole-build).")")
      fi
    fi
    if [[ $id == erro && $estado == *'"integracaoShell":false'* ]]; then
      avisos+=("$(t "Precisa da integração do shell: ela vem no perfil CyberKDE do Konsole (fase konsole) com bash. Abra um Konsole novo." "Needs the shell integration: it comes with the CyberKDE Konsole profile (konsole part) on bash. Open a new Konsole.")")
    fi
  fi
  if (( cor_json )); then
    local corpo=${estado#\{}
    printf '{"efeito":"konsole-%s",%s,"avisos":%s}\n' "$id" "${corpo%\}}" "$(json_list_str "${avisos[@]}")" >&3
  else
    echo "konsole-$id: $estado"
    local a
    for a in "${avisos[@]}"; do echo "$(t Aviso Note): $a" >&2; done
  fi
}

# Um efeito do registro por linha da tabela (as funções do contrato chamam as genéricas).
for konsole_linha in "${konsole_efeitos_tabela[@]}"; do
  konsole_id=${konsole_linha%%|*}
  CYBERKDE_EFEITOS+=("konsole-$konsole_id")
  CYBERKDE_EFEITO_GRUPO[konsole-$konsole_id]=terminal
  eval "efeito_cmd_konsole-$konsole_id() { konsole_efeito_cmd $konsole_id \"\$@\"; }"
  eval "efeito_json_konsole-$konsole_id() { konsole_efeito_json $konsole_id; }"
  eval "efeito_estado_konsole-$konsole_id() { konsole_efeito_estado $konsole_id; }"
done
unset konsole_linha konsole_id

# ------------------------------------------------------------------ papel por corporação
# Preferência [papel] modo em ~/.config/cyberkde/efeitos:
#   corp  o papel (e com ele o bloqueio e o login, pelo "login --fundo papel") acompanha a corporação:
#         "cyberkde corp X" troca o papel para o dela (opção "corp" do módulo papeis-de-parede);
#   fixo  a pessoa escolheu um papel (efeito papel a|b|c|d, ou uma imagem própria com "cyberkde papel"):
#         a corporação não mexe nele.
# Sem a chave: fixo se já havia escolha (opção gravada ou imagem própria), corp se não.
papel_modo() {
  local m
  m=$(kreadconfig6 --file "$efeitos_file" --group papel --key modo 2>/dev/null)
  case $m in corp | fixo) echo "$m"; return ;; esac
  local o
  o=$(kreadconfig6 --file "$efeitos_file" --group papel --key opcao 2>/dev/null)
  if [[ -s $config/cyberkde/papel-de-parede ]] || [[ -n $o && $o != corp ]]; then
    echo fixo
  else
    echo corp
  fi
}
papel_modo_gravar() { mkdir -p -- "$(dirname -- "$efeitos_file")"; kwriteconfig6 --file "$efeitos_file" --group papel --key modo "$1"; }
# O módulo de papel sabe fazer o papel da corporação? (a opção "corp" no papel_opcao dele)
papel_corp_suportado() { declare -F papel_opcao >/dev/null && [[ $(declare -f papel_opcao) == *corp* ]]; }
papel_status_json() {
  printf '{"modo":"%s","opcao":%s,"imagemPropria":%s,"corpSuportado":%s}' "$(papel_modo)" \
    "$(json_caminho "$(kreadconfig6 --file "$efeitos_file" --group papel --key opcao 2>/dev/null)")" \
    "$([[ -s $config/cyberkde/papel-de-parede ]] && echo true || echo false)" \
    "$(papel_corp_suportado && echo true || echo false)"
}

# O "efeito papel" do módulo, com o modo: a|b|c|d = fixo; corp = acompanha a corporação; padrao = o do
# tema, que acompanha a corporação. A lógica de cada opção continua no módulo.
if declare -F efeito_cmd_papel >/dev/null; then
  eval "$(declare -f efeito_cmd_papel | sed '1s/^efeito_cmd_papel /efeito_cmd_papel_modulo /')"
  efeito_cmd_papel() {
    local arg modo=""
    for arg in "$@"; do
      case $arg in a | b | c | d) modo=fixo ;; corp | padrao) modo=corp ;; esac
    done
    if [[ " $* " == *" corp "* ]] && ! papel_corp_suportado; then
      cor_exit 2 "$(t "o papel por corporação ainda não existe nesta versão do módulo de papel de parede" "the per-corporation wallpaper does not exist in this version of the wallpaper module yet")"
    fi
    if [[ -n $modo ]]; then papel_modo_gravar "$modo"; fi
    local escolheu=0
    for arg in "$@"; do [[ $arg == a || $arg == b || $arg == c || $arg == d || $arg == corp || $arg == padrao ]] && escolheu=1; done
    if (( ! escolheu )) || ! declare -F login_fundo_seguir >/dev/null; then
      efeito_cmd_papel_modulo "$@"
      return
    fi
    # Papel trocado: o login e o bloqueio acompanham ("login --fundo papel"). A resposta do módulo é
    # guardada e ganha "pendentesSudo"/"retomar" (a tela do SDDM só muda com sudo).
    # Sem $( ): no mesmo processo, o módulo segura a trava até o fim e o cor_exit dele responde. Se
    # ele sair com erro, o trap EXIT entrega a resposta (já em arquivo) a quem chamou.
    local resposta pend tmpj
    tmpj=$(mktemp)
    exec 4>&3
    trap 'cat -- "'"$tmpj"'" >&4 2>/dev/null; rm -f -- "'"$tmpj"'"' EXIT
    efeito_cmd_papel_modulo "$@" 3>"$tmpj"
    trap - EXIT
    resposta=$(<"$tmpj")
    rm -f -- "$tmpj"
    pend=$(mktemp)
    (sem_sudo_pendentes=$pend; login_fundo_seguir) || true
    local -a pendentes=()
    mapfile -t pendentes <"$pend"
    rm -f -- "$pend"
    local retomar=""
    if (( ${#pendentes[@]} )); then
      retomar="cyberkde efeito papel $*"
      retomar=${retomar% --json}
      echo "$(t "Aviso: a tela de login ficou com o papel anterior (precisa de sudo). Rode num terminal:" "Note: the login screen kept the previous wallpaper (needs sudo). Run in a terminal:") $retomar" >&2
    fi
    if (( cor_json )) && [[ $resposta == \{*\} ]]; then
      printf '%s,"pendentesSudo":%s%s}\n' "${resposta%\}}" "$(json_list_str "${pendentes[@]}")" "$(retomar_json "$retomar")" >&3
    elif [[ -n $resposta ]]; then
      printf '%s\n' "$resposta" >&3
    fi
  }
fi

# ------------------------------------------------------------------ ícone do painel
# O ícone do "Painel do CyberKDE" no menu acompanha a cor e a corporação; com o tema desligado, o neutro.
# Quem desenha é o app/gerar_icone.py do MAX: "--saida DIR" gera DIR/cyberkde-painel.svg e
# DIR/hicolor/<N>x<N>/apps/cyberkde-painel.png (ele lê a cor e a corporação de ~/.config/cyberkde; o
# neutro é "--corp nenhuma" com o vermelho do tema). Se ele não existir ou falhar, a forma antiga
# "--saida arquivo.svg [--neutro]"; por fim, o app/cyberkde-painel.svg recolorido.
# Vai para o hicolor com um nome que muda com a imagem (cyberkde-painel-<resumo>), como o ícone do
# menu: nenhum cache de ícones do KDE serve a imagem velha. O Icon= do lançador aponta para ele.
painel_icone_atualizar() {
  local modelo="$project/app/cyberkde-painel.svg" ger="$project/app/gerar_icone.py" tmp nome f n
  local lancador="$data/applications/cyberkde-painel.desktop" ico="$data/icons/hicolor"
  [[ -f $modelo || -f $ger ]] || return 0
  tmp=$(mktemp -d)
  local -a neutro=() neutro_antigo=()
  if ! tema_ligado; then
    neutro=(--corp nenhuma --cor "$(corp_cor_padrao 2>/dev/null || echo '#F75049')") neutro_antigo=(--neutro)
  fi
  if [[ -f $ger ]] && python3 "$ger" --saida "$tmp/saida" "${neutro[@]}" >/dev/null 2>&1 && [[ -s $tmp/saida/cyberkde-painel.svg ]]; then
    :
  elif [[ -f $ger ]] && mkdir -p "$tmp/saida" && python3 "$ger" --saida "$tmp/saida/cyberkde-painel.svg" "${neutro_antigo[@]}" >/dev/null 2>&1 &&
    [[ -s $tmp/saida/cyberkde-painel.svg ]]; then
    :
  elif [[ -f $modelo ]]; then
    mkdir -p "$tmp/saida"
    if (( ${#neutro[@]} )); then
      cp -- "$modelo" "$tmp/saida/cyberkde-painel.svg"
    else
      local cores destaque base
      cores=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from cyberlib import RED, BASE; print(RED, BASE)' "$project/generator")
      read -r destaque base <<<"$cores"
      sed -e "s/#F75049/$destaque/gI" -e "s/#12121C/$base/gI" "$modelo" >"$tmp/saida/cyberkde-painel.svg"
    fi
  fi
  if [[ ! -s $tmp/saida/cyberkde-painel.svg ]]; then rm -rf -- "$tmp"; return 0; fi
  # O nome vem do conteúdo (SVG e PNGs juntos).
  nome="cyberkde-painel-$(find "$tmp/saida" -type f -print0 | sort -z | xargs -0 cat | md5sum | cut -c1-10)"
  if [[ ! -f $ico/scalable/apps/$nome.svg ]]; then
    install -Dm644 -- "$tmp/saida/cyberkde-painel.svg" "$ico/scalable/apps/$nome.svg"
    for f in "$tmp"/saida/hicolor/*/apps/cyberkde-painel.png; do
      [[ -f $f ]] || continue
      n=${f#"$tmp/saida/hicolor/"}; n=${n%%/*}  # <N>x<N>
      install -Dm644 -- "$f" "$ico/$n/apps/$nome.png"
    done
    find "$ico" -path '*/apps/cyberkde-painel-*' ! -name "$nome.svg" ! -name "$nome.png" -delete 2>/dev/null || true
  fi
  rm -rf -- "$tmp"
  # O lançador do instalar.sh (fora do registro do tema): só o Icon=.
  if [[ -f $lancador ]] && ! grep -qx "Icon=$nome" "$lancador"; then
    sed -i "s|^Icon=.*|Icon=$nome|" "$lancador"
  fi
}

# ------------------------------------------------------------------ efeito "cursor"
# Tema de cursor do MAX (modules/cursor): a fase opcional "cursor" liga e desliga ("cyberkde on/off
# cursor"); a variante (padrao, neon, minimo) é uma preferência em ~/.config/cyberkde/efeitos
# [cursor] variante, que o módulo lê (cursor_variante) e aplica (efeito_cursor_aplicar). Só entra na
# lista de efeitos se o módulo estiver presente.
if declare -F phase_cursor >/dev/null && declare -F efeito_cursor_aplicar >/dev/null; then
  CYBERKDE_EFEITOS+=(cursor)
fi
declare -A cursor_nomes=([padrao]="CyberKDE Cursor" [neon]="CyberKDE Cursor Neon" [minimo]="CyberKDE Cursor Mínimo" [mira]="CyberKDE Cursor Mira")
declare -A cursor_nomes_en=([padrao]="CyberKDE Cursor" [neon]="CyberKDE Cursor Neon" [minimo]="CyberKDE Cursor Minimal" [mira]="CyberKDE Cursor Crosshair")
# Grupos dos efeitos do MAX (icones-opcoes e papeis-de-parede), para o painel organizar.
CYBERKDE_EFEITO_GRUPO+=([icones]=interface [papel]=area-de-trabalho [splash]=login [login]=login)
cursor_previa() {  # variante -> caminho absoluto da prévia, ou nada
  local f="$project/assets/previas/cursor/$1.png"
  if [[ -f $f ]]; then printf '%s\n' "$f"; fi
}

# Estado: a variante escolhida, se a fase cursor está ligada e o tema de cursor em uso agora.
efeito_estado_cursor() {
  local ligado=false
  if fase_ligada cursor; then ligado=true; fi
  printf '{"variante":"%s","ligado":%s,"aplicado":%s,"ligarCom":"cyberkde on cursor","desligarCom":"cyberkde off cursor"}' \
    "$(cursor_variante)" "$ligado" "$(json_str "$(kreadconfig6 --file kcminputrc --group Mouse --key cursorTheme --default breeze_cursors)")"
}

efeito_json_cursor() {
  local v valores=""
  for v in "${cursor_variantes[@]}"; do
    valores+="${valores:+,}{\"id\":\"$v\",\"nome\":$(json_str "${cursor_nomes[$v]:-$v}"),\"nome_en\":$(json_str "${cursor_nomes_en[$v]:-$v}"),\"previa\":$(json_caminho "$(cursor_previa "$v")")}"
  done
  printf '{"id":"cursor","nome":%s,"nome_en":%s,"descricao":%s,"descricao_en":%s,"tipo":"variante","opcoes":[{"id":"variante","nome":"Variante","nome_en":"Variant","tipo":"variante","padrao":"padrao","valores":[%s]}],"estado":%s}' \
    "$(json_str "Cursor do tema")" "$(json_str "Theme cursor")" \
    "$(json_str "Cursores com cantoneiras e o destaque do tema. Liga e desliga pela fase cursor; a variante vale na hora com ela ligada.")" \
    "$(json_str "Cursors with corner brackets and the theme accent. Turned on and off by the cursor part; the variant applies right away while it is on.")" \
    "$valores" "$(efeito_estado_cursor)"
}

#   cyberkde efeito cursor [padrao|neon|minimo|mira] [--json]   (sem variante: só lê)
#   --json: {"efeito":"cursor",<estado>,"avisos":[...]}. Saída: 0 · 2 uso · 3 ocupado
efeito_cmd_cursor() {
  local variante="" arg
  for arg in "$@"; do
    case $arg in
      padrao | neon | minimo | mira) [[ -z $variante ]] && variante=$arg || variante=invalida ;;
      *) variante=invalida ;;
    esac
  done
  [[ $variante != invalida ]] || cor_exit 2 "$(t "uso: cyberkde efeito cursor [padrao|neon|minimo|mira] [--json]" "usage: cyberkde efeito cursor [padrao|neon|minimo|mira] [--json]")"
  local -a avisos=()
  if [[ -n $variante ]]; then
    take_lock || cor_exit 3 "$(t "ocupado: outra execução do cyberkde está em andamento" "busy: another cyberkde run is in progress")"
    mkdir -p -- "$(dirname -- "$efeitos_file")"
    kwriteconfig6 --file "$efeitos_file" --group cursor --key variante "$variante"
    if fase_ligada cursor; then
      (fase_atual=cursor; efeito_cursor_aplicar)
    else
      avisos+=("$(t "O cursor do tema está desligado: a variante foi guardada; para usar, cyberkde on cursor." "The theme cursor is off: the variant was saved; to use it, cyberkde on cursor.")")
    fi
  fi
  local estado
  estado=$(efeito_estado_cursor)
  if (( cor_json )); then
    local corpo=${estado#\{}
    printf '{"efeito":"cursor",%s,"avisos":%s}\n' "${corpo%\}}" "$(json_list_str "${avisos[@]}")" >&3
  else
    echo "$(t "Cursor do tema" "Theme cursor"): $estado"
    local a
    for a in "${avisos[@]}"; do echo "$(t Aviso Note): $a" >&2; done
  fi
}

# "cyberkde on": liga o tema. Interface estável para programas que chamam o cyberkde
# (DOCUMENTACAO.md, seção "Interface do cyberkde on"):
#   cyberkde on [fase] [--sem-sudo] [--json] [--progresso]
#   saída: 0 aplicado · 1 falha · 2 fase ou opção inválida · 3 ocupado · 4 aplicado, com pendências
#          de sudo · 5 interrompido
# ------------------------------------------------------------------ exclusão mútua com o AppleKDE
# Os dois temas gravam as MESMAS chaves (kdeglobals, kwinrc, plasmarc…) e cada um registra, na
# primeira gravação, o valor que encontra como "original". Aplicar um por cima do outro gravaria os
# valores do outro tema como originais, e nenhum "off" voltaria ao padrão do KDE. Regra combinada
# com o AppleKDE (lá: docs/tecnico/TRATADO_TEMAS.md): quem liga desliga o outro antes, CONFIRMA que
# desligou e só então aplica; sem confirmação, não aplica nada e diz o que fazer.
# Sem o AppleKDE instalado nada disto age: não há binário nem registro, e o "on" segue como sempre.
# Travas: nenhum dos dois espera o outro. O "applekde off" toma a trava dele com flock -n (código 3
# se ocupado), e o CYBERKDE_ON_EM_CURSO=1 diz a ele que a trava do cyberkde já é nossa — sem isso o
# off deles a pediria e sairia 3 para sempre (ordem de travas, não concorrência).
applekde_state="${XDG_STATE_HOME:-$HOME/.local/state}/applekde"

applekde_bin() {
  local b
  if b=$(command -v applekde 2>/dev/null); then printf '%s\n' "$b"; return 0; fi
  for b in "$HOME/.local/bin/applekde" "$HOME/.local/opt/applekde/scripts/applekde"; do
    if [[ -x $b ]]; then printf '%s\n' "$b"; return 0; fi
  done
  return 1
}

# Registro do AppleKDE: ledger.tsv, files.tsv e os .tsv dos módulos dele (qualquer um não vazio).
applekde_registro() {
  local f
  for f in "$applekde_state"/*.tsv; do
    if [[ -s $f ]]; then return 0; fi
  done
  return 1
}

# Ligado? Pelo "applekde status --json" ANCORADO no começo: "ligado" é o primeiro campo (contrato
# deles), e sem a âncora o campo "cyberkdeLigado" do mesmo JSON poderia confundir. Saída
# inesperada ou sem binário: vale o registro em disco (o lado seguro).
applekde_ligado() {
  local bin
  if bin=$(applekde_bin); then
    case $("$bin" status --json 2>/dev/null) in
      '{"ligado":true'*) return 0 ;;
      '{"ligado":false'*) return 1 ;;
    esac
  fi
  applekde_registro
}

# O "applekde off" vai precisar de root? (arquivos de /etc, /usr ou /opt que existem no disco ou
# têm original guardado; os que nunca chegaram ao disco não contam, como no off deles)
applekde_exige_root() {
  local f="$applekde_state/files.tsv" dst backup
  [[ -s $f ]] || return 1
  while IFS=$'\t' read -r dst backup; do
    case $dst in /etc/* | /usr/* | /opt/*) ;; *) continue ;; esac
    if [[ ! -e $dst && ! -L $dst && $backup == - ]]; then continue; fi
    return 0
  done <"$f"
  return 1
}

# Chamado pelo cmd_on com a NOSSA trava já tomada e antes de qualquer gravação. Volta só com o
# AppleKDE desligado e confirmado; em qualquer outro caso sai (cor_exit) sem ter aplicado nada.
#   applekde off: 0 ok · 1 falha · 3 ocupado · 4 tudo devolvido menos arquivos de sistema (root)
applekde_desligar() {
  applekde_ligado || return 0
  local bin rc=0 e
  if ! bin=$(applekde_bin); then
    cor_exit 1 "o AppleKDE está ligado (registro em $applekde_state), mas o comando 'applekde' não foi encontrado: desligue-o com 'applekde off' (ou reinstale o AppleKDE) e rode 'cyberkde on' de novo. Nada foi aplicado."
  fi
  if applekde_exige_root && [[ ! -t 0 && -z ${SUDO_ASKPASS:-} ]]; then
    cor_exit 1 "o AppleKDE está ligado e desligá-lo pede sudo (arquivos de sistema), mas não há terminal: rode 'applekde off' num terminal e depois 'cyberkde on'. Nada foi aplicado."
  fi
  echo "AppleKDE ligado: rodando 'applekde off' antes (os dois temas não se misturam)…" >&2
  # Nunca repassar o modo sem sudo: o off deles deixaria arquivos de sistema para trás (código 4).
  sem_travas env -u APPLEKDE_SEM_SUDO CYBERKDE_ON_EM_CURSO=1 "$bin" off >&2 || rc=$?
  case $rc in
    0) ;;
    3) cor_exit 3 "o AppleKDE está ocupado (outra execução do applekde); tente de novo daqui a pouco. Nada foi aplicado." ;;
    4) cor_exit 1 "o 'applekde off' devolveu tudo menos arquivos de sistema (precisa de root): rode 'applekde off' num terminal e depois 'cyberkde on'. Nada foi aplicado." ;;
    *) cor_exit 1 "o 'applekde off' falhou (código $rc): veja as mensagens acima, rode 'applekde off' de novo e depois 'cyberkde on'. Nada foi aplicado." ;;
  esac
  # Confirmação: o próprio AppleKDE diz que desligou E o registro principal dele sumiu.
  if applekde_ligado || [[ -s $applekde_state/ledger.tsv || -s $applekde_state/files.tsv ]]; then
    cor_exit 1 "o 'applekde off' terminou, mas o AppleKDE continua ligado (registro em $applekde_state): rode 'applekde off' de novo e depois 'cyberkde on'. Nada foi aplicado."
  fi
  # O reconfigure do KWin não descarrega efeito cuja chave sumiu (rede de segurança).
  for e in applekde_janelas applekde_popups applekde_glass; do
    qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect "$e" >/dev/null 2>&1 || true
  done
  echo "AppleKDE desligado." >&2
}

cmd_on() {
  local phase="" arg bad=0 p reiniciado=false painel=false
  for arg in "$@"; do
    case $arg in
      --json) cor_json=1 ;;
      --sem-sudo) CYBERKDE_SEM_SUDO=1 ;;
      --progresso) cor_progresso=1 ;;
      *) if [[ -z $phase && $arg != -* ]]; then phase=$arg; else bad=1; fi ;;
    esac
  done
  phase=${phase:-tudo}
  # --json: a saída padrão fica só com a linha JSON; as mensagens vão para a saída de erro.
  if (( cor_json )); then exec 3>&1 1>&2; else exec 3>&1; fi
  (( bad == 0 )) || cor_exit 2 "uso: cyberkde on [fase] [--sem-sudo] [--json] [--progresso]"
  if [[ $phase != tudo ]] && ! declare -F "phase_$phase" >/dev/null; then
    cor_exit 2 "fase desconhecida: $phase"
  fi
  take_lock || cor_exit 3 "ocupado: outra execução do cyberkde está em andamento"
  applekde_desligar  # exclusão mútua: nada é gravado com o AppleKDE ligado
  set -E
  trap 'cor_exit 1 "falha ao ligar o tema (detalhes na saída de erro)"' ERR
  trap cor_interrupted TERM INT HUP
  kvantum_ok || echo "Aviso: Kvantum não instalado; as formas chanfradas só aparecem depois de instalar o Kvantum para Qt 6 (no Ubuntu/Debian: qt-style-kvantum)." >&2

  local -a fases=() aplicadas=() puladas=() pendentes=()
  if [[ $phase == tudo ]]; then
    fases=("${CYBERKDE_PHASES[@]}")
    painel=true
  else
    fases=("$phase")
    if phase_needs_plasmashell "$phase"; then painel=true; fi
  fi
  progress_total=$(( INSTALL_STEPS + ${#CYBERKDE_INSTALLS[@]} + ${#fases[@]} ))
  if [[ $phase == tudo ]]; then progress_total=$(( progress_total + 1 )); fi   # kwin
  if [[ $painel == true ]]; then progress_total=$(( progress_total + 1 )); fi
  progress inicio
  sem_sudo_pendentes="$state/sem-sudo-pendentes"  # as_needed anota aqui o que ficou sem gravar
  # Reinício do plasmashell só no fim (ver restart_plasmashell): o que uma fase pedir fica anotado.
  rm -f -- "$plasma_adiar_marca"
  export CYBERKDE_ADIAR_PLASMA=1
  # Registro vazio: tudo o que entrar agora sai com a fase anotada, então vale por fase desde já.
  if [[ ! -s $ledger && ! -s $files ]]; then mkdir -p "$state"; : >"$fases_ok"; fi
  install_files
  for p in "${fases[@]}"; do
    progress fase "$p"
    : >"$sem_sudo_pendentes"
    fase_atual=$p
    # Subshell: uma fase que não pode rodar (ex.: app ainda não compilado) não impede as outras.
    if ("phase_$p"); then
      if [[ -s $sem_sudo_pendentes ]]; then
        pendentes+=("$p")
        echo "  … $p (pendente: precisa de sudo)"
      else
        aplicadas+=("$p")
        echo "  ✓ $p"
      fi
    else
      puladas+=("$p")
      echo "  – $p (pulada)"
    fi
  done
  fase_atual=""
  # Com uma fase pulada, as linhas antigas dela continuariam sem dono certo: espera o próximo "on".
  if [[ $phase == tudo && ${#puladas[@]} -eq 0 ]]; then registro_marca_legado; fi
  # Fase avulsa que grava uma chave de outra fase ligada que vem depois (login × papeis-de-parede): a
  # chave volta ao valor da outra, como ficaria num "on" completo.
  if [[ $phase != tudo ]]; then chaves_reafirmar "$phase"; fi
  if [[ $phase == tudo ]]; then
    progress kwin
    reload_kwin
  fi
  unset CYBERKDE_ADIAR_PLASMA
  if [[ -e $plasma_adiar_marca ]]; then painel=true; rm -f -- "$plasma_adiar_marca"; fi
  if [[ $painel == true ]]; then
    progress painel  # o painel guarda cache do tema e dos ícones
    if restart_plasmashell; then
      reiniciado=true
    else
      echo "Aviso: não consegui reiniciar o plasmashell; o painel e a área de trabalho podem" \
        "continuar com os ícones antigos." >&2
    fi
  fi
  progress fim
  rm -f "$sem_sudo_pendentes"
  painel_icone_atualizar  # tema ligado: o ícone do painel na cor do tema
  trap - ERR TERM INT HUP
  if (( ${#pendentes[@]} )); then
    local retomar="cyberkde on"
    if [[ $phase != tudo ]]; then retomar+=" $phase"; fi
    echo "Aplicado, menos: ${pendentes[*]} (precisa de sudo). Para completar, rode no terminal:" \
      "$retomar"
  elif [[ $phase == tudo ]]; then
    echo "CyberKDE ligado. Reabra os aplicativos para ver tudo; 'cyberkde off' volta ao padrão."
  elif [[ $phase == dolphin ]]; then
    echo "Fase 'dolphin' aplicada. Feche e reabra o Dolphin para ver o resultado."
  else
    echo "Fase '$phase' aplicada; já vale para as janelas abertas e as próximas."
  fi
  if (( cor_json )); then
    local -a avisos=()
    mapfile -t avisos < <(avisos_de "${pendentes[@]}")
    local retomar_cmd=""
    if (( ${#pendentes[@]} )); then retomar_cmd="cyberkde on${phase:+ $phase}"; retomar_cmd=${retomar_cmd% tudo}; fi
    printf '{"fase":"%s","cor":"%s","corAplicada":"%s","padrao":%s,"temaLigado":true,"aplicadas":%s,"puladas":%s,"pendentesSudo":%s,"avisos":%s,"plasmaReiniciado":%s%s}\n' \
      "$phase" "$(accent_color)" "$(accent_applied)" "$(accent_is_default)" "$(json_list "${aplicadas[@]}")" \
      "$(json_list "${puladas[@]}")" "$(json_list "${pendentes[@]}")" "$(json_list_str "${avisos[@]}")" \
      "$reiniciado" "$(retomar_json "$retomar_cmd")" >&3
  fi
  (( ${#pendentes[@]} == 0 )) || exit 4
}

# Processos ainda de pé rodando os binários que o CyberKDE compilou. O "off" devolve o lançador, o
# .desktop e os serviços D-Bus, mas não mexe em quem já estava rodando — e um Dolphin nosso que
# detenha org.freedesktop.FileManager1 continua servindo "abrir pasta" para o sistema inteiro
# depois que o tema saiu, sem sintoma nenhum para quem usa. Em 20/09 era exatamente esse o estado
# da máquina: o daemon das 11:25 servindo o nome com o tema desligado desde as 13h.
# TERM e não KILL: o Dolphin salva o estado das janelas ao sair.
# O Konsole fica FORA de propósito: encerrar um terminal mata o que estiver rodando dentro dele,
# inclusive uma sessão de trabalho de outra pessoa. Aqui só avisamos.
encerra_compilados() {  # [dolphin|konsole]: só o desse app (o "off <fase>"); sem argumento, os dois
  local pid exe konsole=0 so=${1:-}
  [[ -z ${CYBERKDE_CENA:-} ]] || return 0  # KWin virtual: os processos achados seriam os da sessão real
  for pid in $(pgrep -u "$USER" . 2>/dev/null || true); do
    exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null) || continue
    case $so:$exe in
      konsole:"$HOME/.local/opt/cyberkde-dolphin/"* | konsole:/opt/cyberkde-dolphin/*) ;;
      dolphin:"$HOME/.local/opt/cyberkde-konsole/"* | dolphin:/opt/cyberkde-konsole/*) ;;
      *:"$HOME/.local/opt/cyberkde-dolphin/"* | *:/opt/cyberkde-dolphin/*)
        echo "  encerrando o Dolphin do CyberKDE que continuava rodando (pid $pid)."
        kill -TERM "$pid" 2>/dev/null || true
        ;;
      *:"$HOME/.local/opt/cyberkde-konsole/"* | *:/opt/cyberkde-konsole/*) konsole=$(( konsole + 1 )) ;;
    esac
  done
  if (( konsole )); then
    echo "Ainda há $konsole Konsole do CyberKDE aberto; feche essas janelas quando puder." \
      "Não encerro terminal sozinho: mataria o que estiver rodando dentro." >&2
  fi
}

off_pendente_sudo=0 off_falha_modulo=0 off_responde_json=0  # por que o cmd_off falhou (o "off --json" informa)
cmd_off() {
  # Antes da saída antecipada: um processo de tema desligado tem de cair mesmo quando não há mais
  # nada registrado para desfazer (um "off" repetido, ou o processo sobrevivendo ao off anterior).
  encerra_compilados
  if [[ ! -s $ledger && ! -s $files ]] && ! modulo_registro; then
    echo "Nada aplicado; o sistema já está no padrão."
    return
  fi
  local file group key orig dst backup falhou=0 pendentes hook
  progress modulos  # (as linhas PROGRESSO só saem com "off --progresso")
  for hook in "${CYBERKDE_PRE_OFF_HOOKS[@]}"; do
    "$hook" || { falhou=1; off_falha_modulo=1; }
  done
  progress chaves
  if [[ -s $ledger ]]; then
    tac "$ledger" | while IFS=$'\t' read -r file group key orig; do
      if [[ $orig == "$absent" ]]; then
        kcfg write "$file" "$group" "$key" --delete
      else
        kcfg write "$file" "$group" "$key" "$orig"
      fi
    done
    rm -f "$ledger"
  fi
  progress arquivos
  if [[ -s $files ]]; then
    pendentes=$(mktemp)
    local sem_sudo_pendentes=$pendentes sem_sudo_avisa=1  # as_needed anota o que ficou sem gravar
    # Sem pipeline: o "while" tem de rodar no shell principal, senão o registro do que faltou
    # morre no subshell junto com ele.
    while IFS=$'\t' read -r dst backup; do
      # Destino que não existe e não tinha original: não há o que desfazer. Sem isto o "off" pede
      # sudo para apagar um arquivo que nunca chegou ao disco — acontece sempre que o "on" rodou
      # --sem-sudo, porque o remember_path registra ANTES de escrever (a ordem inversa seria pior:
      # uma interrupção deixaria arquivo gravado e fora do registro, ou seja, sem volta).
      if [[ ! -e $dst && ! -L $dst && $backup == - ]]; then continue; fi
      as_needed "$dst" rm -rf -- "$dst"
      if [[ $backup != - ]]; then
        as_needed "$dst" cp -r --preserve=mode,timestamps -- "$backup" "$dst"
      fi
    done < <(tac "$files")
    sem_sudo_pendentes="" sem_sudo_avisa=0
    if [[ -s $pendentes ]]; then
      # Guarda só o que NÃO foi devolvido (e as cópias), para um "off" com sudo terminar o serviço.
      awk -F'\t' 'NR == FNR { p[$0] = 1; next } ($1 in p)' "$pendentes" "$files" >"$files.novo"
      mv -f "$files.novo" "$files"
      echo "Não devolvi $(wc -l <"$files") arquivo(s) de sistema (sem sudo); o registro foi mantido" \
        "em $files. Rode 'cyberkde off' num terminal, com sudo, para terminar." >&2
      falhou=1 off_pendente_sudo=1
    else
      rm -rf "$files" "$state/files"
    fi
    rm -f "$pendentes"
  fi
  # Registro vazio: as anotações de fase não servem mais (o próximo "on" começa outro registro).
  if [[ ! -s $ledger && ! -s $files ]]; then rm -f "$fases_reg" "$fases_ok" "$fases_valores"; fi
  progress desfazer
  for hook in "${CYBERKDE_OFF_HOOKS[@]}"; do
    "$hook" || { falhou=1; off_falha_modulo=1; }
  done
  progress kwin
  reload_kwin
  progress painel
  refresh_plasmashell
  painel_icone_atualizar  # tema desligado: o ícone neutro
  if (( falhou )); then
    echo "Reversão INCOMPLETA: veja as pendências acima." >&2
    # Pelo "off --json" quem decide o código é o cmd_off_tudo_json (pelas marcas acima): sem isto, o
    # "return 1" com set -e encerraria o script antes da linha JSON.
    if (( off_responde_json )); then return 0; fi
    return 1
  fi
  echo "Valores originais restaurados. Reabra os aplicativos afetados."
}

# Texto entre aspas no JSON (caminhos de arquivo podem ter aspas ou barras invertidas).
json_str() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf '"%s"' "$s"; }

# ------------------------------------------------------------------ fases
# "cyberkde fases [--json]": só leitura. Interface para o painel (app/):
#   {"fases":[{"id","nome","descricao","ligada","precisaSudo","grupo","disponivel","opcional","grupoNome",
#              "nome_en","descricao_en","grupoNome_en"}...],
#    "temaLigado":bool,"registroPorFase":bool}
# "ligada" vem do registro: a fase tem chave, arquivo ou estado de módulo aplicado. "disponivel" =
# a fase pode rodar aqui (ex.: Dolphin animado instalado). "registroPorFase" false = registro de uma
# versão anterior: o "off <fase>" se recusa até um "cyberkde on" anotar as fases.
cmd_fases() {
  local arg json=0
  for arg in "$@"; do
    case $arg in
      --json) json=1 ;;
      *) echo "uso: cyberkde fases [--json]" >&2; exit 2 ;;
    esac
  done
  local -A ligada=()
  local p lista="" ligado=false por_fase=false
  while IFS= read -r p; do ligada[$p]=1; done < <(fases_ligadas)
  if tema_ligado; then ligado=true; fi
  if registro_por_fase || ! tema_ligado; then por_fase=true; fi
  if (( json )); then
    for p in "${CYBERKDE_PHASES[@]}" "${CYBERKDE_FASES_OPCIONAIS[@]}"; do
      local opcional=true
      if [[ " ${CYBERKDE_PHASES[*]} " == *" $p "* ]]; then opcional=false; fi
      local grupo=${CYBERKDE_FASE_GRUPO[$p]:-sistema}
      lista+="${lista:+,}$(printf '{"id":"%s","nome":%s,"descricao":%s,"ligada":%s,"precisaSudo":%s,"grupo":"%s","disponivel":%s,"opcional":%s,"grupoNome":%s,"nome_en":%s,"descricao_en":%s,"grupoNome_en":%s}' \
        "$p" "$(json_str "${CYBERKDE_FASE_NOME[$p]:-$p}")" "$(json_str "${CYBERKDE_FASE_DESC[$p]:-}")" \
        "$([[ -n ${ligada[$p]:-} ]] && echo true || echo false)" \
        "$([[ ${CYBERKDE_FASE_SUDO[$p]:-nao} == sim ]] && echo true || echo false)" \
        "$grupo" "$(fase_disponivel "$p" && echo true || echo false)" "$opcional" "$(json_str "${CYBERKDE_GRUPO_NOME[$grupo]:-$grupo}")" \
        "$(json_str "${CYBERKDE_FASE_NOME_EN[$p]:-${CYBERKDE_FASE_NOME[$p]:-$p}}")" "$(json_str "${CYBERKDE_FASE_DESC_EN[$p]:-}")" \
        "$(json_str "${CYBERKDE_GRUPO_NOME_EN[$grupo]:-$grupo}")")"
    done
    printf '{"fases":[%s],"temaLigado":%s,"registroPorFase":%s}\n' "$lista" "$ligado" "$por_fase"
    return
  fi
  echo "Fases, na ordem do 'cyberkde on' (● ligada, ○ desligada):"
  for p in "${CYBERKDE_PHASES[@]}" "${CYBERKDE_FASES_OPCIONAIS[@]}"; do
    local extra=""
    if [[ ${CYBERKDE_FASE_SUDO[$p]:-nao} == sim ]]; then extra+=" [sudo]"; fi
    if [[ " ${CYBERKDE_PHASES[*]} " != *" $p "* ]]; then extra+=" [opcional]"; fi
    if ! fase_disponivel "$p"; then extra+=" [indisponível aqui]"; fi
    printf '  %s %-17s %s%s\n' "$([[ -n ${ligada[$p]:-} ]] && echo '●' || echo '○')" "$p" \
      "${CYBERKDE_FASE_DESC[$p]:-}" "$extra"
  done
  if [[ $por_fase == false ]]; then
    echo "O registro é de uma versão anterior do tema: rode 'cyberkde on' uma vez para ele valer por fase."
  fi
}

# ------------------------------------------------------------------ off <fase>
# "cyberkde off <fase>": desliga uma fase só. Interface estável, no formato do "on --json", mais
# "acao":"off" e "chavesMantidas" (chaves que outra fase ligada também gravou e que ficam como estão):
#   cyberkde off <fase> [--sem-sudo] [--json] [--progresso]
#   saída: 0 desligada (ou já estava) · 1 falha · 2 fase ou opção inválida · 3 ocupado · 4 desligada,
#          com pendências de sudo · 5 interrompido
# "aplicadas" = a fase foi desligada; "puladas" = ela já estava desligada.
avisos_off_de() {  # fases pendentes... -> uma frase por linha (mesma regra do avisos_de)
  local f
  for f in "$@"; do
    case $f in
      login) t "A tela de login continua com o tema: ela fica em /usr e só volta com root. O splash e a tela de bloqueio já voltaram." \
        "The login screen keeps the theme: it lives in /usr and only reverts as root. The splash and the lock screen already reverted."; echo ;;
      login-bloqueio) t "A tela de bloqueio continua com o tema: ela fica em /usr e só volta com root." \
        "The lock screen keeps the theme: it lives in /usr and only reverts as root."; echo ;;
    esac
  done
}

# "cyberkde off --json [--progresso] [--sem-sudo]": o "off" completo (o mesmo cmd_off), com as linhas
# PROGRESSO no stderr e uma linha JSON no fim, no formato do "off <fase>" com "fase":"tudo".
# "aplicadas" = fases que estavam ligadas e foram desligadas; "pendentesSudo" = as que deixaram
# arquivo de sistema para trás. Códigos: 0 · 1 falha · 3 ocupado · 4 pendente de sudo · 5 interrompido.
cmd_off_tudo_json() {
  if (( cor_json )); then exec 3>&1 1>&2; else exec 3>&1; fi
  take_lock || cor_exit 3 "ocupado: outra execução do cyberkde está em andamento"
  local -a antes=() aplicadas=() pendentes=() avisos=()
  local p ligado=false
  mapfile -t antes < <(fases_ligadas)
  # A fase dos arquivos que ficarem no registro (sem sudo) é anotada antes de o registro mudar.
  local -A fase_do_arquivo=()
  local tipo dst lista
  if [[ -f $fases_reg ]]; then
    while IFS=$'\t' read -r tipo dst lista; do
      if [[ $tipo == a ]]; then fase_do_arquivo[$dst]=$lista; fi
    done < <(awk -F'\t' '$1 == "a"' "$fases_reg")
  fi
  set -E
  trap 'cor_exit 1 "falha ao desligar o tema (detalhes na saída de erro)"' ERR
  trap cor_interrupted TERM INT HUP
  progress_total=6  # módulos, chaves, arquivos, desfazer, kwin, painel
  progress inicio
  off_responde_json=1
  cmd_off  # com set -e: um erro inesperado cai no trap ERR, como no "off" de sempre
  progress fim
  trap - ERR TERM INT HUP
  if (( off_falha_modulo )); then
    cor_exit 1 "o tema foi desligado pela metade (veja as mensagens acima); rode 'cyberkde off' de novo"
  fi
  if (( off_pendente_sudo )) && [[ -s $files ]]; then
    local -A vistas=()
    while IFS=$'\t' read -r dst _; do
      for p in ${fase_do_arquivo[$dst]//,/ }; do
        if [[ -z ${vistas[$p]:-} ]]; then vistas[$p]=1; pendentes+=("$p"); fi
      done
    done <"$files"
    (( ${#pendentes[@]} )) || pendentes=(login)  # registro antigo, sem fase: só o login grava em /usr
  fi
  for p in "${antes[@]}"; do
    [[ " ${pendentes[*]} " == *" $p "* ]] || aplicadas+=("$p")
  done
  if tema_ligado; then ligado=true; fi
  mapfile -t avisos < <(avisos_off_de "${pendentes[@]}")
  printf '{"fase":"tudo","acao":"off","cor":"%s","corAplicada":"%s","padrao":%s,"temaLigado":%s,"aplicadas":%s,"puladas":[],"pendentesSudo":%s,"avisos":%s,"plasmaReiniciado":%s,"chavesMantidas":0%s}\n' \
    "$(accent_color)" "$(accent_applied)" "$(accent_is_default)" "$ligado" "$(json_list "${aplicadas[@]}")" \
    "$(json_list "${pendentes[@]}")" "$(json_list_str "${avisos[@]}")" "$plasma_reiniciado" \
    "$(retomar_json "$( (( ${#pendentes[@]} )) && echo 'cyberkde off')")" >&3
  if (( ${#pendentes[@]} )); then exit 4; fi
}

cmd_off_fase() {
  local phase="" arg bad=0
  for arg in "$@"; do
    case $arg in
      --json) cor_json=1 ;;
      --sem-sudo) CYBERKDE_SEM_SUDO=1 ;;
      --progresso) cor_progresso=1 ;;
      *) if [[ -z $phase && $arg != -* ]]; then phase=$arg; else bad=1; fi ;;
    esac
  done
  # Sem fase e sem opções: o "off" de sempre, do jeito de sempre. Com --json ou --progresso, o mesmo
  # "off", contado e respondido no formato do "off <fase>" (só o --sem-sudo era ignorado e continua).
  if [[ -z $phase ]] && (( bad == 0 )); then
    if (( cor_json || cor_progresso )); then cmd_off_tudo_json; else take_lock || busy; cmd_off; fi
    return
  fi
  if (( cor_json )); then exec 3>&1 1>&2; else exec 3>&1; fi
  (( bad == 0 )) || cor_exit 2 "uso: cyberkde off [fase] [--sem-sudo] [--json] [--progresso]"
  declare -F "phase_$phase" >/dev/null || cor_exit 2 "fase desconhecida: $phase"
  take_lock || cor_exit 3 "ocupado: outra execução do cyberkde está em andamento"
  if tema_ligado && ! registro_por_fase; then
    cor_exit 1 "o registro do tema é de uma versão anterior e não diz de qual fase veio cada chave. Rode 'cyberkde on' uma vez (ele anota as fases; se ainda assim não der, 'cyberkde off' e 'cyberkde on') e depois 'cyberkde off $phase'. Nada foi desligado."
  fi
  local -a aplicadas=() puladas=() pendentes=() avisos=()
  local reiniciado=false mantidas=0 painel=false kwin=false
  if ! fase_ligada "$phase"; then
    echo "A fase '$phase' já está desligada."
    puladas=("$phase")
  else
    set -E
    trap 'cor_exit 1 "falha ao desligar a fase (detalhes na saída de erro)"' ERR
    trap cor_interrupted TERM INT HUP
    # A barra e a dock regravam o appletsrc com o plasmashell parado (off_barra-e-dock).
    if phase_needs_plasmashell "$phase" || [[ $phase == barra-e-dock ]]; then painel=true; fi
    progress_total=$(( 3 + 1 ))  # chaves, arquivos, módulo + kwin
    if [[ $painel == true ]]; then progress_total=$(( progress_total + 1 )); fi
    progress inicio
    case $phase in
      carregamento) encerra_compilados dolphin ;;
      konsole-anim) encerra_compilados konsole ;;
    esac
    if [[ " ${CYBERKDE_PRE_OFF_HOOKS[*]} " == *" pre_off_$phase "* ]]; then "pre_off_$phase"; fi

    # Plano: o que volta ao original (só esta fase gravou) e o que fica (outra fase ligada também
    # gravou: sai só o nome desta da lista). Nada é aplicado até o plano estar pronto, e o registro
    # só é trocado depois de devolver tudo: interrompido no meio, rodar de novo devolve o mesmo.
    local plano
    plano=$(mktemp -d "$state/off-fase.XXXXXX")
    mantidas=$(registro_unido | F=$phase D=$plano awk -F'\t' -v OFS='\t' "$registro_awk_inicio"'
      function decide(linha, novo, volta,   n, l, i, resto, tinha) {
        if (!(k in t)) { print linha > novo; return }
        n = split(t[k], l, ","); resto = ""; tinha = 0
        for (i = 1; i <= n; i++)
          if (l[i] == f) tinha = 1
          else if (l[i] != "") resto = resto (resto == "" ? "" : ",") l[i]
        if (!tinha) { print linha > novo; print k, t[k] > ns; return }
        if (resto == "") { print linha > volta; return }
        print linha > novo; print k, resto > ns; mantidas++
      }
      BEGIN { f = ENVIRON["F"]; d = ENVIRON["D"]; ns = d "/fases"
        printf "" > (d "/ledger"); printf "" > (d "/files"); printf "" > ns
        printf "" > (d "/chaves"); printf "" > (d "/arquivos") }
      { linha = $0; sub(/^[LF]\t/, "", linha) }
      $1 == "L" { decide(linha, d "/ledger", d "/chaves") }
      $1 == "F" { decide(linha, d "/files", d "/arquivos") }
      END { print mantidas + 0 }')

    progress chaves
    local file group key orig dst backup
    while IFS=$'\t' read -r file group key orig; do
      if [[ ${file##*/} == kwinrc ]]; then kwin=true; fi
      if [[ $orig == "$absent" ]]; then
        kcfg write "$file" "$group" "$key" --delete
      else
        kcfg write "$file" "$group" "$key" "$orig"
      fi
    done < <(tac "$plano/chaves")

    progress arquivos
    local pend
    pend=$(mktemp)
    local sem_sudo_pendentes=$pend sem_sudo_avisa=1  # as_needed anota o que ficou sem gravar
    while IFS=$'\t' read -r dst backup; do
      # Mesma regra do "off": destino que nunca chegou ao disco e não tinha original fica como está.
      if [[ ! -e $dst && ! -L $dst && $backup == - ]]; then continue; fi
      as_needed "$dst" rm -rf -- "$dst" || true
      if [[ $backup != - ]]; then
        as_needed "$dst" cp -r --preserve=mode,timestamps -- "$backup" "$dst" || true
      fi
    done < <(tac "$plano/arquivos")
    sem_sudo_pendentes="" sem_sudo_avisa=0
    # O que não voltou (sem sudo) continua no registro, ainda desta fase, para um "off" com sudo.
    while IFS=$'\t' read -r dst backup; do
      if grep -qxF -- "$dst" "$pend"; then
        printf '%s\t%s\n' "$dst" "$backup" >>"$plano/files"
        printf 'a\t%s\t%s\n' "$dst" "$phase" >>"$plano/fases"
      elif [[ $backup != - ]]; then
        printf '%s\n' "$backup" >>"$plano/backups-livres"
      fi
    done <"$plano/arquivos"
    if [[ -s $pend ]]; then pendentes=("$phase"); fi
    rm -f -- "$pend"
    # Troca o registro de uma vez e só então apaga as cópias dos originais já devolvidos.
    local par
    for par in ledger:"$ledger" files:"$files" fases:"$fases_reg"; do
      if [[ -s $plano/${par%%:*} ]]; then mv -f -- "$plano/${par%%:*}" "${par#*:}"; else rm -f -- "${par#*:}"; fi
    done
    if [[ -s $plano/backups-livres ]]; then
      while IFS= read -r backup; do rm -rf -- "$backup"; done <"$plano/backups-livres"
    fi
    rm -rf -- "$plano"
    chaves_reafirmar "$phase"  # chave que ficou: com o valor da última fase que ainda a usa
    if [[ -f $fases_valores ]]; then
      F=$phase awk -F'\t' '$4 != ENVIRON["F"]' "$fases_valores" >"$fases_valores.novo"
      mv -f -- "$fases_valores.novo" "$fases_valores"
    fi
    if [[ ! -s $ledger && ! -s $files ]]; then
      rm -rf -- "$state/files"
      # Nada mais no registro: o próximo "on" começa um registro novo (com o fases-completo de novo).
      if [[ -z $(fases_ligadas) ]]; then rm -f -- "$fases_reg" "$fases_ok" "$fases_valores"; fi
    fi

    progress modulo
    local hook_falhou=0
    if [[ " ${CYBERKDE_OFF_HOOKS[*]} " == *" off_$phase "* ]]; then
      "off_$phase" || hook_falhou=1  # o módulo mantém o próprio registro para tentar de novo
    fi
    if [[ $phase == janelas || $phase == plasma ]]; then kwin=true; fi
    if [[ $kwin == true ]]; then progress kwin; reload_kwin; fi
    if [[ $painel == true ]]; then
      progress painel
      if restart_plasmashell; then reiniciado=true; else
        echo "Aviso: não consegui reiniciar o plasmashell; o painel pode continuar com a aparência de antes." >&2
      fi
      # Os painéis devolvidos pelo off_barra-e-dock são os de antes do tema, com o papel de parede de
      # antes. Com a fase dos papéis de parede ainda ligada, ele volta ao do tema.
      if [[ $phase == barra-e-dock ]] && fase_ligada papeis-de-parede; then
        local i
        for i in {1..50}; do qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 && break; sleep 0.2; done
        (fase_atual=papeis-de-parede; phase_papeis-de-parede) ||
          echo "Aviso: o papel de parede do tema não voltou; rode 'cyberkde on papeis-de-parede'." >&2
      fi
    fi
    progress fim
    trap - ERR TERM INT HUP
    if (( hook_falhou )); then
      cor_exit 1 "a fase '$phase' foi desligada pela metade (veja as mensagens acima); rode 'cyberkde off $phase' de novo"
    fi
    if (( ${#pendentes[@]} )); then
      echo "Desligada, menos o que precisa de sudo. Para completar, rode no terminal: cyberkde off $phase"
    else
      aplicadas=("$phase")
      if (( mantidas )); then
        echo "Fase '$phase' desligada; $mantidas chave(s) continuam com o tema porque outra fase ligada também as usa."
      else
        echo "Fase '$phase' desligada. Reabra os aplicativos afetados."
      fi
    fi
  fi
  painel_icone_atualizar  # se esta fase era a última ligada, o ícone do painel volta ao neutro
  if (( cor_json )); then
    local ligado=false
    if tema_ligado; then ligado=true; fi
    mapfile -t avisos < <(avisos_off_de "${pendentes[@]}")
    printf '{"fase":"%s","acao":"off","cor":"%s","corAplicada":"%s","padrao":%s,"temaLigado":%s,"aplicadas":%s,"puladas":%s,"pendentesSudo":%s,"avisos":%s,"plasmaReiniciado":%s,"chavesMantidas":%d%s}\n' \
      "$phase" "$(accent_color)" "$(accent_applied)" "$(accent_is_default)" "$ligado" "$(json_list "${aplicadas[@]}")" \
      "$(json_list "${puladas[@]}")" "$(json_list "${pendentes[@]}")" "$(json_list_str "${avisos[@]}")" \
      "$reiniciado" "$mantidas" "$(retomar_json "$( (( ${#pendentes[@]} )) && echo "cyberkde off $phase")")" >&3
  fi
  (( ${#pendentes[@]} == 0 )) || exit 4
}

# ------------------------------------------------------------------ corporações
# A corporação escolhe a paleta (destaque, secundária, alerta e fundo), o ícone do botão do menu
# (barra e dock) e o logo largo da tela de abertura. Tudo fica em tokens/corporacoes.json, a fonte
# única que o painel (app/) também lê: para mudar uma cor, edite só aquele arquivo. Os arquivos da
# usuária em ~/.config/cyberkde/corporacoes/ vêm sempre antes dos do tema (ver corp_logo e
# corp_logo_largo). O tema funciona sem logo nenhum: o menu fica com os blocos e a abertura, sem logo.
corp_tokens="$project/tokens/corporacoes.json"
corp_file="$config/cyberkde/corp"
paleta_file="$config/cyberkde/paleta"  # secundária, alerta e fundo da corporação (lido pelo cyberlib)
corp_logos_usuario="$config/cyberkde/corporacoes"
corp_ids=()
declare -A corp_nomes=([personalizada]=Personalizada) corp_lemas=() corp_destaques=() corp_secundarias=() \
  corp_alertas=() corp_fundos=() corp_icones_tema=() corp_logos_tema=() corp_extras=()
corp_carregado=0

# Lê o JSON uma vez por execução (chame no processo principal: os $(...) herdam o que foi lido). As
# cores saem em maiúsculas; campo vazio vira "-" porque o read junta tabulações seguidas.
corp_carregar() {
  (( corp_carregado )) && return 0
  corp_carregado=1
  local id nome lema d s a f icone logo extras
  while IFS=$'\t' read -r id nome lema d s a f icone logo extras; do
    corp_ids+=("$id")
    corp_nomes[$id]=$nome
    corp_lemas[$id]=${lema#-}
    corp_destaques[$id]=$d corp_secundarias[$id]=$s corp_alertas[$id]=$a corp_fundos[$id]=$f
    corp_icones_tema[$id]=${icone#-} corp_logos_tema[$id]=${logo#-} corp_extras[$id]=${extras#-}
  done < <(python3 - "$corp_tokens" <<'PY' || echo "Aviso: não consegui ler $corp_tokens; sem corporações." >&2
import json, sys
dados = json.load(open(sys.argv[1], encoding="utf-8"))
CONHECIDOS = {"id", "nome", "lema", "destaque", "secundaria", "alerta", "fundo", "icone", "logo"}
for c in dados["corporacoes"]:
    campo = lambda k: (" ".join(str(c.get(k) or "").split()) or "-")
    cor = lambda k: campo(k).upper()
    # Campos a mais (lema_en, descricao, descricao_en...): vão como estão para o "corp --lista --json",
    # já em JSON. O painel lê o que o Lore acrescentar sem o CLI precisar saber o nome de cada um.
    extras = ",".join(json.dumps(k) + ":" + json.dumps(v, ensure_ascii=False) for k, v in c.items()
                      if k not in CONHECIDOS and not k.startswith("_"))
    print("\t".join([campo("id"), campo("nome"), campo("lema"), cor("destaque"), cor("secundaria"),
                     cor("alerta"), cor("fundo"), campo("icone"), campo("logo"), extras or "-"]))
PY
  )
}
corp_existe() { corp_carregar; [[ -n ${1:-} && -n ${corp_destaques[$1]:-} ]]; }

corp_gravar() { mkdir -p -- "$(dirname -- "$corp_file")"; printf '%s\n' "$1" >"$corp_file"; }
corp_nome() { corp_carregar; printf '%s' "${corp_nomes[$1]:-$1}"; }

# Paleta da corporação para os geradores. "nenhuma", "personalizada" ou desconhecida: sem arquivo, e
# a secundária, o alerta e o fundo são os do tema.
corp_paleta_gravar() {  # id
  if [[ ${1:-} == nenhuma ]] || ! corp_existe "${1:-}"; then rm -f -- "$paleta_file"; return; fi
  mkdir -p -- "$(dirname -- "$paleta_file")"
  printf '{"secundaria":"%s","alerta":"%s","fundo":"%s"}\n' \
    "${corp_secundarias[$1]}" "${corp_alertas[$1]}" "${corp_fundos[$1]}" >"$paleta_file"
}

# A corporação em uso. O arquivo corp só vale se a cor gravada ainda for a dela: uma cópia antiga do
# cyberkde (sem o "corp") pode ter trocado a cor por cima, e aí é "personalizada".
corp_atual() {
  local id="" cor=""
  corp_carregar
  if [[ -s $corp_file ]]; then id=$(<"$corp_file"); fi
  if [[ -s $accent_file ]]; then cor=$(<"$accent_file"); fi
  cor=${cor^^}
  if [[ $id != nenhuma ]] && corp_existe "$id" && [[ $cor == "${corp_destaques[$id]}" ]]; then echo "$id"
  elif [[ -z $cor ]]; then echo nenhuma
  else echo personalizada; fi
}

corp_caminho() {  # caminho do JSON -> absoluto (relativo à raiz do projeto), ou nada
  if [[ -z ${1:-} ]]; then return 0; fi
  if [[ $1 == /* ]]; then printf '%s\n' "$1"; else printf '%s\n' "$project/$1"; fi
}
primeiro_arquivo() { local f; for f in "$@"; do if [[ -s $f ]]; then printf '%s\n' "$f"; return 0; fi; done; }

# Ícone quadrado do botão do menu: o da usuária (<id>.svg ou .png), o "icone" do JSON, o emblema
# genérico do tema (assets/corporacoes/genericos/<id>.svg) ou nada. É o "corpLogo" dos JSON.
corp_logo() {  # id -> caminho, ou nada
  local tema
  corp_existe "${1:-}" || return 0  # personalizada: sem logo
  tema=$(corp_caminho "${corp_icones_tema[$1]:-}")
  primeiro_arquivo "$corp_logos_usuario/$1.svg" "$corp_logos_usuario/$1.png" ${tema:+"$tema"} \
    "$project/assets/corporacoes/genericos/$1.svg"
}

# Logo largo da tela de abertura: o da usuária (<id>-logo-escuro, depois <id>-logo; .svg ou .png),
# o "logo" do JSON (antes, a versão "-escuro" ao lado dele, feita para fundo escuro) e, sem logo
# largo, o ícone do menu.
corp_logo_largo() {  # id -> caminho, ou nada
  local tema achado u="$corp_logos_usuario/${1:-}"
  corp_existe "${1:-}" || return 0
  tema=$(corp_caminho "${corp_logos_tema[$1]:-}")
  achado=$(primeiro_arquivo "$u-logo-escuro.svg" "$u-logo-escuro.png" "$u-logo.svg" "$u-logo.png" \
    ${tema:+"${tema%.*}-escuro.${tema##*.}" "$tema"})
  if [[ -n $achado ]]; then printf '%s\n' "$achado"; else corp_logo "$1"; fi
}
corp_logo_do_usuario() { [[ $1 == "$corp_logos_usuario/"* ]]; }
corp_logo_texto() {  # id -> " (logo: ...)" para as mensagens
  local logo
  logo=$(corp_logo "$1")
  if [[ -n $logo ]]; then printf ' (logo: %s)' "$logo"; elif [[ $1 != nenhuma ]] && corp_existe "$1"; then printf ' (sem logo: fica o do tema)'; fi
}

# A paleta que os geradores aplicam agora (já clareada para ler e com o fundo tingido), num objeto
# JSON: destaque, secundaria, alerta, fundo (o tom pedido, depois do ajuste de contraste) e
# superficie (o fundo das janelas que sai dele).
paleta_json() {
  python3 -c 'import sys; sys.path.insert(0, sys.argv[1])
from cyberlib import RED, CYAN, ALERTA, BASE, TOK
print("{\"destaque\":\"%s\",\"secundaria\":\"%s\",\"alerta\":\"%s\",\"fundo\":\"%s\",\"superficie\":\"%s\"}" % (RED, CYAN, ALERTA, TOK["reference"]["darkestBlue"].upper(), BASE))' "$project/generator"
}

json_caminho() { if [[ -n ${1:-} ]]; then json_str "$1"; else echo null; fi; }  # "caminho" ou null
corp_json_campos() {  # ,"corp":"...","corpLogo":...,"corpLogoLargo":...  (para o fim de um JSON)
  local id
  id=$(corp_atual)
  printf ',"corp":"%s","corpLogo":%s,"corpLogoLargo":%s' "$id" "$(json_caminho "$(corp_logo "$id")")" \
    "$(json_caminho "$(corp_logo_largo "$id")")"
}

# "cyberkde corp [id] [--json] [--sem-sudo] [--progresso]": aplica a paleta da corporação pelo mesmo
# caminho do "cyberkde cor" (mesma saída, mesmos códigos 0/1/2/3/4/5; o JSON ganha "corp" e
# "corpLogo" no fim) e troca o logo do menu e da tela de abertura. Rodar de novo com a mesma
# corporação regenera tudo, inclusive o logo: é assim que um logo trocado pela usuária entra.
# Sem id: a atual. "--lista [--json]":
#   {"corps":[{"id","nome","cor","logo","logoDoUsuario","lema","secundaria","alerta","fundo"}],"atual"}
cmd_corp() {
  local id="" arg lista=0 bad=0
  local -a repassa=()
  corp_carregar
  for arg in "$@"; do
    case $arg in
      --json) cor_json=1; repassa+=(--json) ;;
      --sem-sudo | --progresso) repassa+=("$arg") ;;
      --lista) lista=1 ;;
      *) if [[ -z $id && $arg != -* ]]; then id=$arg; else bad=1; fi ;;
    esac
  done
  exec 3>&1  # o cmd_cor refaz os descritores; aqui só as respostas de erro e de leitura usam o 3
  local nomes_ids
  nomes_ids=$(IFS='|'; echo "${corp_ids[*]}")
  (( bad == 0 && ! (lista && ${#id}) )) ||
    cor_exit 2 "uso: cyberkde corp [${nomes_ids}|--lista] [--sem-sudo] [--json]"
  local atual c logo
  atual=$(corp_atual)
  if (( lista )); then
    local itens=""
    for c in "${corp_ids[@]}"; do
      logo=$(corp_logo "$c")
      if (( cor_json )); then
        local largo
        largo=$(corp_logo_largo "$c")
        itens+="${itens:+,}$(printf '{"id":"%s","nome":%s,"cor":"%s","logo":%s,"logoDoUsuario":%s,"lema":%s,"secundaria":"%s","alerta":"%s","fundo":"%s","icone":%s,"logoLargo":%s,"logoLargoDoUsuario":%s}' \
          "$c" "$(json_str "${corp_nomes[$c]}")" "${corp_destaques[$c]}" "$(json_caminho "$logo")" \
          "$(corp_logo_do_usuario "$logo" && echo true || echo false)" "$(json_str "${corp_lemas[$c]}")" \
          "${corp_secundarias[$c]}" "${corp_alertas[$c]}" "${corp_fundos[$c]}" "$(json_caminho "$logo")" \
          "$(json_caminho "$largo")" "$(corp_logo_do_usuario "$largo" && echo true || echo false)")"
        # Campos a mais do JSON (ver corp_carregar), antes do "}" final.
        if [[ -n ${corp_extras[$c]:-} ]]; then itens="${itens%\}},${corp_extras[$c]}}"; fi
      else
        printf '  %s %-12s %s  %s%s\n' "$([[ $c == "$atual" ]] && echo '●' || echo '○')" "$c" \
          "${corp_destaques[$c]}" "${corp_lemas[$c]}" "$(corp_logo_texto "$c")"
      fi
    done
    if (( cor_json )); then printf '{"corps":[%s],"atual":"%s"}\n' "$itens" "$atual" >&3; fi
    if (( ! cor_json )) && [[ $atual == personalizada ]]; then echo "  Em uso: cor personalizada ($(accent_color))."; fi
    return
  fi
  if [[ -z $id ]]; then  # só leitura
    logo=$(corp_logo "$atual")
    if (( cor_json )); then
      local ligado=false
      if tema_ligado; then ligado=true; fi
      printf '{"corp":"%s","nome":%s,"cor":"%s","corAplicada":"%s","logo":%s,"logoDoUsuario":%s,"temaLigado":%s,"paleta":%s,"logoLargo":%s}\n' \
        "$atual" "$(json_str "$(corp_nome "$atual")")" "$(accent_color)" "$(accent_applied)" \
        "$(json_caminho "$logo")" "$(corp_logo_do_usuario "$logo" && echo true || echo false)" \
        "$ligado" "$(paleta_json)" "$(json_caminho "$(corp_logo_largo "$atual")")" >&3
    else
      echo "Corporação: $(corp_nome "$atual")$(corp_logo_texto "$atual") · cor $(accent_color)"
    fi
    return
  fi
  corp_existe "$id" || cor_exit 2 "corporação desconhecida: $id (use ${nomes_ids//|/, })"
  cor_corp=$id
  if (( ! cor_json )); then echo "Corporação: $(corp_nome "$id")$(corp_logo_texto "$id")"; fi
  # "nenhuma" é a cor padrão (sem arquivo de cor), não o vermelho gravado como escolha.
  if [[ $id == nenhuma ]]; then cmd_cor padrao "${repassa[@]}"; else cmd_cor "${corp_destaques[$id]}" "${repassa[@]}"; fi
}

# ------------------------------------------------------------------ painel
# Dependências do painel (app/): PyQt6 com QtQml e QtQuick, e os módulos QML que os app/qml/*.qml
# importam. Nomes conferidos com "dpkg -S" no Ubuntu 26.04 (os .so do PyQt6 e os qmldir de cada
# módulo). Imprime os pacotes que faltam, um por linha; nada = tudo certo. O tema funciona sem o
# painel: quem chama decide se é aviso.
painel_deps_faltando() {
  local mod pkg qml
  for mod in QtCore:python3-pyqt6 QtGui:python3-pyqt6 QtQml:python3-pyqt6.qtqml QtQuick:python3-pyqt6.qtquick; do
    python3 -c "import PyQt6.${mod%%:*}" 2>/dev/null || echo "${mod#*:}"
  done | sort -u
  # Pasta dos módulos QML do Qt 6 (pelo próprio Qt, se o PyQt6 existir; senão, a do Debian/Ubuntu).
  qml=$(python3 -c 'from PyQt6.QtCore import QLibraryInfo; print(QLibraryInfo.path(QLibraryInfo.LibraryPath.QmlImportsPath))' 2>/dev/null ||
    true)
  [[ -d $qml ]] || qml=$(ls -d /usr/lib/*/qt6/qml 2>/dev/null | head -1)
  for mod in QtQuick:qml6-module-qtquick QtQuick/Window:qml6-module-qtquick-window \
    QtQuick/Shapes:qml6-module-qtquick-shapes QtQuick/Effects:qml6-module-qtquick-effects \
    QtQuick/Dialogs:qml6-module-qtquick-dialogs QtQml:qml6-module-qtqml; do
    [[ -f $qml/${mod%%:*}/qmldir ]] || echo "${mod#*:}"
  done
}

# "cyberkde painel": abre o painel gráfico (app/cyberkde-painel.py) e devolve o terminal na hora. Não
# toma a trava: o painel chama o próprio cyberkde para cada ação, e cada chamada trava sozinha. O
# sem_travas e o setsid garantem que ele não herda trava nem terminal. Saída do painel em $state.
cmd_painel() {
  local app="$project/app/cyberkde-painel.py" falta
  falta=$(painel_deps_faltando | tr '\n' ' ')
  falta=${falta% }
  # "cyberkde painel --checar": só confere as dependências (0 = tudo certo; 1 = falta, com a linha do apt).
  if [[ ${1:-} == --checar ]]; then
    if [[ -n $falta ]]; then echo "sudo apt install $falta"; return 1; fi
    return 0
  fi
  [[ -f $app ]] || { echo "Painel não encontrado em $app (esta cópia do tema não traz o painel)." >&2; exit 1; }
  if [[ -n $falta ]]; then
    echo "$(t "O painel precisa de pacotes que faltam. Instale com:" "The panel needs missing packages. Install them with:") sudo apt install $falta" >&2
    exit 1
  fi
  mkdir -p -- "$state"
  sem_travas setsid python3 "$app" "$@" >"$state/painel.log" 2>&1 </dev/null &
  echo "Abrindo o painel do CyberKDE (mensagens em $state/painel.log)."
}

# Parte do "status" que olha a sessão: animações do KWin carregadas, vídeo por software, barra e dock.
status_sessao() {
  local info efeitos e
  if ! info=$(qdbus6 org.kde.KWin /KWin supportInformation 2>/dev/null); then
    echo "Sessão: fora do Plasma (sem KWin no D-Bus); não dá para conferir animações e dock."
    return
  fi
  efeitos=$(qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.loadedEffects 2>/dev/null | tr '\n' ' ')
  for e in cyberkde_scan cyberkde_popups; do
    if [[ $(kreadconfig6 --file kwinrc --group Plugins --key "${e}Enabled" --default false) == true ]]; then
      if [[ " $efeitos " == *" $e "* ]]; then echo "Animação $e: carregada."
      else echo "Animação $e: ligada, mas o KWin NÃO a carregou."; fi
    fi
  done
  if grep -qiE 'OpenGL renderer string: .*(llvmpipe|softpipe|software)' <<<"$info"; then
    echo "Vídeo por software (llvmpipe): o KWin desliga todas as animações. Numa VM, ligue a aceleração 3D."
  fi
  if layout_tema; then
    local dock="nenhuma"
    if [[ -n $(latte_pids) ]]; then dock="Latte Dock"; elif [[ -s $dock_plasma_id ]]; then dock="painel do Plasma"; fi
    echo "Layout: barra em cima e dock ($dock$([[ -e $appletsrc_orig ]] || echo ', ainda não aplicado'))."
  else
    echo "Layout: manter (barra e dock como estavam)."
  fi
}

# "cyberkde status [--json]": só leitura. Não toma a trava e não grava nada. O --json é uma linha para
# programas; "ligado" é sempre o PRIMEIRO campo, para quem casa o JSON por prefixo.
cmd_status() {
  local arg json=0
  for arg in "$@"; do
    case $arg in
      --json) json=1 ;;
      *) echo "uso: cyberkde status [--json]" >&2; exit 2 ;;
    esac
  done
  if (( json )); then
    local ligado=false pendente=false completa=true chaves=0
    if tema_ligado; then ligado=true; fi
    if [[ ! -s $ledger ]] && { [[ -s $files ]] || modulo_registro; }; then pendente=true; fi
    if [[ -e $cor_marker ]]; then completa=false; fi
    if [[ -s $ledger ]]; then chaves=$(wc -l <"$ledger"); fi
    # Campos novos só no fim: o Halo e outros leem este JSON (e "ligado" tem de ser o primeiro).
    corp_carregar
    printf '{"ligado":%s,"cor":"%s","corAplicada":"%s","padrao":%s,"chaves":%d,"reversaoPendente":%s,"completa":%s,"kvantum":%s%s,"paleta":%s,"efeitos":%s,"papel":%s}\n' \
      "$ligado" "$(accent_color)" "$(accent_applied)" "$(accent_is_default)" "$chaves" \
      "$pendente" "$completa" "$(kvantum_ok && echo true || echo false)" "$(corp_json_campos)" "$(paleta_json)" "$(efeitos_status_json)" "$(papel_status_json)"
    return
  fi
  printf 'Kvantum: %s\n' "$(kvantum_ok && echo instalado || echo 'NÃO instalado')"
  local corp
  corp_carregar
  corp=$(corp_atual)
  printf 'Corporação: %s\n' "$(corp_nome "$corp")$(corp_logo_texto "$corp")"
  if applekde_ligado; then echo "AppleKDE ligado: o 'cyberkde on' roda 'applekde off' antes."; fi
  status_sessao
  if [[ ! -s $ledger ]]; then
    if [[ -s $files ]] || modulo_registro; then
      echo "CyberKDE: nenhuma chave alterada, mas ainda há registro de arquivos ou de módulos;" \
        "rode 'cyberkde off' para terminar a reversão."
    else
      echo "CyberKDE: desligado (nenhuma chave alterada)."
    fi
    return
  fi
  echo "CyberKDE: ligado. Chaves alteradas (arquivo · grupo · chave = atual  [original]):"
  local file group key orig
  while IFS=$'\t' read -r file group key orig; do
    # Saída fechada (ex.: "| head") com o SIGPIPE ignorado por quem chamou: para em silêncio.
    printf '  %s · %s · %s = %s  [%s]\n' "${file##*/}" "$group" "$key" \
      "$(kcfg read "$file" "$group" "$key")" \
      "$([[ $orig == "$absent" ]] && echo 'ausente' || echo "$orig")" 2>/dev/null || return 0
  done <"$ledger"
}

# Abre um app com a aparência original sem desligar o tema: usa um XDG_CONFIG_HOME
# temporário com links para as configs reais, exceto os arquivos alterados pelo
# CyberKDE, que viram cópias com os valores originais do registro.
cmd_padrao() {
  local app=${1:-dolphin} tmp file group key orig rel
  tmp=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/cyberkde-padrao.XXXXXX")
  (shopt -s nullglob dotglob; for f in "$config"/*; do ln -s "$f" "$tmp/"; done)
  if [[ -s $ledger ]]; then
    while IFS=$'\t' read -r file group key orig; do
      [[ $file == /* ]] || file="$config/$file"
      rel=${file#"$config"/}
      [[ $rel == */* ]] && continue  # só arquivos da raiz; o resto só vale com o estilo do tema
      [[ -L $tmp/$rel ]] && cp --remove-destination -- "$file" "$tmp/$rel"
      if [[ $orig == "$absent" ]]; then
        kcfg write "$tmp/$rel" "$group" "$key" --delete
      else
        kcfg write "$tmp/$rel" "$group" "$key" "$orig"
      fi
    done <"$ledger"
  fi
  local args=()
  [[ $app == dolphin ]] && args=(--new-window)
  # Sempre o programa do sistema, mesmo com versões compiladas pelo CyberKDE no PATH.
  local bin="/usr/bin/$app"
  [[ -x $bin ]] || bin=$app
  # 9>&-: o app aberto aqui vive muito mais que o script (ver sem_travas).
  XDG_CONFIG_HOME="$tmp" setsid "$bin" "${args[@]}" "${@:2}" >/dev/null 2>&1 </dev/null 3>&- 4>&- 9>&- &
  echo "Abrindo '$app' com a aparência original (configuração temporária em $tmp)."
}

# "cyberkde papel": escolhe a imagem própria (fica em ~/.config/cyberkde/papel-de-parede). Só grava a
# escolha; quem aplica é o "on", como na cor.
# --json (sem imagem): {"papel":"/caminho"|null}, para o painel.
cmd_papel() {
  local file="$config/cyberkde/papel-de-parede" img=${1:-}
  if [[ $img == --json ]]; then
    if [[ -s $file ]]; then printf '{"papel":%s}\n' "$(json_str "$(<"$file")")"; else echo '{"papel":null}'; fi
    return
  fi
  if [[ -z $img ]]; then
    if [[ -s $file ]]; then echo "Papel de parede: $(<"$file")"; else echo "Papel de parede: o do tema (padrão)."; fi
    return
  fi
  if [[ $img == padrao ]]; then
    rm -f -- "$file"
    papel_modo_gravar corp  # o do tema, que acompanha a corporação
    echo "Papel de parede: o do tema."
  else
    [[ -f $img ]] || { echo "Imagem não encontrada: $img" >&2; exit 2; }
    mkdir -p -- "$(dirname -- "$file")"
    readlink -f -- "$img" >"$file"
    papel_modo_gravar fixo  # escolha da pessoa: a corporação não sobrescreve
    echo "Papel de parede: $(<"$file")"
  fi
  if tema_ligado; then
    echo "Para aplicar agora: cyberkde on papeis-de-parede"
  fi
}

# "cyberkde checar": pré-requisitos e problemas conhecidos, antes de instalar ou ligar. Só leitura.
# Cada item diz o que fazer. Saída: 0 tudo certo (ou só avisos) · 1 algo impede · 2 algo deve ser
# corrigido antes (o instalar.sh para, a não ser com --continuar).
# --json: uma linha {"itens":[{"nivel":"impede|corrigir|aviso","texto","correcao":[...]}],
# "resultado":"ok|corrigir|impede"}, com os mesmos códigos; o texto de sempre vai para o stderr.
cmd_checar() {
  local impede=0 corrigir=0 json=0 itens=""
  case ${1:-} in
    --json) json=1 ;;
    "") ;;
    *) echo "uso: cyberkde checar [--json]" >&2; exit 2 ;;
  esac
  if (( json )); then exec 3>&1 1>&2; fi
  item() {  # nível texto-pt texto-en [correção...]
    local nivel=$1 txt en=$3
    txt=$(t "$2" "$3")
    shift 3
    if (( json )); then
      local cs="" c
      for c in "$@"; do cs+="${cs:+,}$(json_str "$c")"; done
      itens+="${itens:+,}{\"nivel\":\"$nivel\",\"texto\":$(json_str "$txt"),\"correcao\":[$cs],\"texto_en\":$(json_str "$en")}"
    fi
    case $nivel in
      impede) impede=1; printf '  ✗ %s\n' "$txt" ;;
      corrigir) corrigir=1; printf '  ! %s\n' "$txt" ;;
      aviso) printf '  · %s\n' "$txt" ;;
    esac
    local c
    for c in "$@"; do printf '      %s\n' "$c"; done
  }
  tem() { local c; for c in "$@"; do command -v "$c" >/dev/null 2>&1 && return 0; done; return 1; }
  echo "$(t "Conferindo pré-requisitos e problemas conhecidos…" "Checking requirements and known problems…")"

  if (( EUID == 0 )); then
    item impede "Rodando como root. O tema é por usuário: rode sem sudo (quando precisar, o cyberkde pede a senha)." "Running as root. The theme is per user: run it without sudo (cyberkde asks for the password when it needs to)."
  fi
  local -a faltam=()
  tem kwriteconfig6 || faltam+=("kwriteconfig6 (KDE Plasma 6)")
  tem kreadconfig6 || faltam+=("kreadconfig6 (KDE Plasma 6)")
  tem qdbus6 || faltam+=("qdbus6 (qdbus-qt6)")
  tem python3 || faltam+=(python3)
  tem magick convert || faltam+=("ImageMagick (imagemagick)")
  tem flock || faltam+=("flock (util-linux)")
  tem fc-cache || faltam+=("fc-cache (fontconfig)")
  [[ -d /usr/share/icons/breeze-dark ]] || faltam+=("ícones Breeze (kf6-breeze-icon-theme)")
  if (( ${#faltam[@]} )); then
    item impede "Faltam programas: ${faltam[*]}." "Missing programs: ${faltam[*]}." \
      "Ubuntu/Debian: sudo apt install python3 imagemagick qdbus-qt6 fontconfig util-linux kf6-breeze-icon-theme"
  fi
  local plasma
  # Versão pelo pacote primeiro: fora de uma sessão gráfica (TTY, env -i) o "plasmashell --version"
  # aborta por não achar tela (e gera core dump), o que com pipefail derrubava o checar inteiro.
  plasma=$(dpkg-query -W -f='${Version}' plasma-workspace 2>/dev/null | sed 's/^[0-9]*://; s/[^0-9.].*//' || true)
  if [[ -z $plasma && -n ${WAYLAND_DISPLAY:-${DISPLAY:-}} ]]; then
    plasma=$( { QT_QPA_PLATFORM=offscreen plasmashell --version 2>/dev/null || true; } | awk '{print $2}')
  fi
  if [[ -z $plasma ]]; then
    item impede "KDE Plasma não encontrado. O CyberKDE é um tema do Plasma 6." "KDE Plasma not found. CyberKDE is a Plasma 6 theme." \
      "$(t "Ubuntu: sudo apt install kde-plasma-desktop (e escolha a sessão Plasma no login)" "Ubuntu: sudo apt install kde-plasma-desktop (and pick the Plasma session at login)")"
  elif [[ ${plasma%%.*} != 6 ]]; then
    item impede "Plasma $plasma: o CyberKDE precisa do Plasma 6." "Plasma $plasma: CyberKDE needs Plasma 6."
  fi

  local painel_falta
  painel_falta=$(painel_deps_faltando | tr '\n' ' ')
  if [[ -n ${painel_falta// /} ]]; then
    item aviso "Faltam pacotes do painel gráfico (cyberkde painel): ${painel_falta% }. O tema funciona sem ele." \
      "Missing packages for the graphical panel (cyberkde painel): ${painel_falta% }. The theme works without it." \
      "Ubuntu/Debian: sudo apt install ${painel_falta% }"
  fi
  if ! kvantum_ok; then
    item corrigir "Kvantum para Qt 6 não instalado: sem ele os apps ficam sem as formas chanfradas das capturas." "Kvantum for Qt 6 is not installed: without it the apps lack the chamfered shapes from the screenshots." \
      "Ubuntu/Debian: sudo apt install qt-style-kvantum    Fedora: sudo dnf install kvantum    Arch: sudo pacman -S kvantum"
  fi

  # SDDM sem X: no Ubuntu 26.04 não há mais Xorg, e o SDDM só abre em Wayland se for configurado
  # (sem isso a tela de login fica preta depois de reiniciar).
  local dm=""
  dm=$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null || true)
  if [[ ${dm##*/} == sddm.service ]]; then
    if ! tem Xorg X && [[ ! -x /usr/lib/xorg/Xorg ]] &&
      ! grep -qs '^[[:space:]]*DisplayServer[[:space:]]*=[[:space:]]*wayland' /etc/sddm.conf /etc/sddm.conf.d/*.conf /usr/lib/sddm/sddm.conf.d/*.conf; then
      item corrigir "O SDDM está configurado para X11, mas o sistema não tem Xorg: a tela de login fica preta depois de reiniciar (problema do sistema, não do tema)." "SDDM is set up for X11, but the system has no Xorg: the login screen goes black after a reboot (a system problem, not the theme's)." \
        "$(t "Crie /etc/sddm.conf.d/10-wayland.conf com:" "Create /etc/sddm.conf.d/10-wayland.conf with:")" \
        "  [General]" "  DisplayServer=wayland" "  GreeterEnvironment=QT_WAYLAND_SHELL_INTEGRATION=layer-shell" \
        "  [Wayland]" "  CompositorCommand=kwin_wayland --drm --no-lockscreen --no-global-shortcuts --locale1"
    fi
  elif [[ -n $dm ]]; then
    item aviso "A tela de login é o ${dm##*/}, não o SDDM: ela fica como está (o resto do tema funciona)." "The login screen is ${dm##*/}, not SDDM: it stays as it is (the rest of the theme works)."
  fi

  if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} ]] || ! qdbus6 org.kde.KWin /KWin >/dev/null 2>&1; then
    item aviso "Fora de uma sessão Plasma (sem KWin no D-Bus): dá para instalar, mas ligue o tema de dentro da sessão." "Outside a Plasma session (no KWin on D-Bus): you can install, but turn the theme on from inside the session."
  else
    local info
    info=$(qdbus6 org.kde.KWin /KWin supportInformation 2>/dev/null || true)
    if grep -qiE 'OpenGL renderer string: .*(llvmpipe|softpipe|software)' <<<"$info"; then
      item aviso "Vídeo por software (llvmpipe): o KWin desliga as animações, inclusive as do tema." "Software rendering (llvmpipe): KWin turns off all animations, the theme's included." \
        "$(t "Numa máquina virtual, ligue a aceleração 3D (VirtualBox: Tela → Habilitar aceleração 3D)." "In a virtual machine, turn on 3D acceleration (VirtualBox: Display → Enable 3D Acceleration).")"
    fi
    if [[ ${XDG_SESSION_TYPE:-} != wayland ]]; then
      item aviso "Sessão X11: o Latte Dock NG só funciona no Wayland; a dock fica a do Plasma." "X11 session: Latte Dock NG only works on Wayland; the dock stays a Plasma panel."
    fi
  fi

  if [[ -z $(latte_instalado) ]]; then
    if [[ -n $(latte_deb) ]]; then
      item aviso "Latte Dock não instalado: a dock é um painel do Plasma. Para a dock das capturas:" "Latte Dock is not installed: the dock is a Plasma panel. For the dock in the screenshots:" \
        "$(t "cyberkde latte (pacote revisado; pede a senha)" "cyberkde latte (reviewed package; asks for the password)")"
    else
      item aviso "$latte_fora_da_lista" "$latte_fora_da_lista_en"
    fi
  fi
  if [[ -n $(apps_deb dolphin)$(apps_deb konsole) ]] && ! dpkg-query -W cyberkde-dolphin >/dev/null 2>&1; then
    item aviso "Dolphin e Konsole animados (cascata e texto animado) disponíveis:" "Animated Dolphin and Konsole (cascade and animated text) are available:" "$(t "cyberkde animados (pacotes revisados; pede a senha)" "cyberkde animados (reviewed packages; asks for the password)")"
  fi
  if layout_tema && ! fc-list 2>/dev/null | grep -qi 'Andale Mono'; then
    item aviso "Fonte Andale Mono (relógio da barra) não instalada: o relógio usa uma fonte parecida." "Andale Mono font (bar clock) is not installed: the clock uses a similar font." \
      "Ubuntu/Debian: sudo apt install ttf-mscorefonts-installer"
  fi
  local app
  for app in dolphin konsole; do
    tem "$app" || item aviso "$app não instalado: a parte do tema dele fica sem efeito (Ubuntu: sudo apt install $app)." "$app is not installed: its part of the theme has no effect (Ubuntu: sudo apt install $app)."
  done
  if applekde_ligado; then
    item aviso "AppleKDE ligado: o 'cyberkde on' roda 'applekde off' antes (os dois temas não se misturam)." "AppleKDE is on: 'cyberkde on' runs 'applekde off' first (the two themes never mix)."
  fi
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) item aviso "$HOME/.local/bin não está no PATH: o comando 'cyberkde' só funciona depois de sair e entrar na sessão." "$HOME/.local/bin is not in PATH: the 'cyberkde' command only works after logging out and back in." \
         "$(t "Neste terminal: export PATH=\"\$HOME/.local/bin:\$PATH\"" "In this terminal: export PATH=\"\$HOME/.local/bin:\$PATH\"")" ;;
  esac

  if (( json )); then
    printf '{"itens":[%s],"resultado":"%s"}\n' "$itens" \
      "$( ((impede)) && echo impede || { ((corrigir)) && echo corrigir || echo ok; })" >&3
  fi
  if (( impede )); then
    echo "$(t "Resolva os itens marcados com ✗ e rode de novo." "Fix the items marked ✗ and run again.")"
    return 1
  elif (( corrigir )); then
    echo "$(t "Corrija os itens marcados com ! antes de seguir (ou siga assim mesmo, sabendo o que fica diferente)." "Fix the items marked ! before going on (or go on anyway, knowing what will differ).")"
    return 2
  fi
  echo "$(t "Tudo certo." "All good.")"
}

# "cyberkde latte": instala o Latte Dock NG (a dock das capturas) do fork revisado
# github.com/jrcn1991/latte-dock-ng (commit 285257f), SÓ por pacote pronto e SÓ nos ambientes
# validados (latte_debs): o .deb da release do fork (gerado pelo CI a partir do commit revisado), com o
# SHA-256 FIXO aqui no código (não o SHA256SUMS da release: o GitHub troca "~" por "." no nome do
# arquivo). Nada é compilado na máquina de quem instala. Fora da lista, ou se o download, o hash ou o
# apt falharem, o Latte fica de fora e a dock é o painel do Plasma.
# Para atualizar: trocar latte_release e os hashes por outra versão revisada.
latte_release="https://github.com/jrcn1991/latte-dock-ng/releases/download/v1.2.51%2Bcyberkde2"
latte_pacote_versao="1.2.51+cyberkde2-1+ubuntu26.04"  # para atualizar quem tem um pacote anterior
# Lista fechada: o Latte só entra em ambientes VALIDADOS de ponta a ponta numa VM limpa (instalação
# pelo .deb, dock com os lançadores, autostart, off/on e uninstall). Fora dela o tema nem oferece.
# Para entrar uma distribuição nova, ela passa pelo mesmo roteiro de validação.
#   ambiente  arquivo-da-release  sha256
latte_debs=(
  "ubuntu26.04 latte-dock-ng_1.2.51%2Bcyberkde2-1%2Bubuntu26.04_amd64.deb 3064f5fdf53de02583daf831c3b6779fdecfe14e96426199eb5c5a40d0f5076d"
)
# Pacotes que existem na release mas NÃO foram validados (não são usados):
#   debian13        latte-dock-ng_1.2.51%2Bcyberkde2-1%2Bdeb13u1_amd64.deb  a42efdd8be90eb283b24108cb2b0a4704c3e9c3d187636af6b1c6ca0ea7376c1
#   debian-testing  latte-dock-ng_1.2.51%2Bcyberkde2-1_amd64.deb            faa2bb827f8d1a53b6f61a7ef84d336fce90f895e30e23a6711dc8d6d8f63058
latte_fora_da_lista="Latte Dock: disponível só no Ubuntu 26.04 (validado); usando a dock do Plasma."
latte_fora_da_lista_en="Latte Dock: available only on Ubuntu 26.04 (validated); using the Plasma dock."

# Pacote .deb validado para este sistema: "arquivo sha256", ou nada. Ubuntu 26.04 = ID ubuntu,
# VERSION_ID 26.04, amd64, apt, Plasma 6.6 e libplasma7 (o que foi validado).
latte_deb() {
  command -v apt-get >/dev/null && [[ $(dpkg --print-architecture 2>/dev/null) == amd64 ]] || return 0
  local id="" ver="" alvo="" linha plasma
  # shellcheck disable=SC1091
  id=$(. /etc/os-release 2>/dev/null; echo "${ID:-}")
  ver=$(. /etc/os-release 2>/dev/null; echo "${VERSION_ID:-}")
  # Mesma leitura do cmd_checar (que chama esta função): sem tela, o plasmashell aborta.
  plasma=$(dpkg-query -W -f='${Version}' plasma-workspace 2>/dev/null | sed 's/^[0-9]*://; s/[^0-9.].*//' || true)
  if [[ -z $plasma && -n ${WAYLAND_DISPLAY:-${DISPLAY:-}} ]]; then
    plasma=$( { QT_QPA_PLATFORM=offscreen plasmashell --version 2>/dev/null || true; } | awk '{print $2}')
  fi
  if [[ $id:$ver == ubuntu:26.04 && $plasma == 6.6* ]] &&
    dpkg-query -W -f='${Status}' libplasma7 2>/dev/null | grep -q 'ok installed'; then
    alvo=ubuntu26.04
  fi
  [[ -n $alvo ]] || return 0
  for linha in "${latte_debs[@]}"; do
    if [[ ${linha%% *} == "$alvo" ]]; then echo "${linha#* }"; fi
  done
}

# Baixa o .deb, confere o SHA-256 fixo e instala pelo apt (que resolve as dependências). 0 = instalado.
# Baixa um .deb, confere o SHA-256 fixado no código e instala pelo apt (que resolve as dependências).
# Nada é compilado. 0 = instalado.
instalar_deb_conferido() {  # url sha256 descrição
  local url=$1 sha=$2 desc=$3 tmp
  tmp=$(mktemp -d)
  chmod 755 "$tmp"  # o apt lê o arquivo como o usuário _apt
  echo "Baixando o pacote $desc…"
  if ! python3 -c '
import hashlib, sys, urllib.request
url, dst, sha = sys.argv[1:]
with urllib.request.urlopen(url, timeout=120) as r:
    data = r.read()
if hashlib.sha256(data).hexdigest() != sha:
    sys.exit("o pacote baixado não confere com o SHA-256 revisado; nada foi instalado")
open(dst, "wb").write(data)
' "$url" "$tmp/pacote.deb" "$sha"; then
    rm -rf -- "$tmp"
    return 1
  fi
  chmod 644 "$tmp/pacote.deb"
  echo "Instalando $desc (pede a senha)…"
  if ! sem_travas sudo ${SUDO_ASKPASS:+-A} apt-get install -y "$tmp/pacote.deb"; then
    rm -rf -- "$tmp"
    return 1
  fi
  rm -rf -- "$tmp"
}

latte_instalar_deb() {
  local deb
  deb=$(latte_deb)
  [[ -n $deb ]] || return 1
  instalar_deb_conferido "$latte_release/${deb%% *}" "${deb#* }" "do Latte" || return 1
  mkdir -p -- "$project/latte/build"
  # Sem configuração do Latte antes: a que surgir é do tema, e o uninstall a apaga.
  if [[ ! -e $config/latte && ! -e $project/latte/build/.config-latte-preexistente ]]; then
    : >"$project/latte/build/.config-latte-do-tema"
  elif [[ ! -e $project/latte/build/.config-latte-do-tema ]]; then
    : >"$project/latte/build/.config-latte-preexistente"
  fi
  echo deb >"$project/latte/build/.instalado-por"  # o uninstall remove o pacote
  echo "Latte Dock NG instalado pelo pacote revisado."
}

# "cyberkde animados": Dolphin (cascata ao abrir pastas) e Konsole (texto e cursor animados) com o
# patch do tema, por pacote pronto: gerados pelo workflow .github/workflows/apps.yml na imagem do
# Ubuntu 26.04, a partir da mesma versão que o Ubuntu distribui, e conferidos pelo SHA-256 fixado aqui.
# Só no Ubuntu 26.04 e só se a versão do app do sistema for a do pacote; senão, fica o app do sistema.
# Para atualizar (patch novo ou Ubuntu com Dolphin/Konsole novos): rodar o workflow e trocar abaixo.
# Cada linha tem a SUA release: um app pode subir de revisão (patch novo) sem o outro.
#   app  versão-do-sistema  tag-da-release  arquivo-da-release  sha256
# Para cada app e versão vale a PRIMEIRA linha com SHA-256 de verdade (64 hexadecimais); uma linha com
# "PENDENTE-CI" no lugar do SHA é pulada, e a de baixo continua valendo.
# A revisão do pacote (-cyberkdeN) vem de <app>/REVISAO (scripts/empacotar-apps.sh).
apps_releases="https://github.com/jrcn1991/theme-cyberkde/releases/download"
apps_debs=(
  # Konsole -cyberkde2 (cascata e efeitos do terminal), release apps-25.12.3-2:
  "konsole 25.12.3 apps-25.12.3-2 cyberkde-konsole_25.12.3-cyberkde2_amd64.deb 1ccbe77f4c438a8833c54f5c6c46f197072d332f59346d7e9be390ad1151f6fc"
  # Release apps-25.12.3-1 (Dolphin atual; Konsole -cyberkde1 fica de reserva):
  "dolphin 25.12.3 apps-25.12.3-1 cyberkde-dolphin_25.12.3-cyberkde1_amd64.deb f910d46d0bb216ecb10742eb7664b742e43f1a0f2b3dca5a69f324780fd91563"
  "konsole 25.12.3 apps-25.12.3-1 cyberkde-konsole_25.12.3-cyberkde1_amd64.deb 65ecb4ef2b7c92b1b665243ca04e48d67389c1158437c28f52d3ab3799eab663"
)
apps_pacotes="$state/pacotes-do-tema"  # pacotes que o tema instalou (o uninstall os remove)

# Pacote validado para o app neste sistema: "url sha256", ou nada.
apps_deb() {  # app
  command -v apt-get >/dev/null && [[ $(dpkg --print-architecture 2>/dev/null) == amd64 ]] || return 0
  local id ver sistema linha a v tag f h
  # shellcheck disable=SC1091
  id=$(. /etc/os-release 2>/dev/null; echo "${ID:-}")
  ver=$(. /etc/os-release 2>/dev/null; echo "${VERSION_ID:-}")
  [[ $id:$ver == ubuntu:26.04 ]] || return 0
  [[ -x /usr/bin/$1 ]] || return 0
  sistema=$(app_versao_sistema "$1")
  for linha in "${apps_debs[@]}"; do
    read -r a v tag f h <<<"$linha"
    if [[ $a == "$1" && $v == "$sistema" && $h =~ ^[0-9a-f]{64}$ ]]; then echo "$apps_releases/$tag/$f $h"; return 0; fi
  done
}

# Versão do pacote ("25.12.3-cyberkde2") a partir do nome do arquivo na URL.
apps_deb_versao() { local f=${1%% *}; f=${f##*/}; f=${f#*_}; printf '%s\n' "${f%_*}"; }

cmd_animados() {
  if [[ ${1:-} == --disponivel ]]; then [[ -n $(apps_deb dolphin)$(apps_deb konsole) ]]; return; fi
  local app deb algum=0 fase instalada
  for app in dolphin konsole; do
    deb=$(apps_deb "$app")
    instalada=""
    if dpkg-query -W -f='${Status}' "cyberkde-$app" 2>/dev/null | grep -q 'ok installed'; then
      instalada=$(dpkg-query -W -f='${Version}' "cyberkde-$app" 2>/dev/null || true)
    fi
    # Pacote do tema já instalado: só troca se o revisado for MAIS NOVO (patch novo, -cyberkde2…). Antes
    # o "animados" parava em "já instalado", e quem tinha o pacote antigo nunca recebia o novo.
    if [[ -n $instalada ]]; then
      if [[ -n $deb ]] && dpkg --compare-versions "$instalada" lt "$(apps_deb_versao "$deb")"; then
        echo "Atualizando o $app animado: $instalada → $(apps_deb_versao "$deb")."
      else
        echo "$app animado já instalado ($instalada)."
        algum=1
        continue
      fi
    fi
    if [[ -z $deb ]]; then
      echo "$app animado: disponível só no Ubuntu 26.04 com o $app $(apps_versoes "$app") (validado); fica o $app do sistema."
      continue
    fi
    if instalar_deb_conferido "${deb%% *}" "${deb#* }" "do $app animado"; then
      mkdir -p -- "$state"
      grep -qx "cyberkde-$app" "$apps_pacotes" 2>/dev/null || echo "cyberkde-$app" >>"$apps_pacotes"
      echo "$app animado instalado."
      algum=1
    else
      echo "O $app animado não foi instalado; fica o $app do sistema." >&2
    fi
  done
  (( algum )) || return 1
  if tema_ligado; then
    for fase in carregamento konsole-anim; do "$project/scripts/cyberkde" on "$fase" || true; done
  fi
}
apps_versoes() {  # app -> versões com pacote
  local linha a v r=()
  for linha in "${apps_debs[@]}"; do read -r a v _ <<<"$linha"; [[ $a == "$1" && " ${r[*]} " != *" $v "* ]] && r+=("$v"); done
  local IFS=/
  echo "${r[*]}"
}

# Remove os pacotes que o tema instalou (Dolphin/Konsole animados).
apps_desinstalar() {
  [[ -s $apps_pacotes ]] || return 0
  local -a pk
  mapfile -t pk <"$apps_pacotes"
  echo "Removendo os pacotes que o tema instalou: ${pk[*]} (pede a senha)…"
  sem_travas sudo ${SUDO_ASKPASS:+-A} apt-get remove -y "${pk[@]}" ||
    echo "Não consegui remover; rode: sudo apt remove ${pk[*]}" >&2
}

cmd_latte() {
  # --disponivel: só responde se há pacote revisado para este sistema (para o instalar.sh perguntar).
  if [[ ${1:-} == --disponivel ]]; then [[ -n $(latte_deb) ]]; return; fi
  local bin
  bin=$(latte_instalado)
  if [[ -n $bin ]]; then
    # Pacote instalado pelo tema, de uma versão anterior: atualiza para a revisada atual.
    if [[ $(cat "$project/latte/build/.instalado-por" 2>/dev/null) == deb && -n $(latte_deb) &&
      $(dpkg-query -W -f='${Version}' latte-dock-ng 2>/dev/null) != "$latte_pacote_versao" ]]; then
      echo "Atualizando o Latte Dock para $latte_pacote_versao."
      latte_instalar_deb || { echo "Não consegui atualizar o Latte; fica a versão instalada." >&2; return 1; }
    else
      echo "Latte Dock já instalado: $bin."
    fi
    latte_aplicar_se_ligado
    return 0
  fi
  if [[ ${XDG_SESSION_TYPE:-wayland} != wayland ]]; then
    echo "O Latte Dock NG só funciona no Wayland; a dock fica o painel do Plasma."
    return 1
  fi
  if [[ -z $(latte_deb) ]]; then
    echo "$latte_fora_da_lista"
    return 1
  fi
  if ! latte_instalar_deb; then
    echo "O Latte não foi instalado; a dock fica o painel do Plasma." >&2
    return 1
  fi
  latte_aplicar_se_ligado
}

# Remove o Latte que o "cyberkde latte" instalou (o pacote). Um Latte que não veio daqui fica.
latte_desinstalar() {
  [[ $(cat "$project/latte/build/.instalado-por" 2>/dev/null) == deb ]] || return 0
  # Só o Latte do pacote (/usr/bin), e só porque foi o tema que o instalou.
  local pid
  for pid in $(pgrep -x latte-dock-ng || true); do
    [[ $(readlink -f "/proc/$pid/exe" 2>/dev/null) == /usr/bin/latte-dock-ng ]] && kill "$pid" 2>/dev/null
  done
  echo "Removendo o pacote do Latte que o tema instalou (pede a senha)…"
  sem_travas sudo ${SUDO_ASKPASS:+-A} apt-get remove -y latte-dock-ng ||
    echo "Não consegui remover o pacote; rode: sudo apt remove latte-dock-ng" >&2
  # O Latte cria esta pasta ao rodar (knscompat); não pertence ao pacote.
  rm -rf -- "$data/latte-dock-ng"
  if [[ -e $project/latte/build/.config-latte-do-tema ]]; then
    rm -rf -- "$config/latte"  # não existia antes do tema instalar o Latte
  elif [[ -d $config/latte ]]; then
    echo "Os layouts do Latte ficaram em $config/latte (apague a pasta se não for mais usar o Latte)."
  fi
}

# Tema ligado com o arranjo das capturas: troca a dock do Plasma pelo Latte na hora.
latte_aplicar_se_ligado() {
  if tema_ligado && layout_tema; then
    "$project/scripts/cyberkde" on barra-e-dock
  fi
}

# "cyberkde layout [tema|duas-telas|compacto|lateral|manter] [--aplicar] [--json]": arranjo da barra e
# da dock (presets em modules/barra-e-dock/phase.sh). Sem --aplicar, só grava a escolha (como antes);
# com --aplicar e o tema ligado, remonta a barra e a dock na hora (off e on da fase barra-e-dock).
cmd_layout() {
  local v="" aplicar=0 arg
  for arg in "$@"; do
    case $arg in
      --aplicar) aplicar=1 ;;
      --json) cor_json=1 ;;
      *) v=$arg ;;
    esac
  done
  if (( cor_json )); then exec 3>&1 1>&2; else exec 3>&1; fi
  if [[ -z $v ]]; then
    if (( cor_json )); then efeito_cmd_layout; return; fi
    echo "Layout: $(layout_preset) (${layout_nomes[$(layout_preset)]}: ${layout_desc[$(layout_preset)]})"
    return
  fi
  [[ " ${layout_presets[*]} " == *" $v "* || $v == manter ]] ||
    cor_exit 2 "$(t "uso: cyberkde layout [tema|duas-telas|compacto|lateral|manter] [--aplicar] [--json]" "usage: cyberkde layout [tema|duas-telas|compacto|lateral|manter] [--aplicar] [--json]")"
  if (( aplicar )); then layout_trocar "$v"; return; fi
  mkdir -p -- "$(dirname -- "$layout_file")"
  echo "$v" >"$layout_file"
  echo "Layout: $v."
  if tema_ligado; then
    echo "Para aplicar agora: cyberkde layout $v --aplicar"
  fi
}

cmd_uninstall() {
  cmd_off || { echo "Reversão incompleta; não vou remover os arquivos instalados." >&2; exit 1; }
  latte_desinstalar
  apps_desinstalar
  rm -rf "$config/Kvantum/CyberKDE" "$data/fonts/CyberKDE" \
    "$data/aurorae/themes/CyberKDE" "$data/kwin/effects/cyberkde_scan" \
    "$HOME/.local/opt/cyberkde-dolphin" "$HOME/.local/opt/cyberkde-konsole" \
    "$data/icons/CyberKDE" "$data/konsole/CyberKDE.colorscheme" "$data/konsole/CyberKDE.profile" \
    "$data/wallpapers/CyberKDE" "$data/cyberkde" "$data/plasma/look-and-feel/org.cyberkde.desktop" \
    "$data/plasma/desktoptheme/CyberKDE" "$data/kwin/effects/cyberkde_popups" "$data/kwin/effects/cyberkde_barra"
  rm -f "$data/color-schemes/CyberKDE.colors" "$data/kwin/effects/.cyberkde_"*
  # Ícones do menu (gen_menu.py) no hicolor do usuário, que pode ter ícones de outros programas: só os
  # do tema, e só as pastas de tamanho que ele cria, se ficarem vazias.
  rm -f "$data/icons/hicolor/"*/apps/cyberkde-menu-* "$data/icons/hicolor/"*/apps/cyberkde-painel-*
  local tam
  for tam in scalable 16x16 22x22 24x24 32x32 48x48 64x64 96x96 128x128 256x256; do
    rmdir -- "$data/icons/hicolor/$tam/apps" "$data/icons/hicolor/$tam" 2>/dev/null || true
  done
  rmdir -- "$data/icons/hicolor" 2>/dev/null || true
  rm -f "${XDG_CACHE_HOME:-$HOME/.cache}"/plasma_theme_CyberKDE*.kcache
  # Preferências (cor, corporação, papel de parede), cache dos ícones recoloridos e o estado (o
  # registro já foi esvaziado pelo off; a trava pode sumir com o arquivo aberto). Os logos de
  # corporação da usuária (~/.config/cyberkde/corporacoes) ficam: são dela, não do tema.
  if [[ -d $config/cyberkde ]]; then
    find "$config/cyberkde" -mindepth 1 -maxdepth 1 ! -name corporacoes -exec rm -rf -- {} +
    rmdir -- "$config/cyberkde" 2>/dev/null || echo "Seus logos de corporação ficaram em $corp_logos_usuario."
  fi
  rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/cyberkde" "$state"
  # Lançador do painel, instalado pelo instalar.sh fora do registro (ver lá).
  rm -f -- "$data/applications/cyberkde-painel.desktop"
  # Pastas que só existiam por causa do tema.
  local d
  for d in "$data/aurorae/themes" "$data/aurorae" "$data/kwin/effects" "$data/kwin" \
    "$data/plasma/desktoptheme" "$data/plasma/look-and-feel" "$data/plasma/shells" "$data/plasma/plasmoids" "$data/plasma" "$data/wallpapers" \
    "$data/icons" "$data/konsole" "$data/color-schemes" "$data/fonts" "$config/Kvantum"; do
    rmdir -- "$d" 2>/dev/null || true
  done
  if [[ -d $data/fonts ]]; then fc-cache -f "$data/fonts" >/dev/null; fi
  echo "Arquivos do tema removidos."
  # Cópia feita pelo instalar.sh (tem a marca .instalado): remove também o programa e o comando.
  # Numa pasta de desenvolvimento (sem a marca), o código fica.
  if [[ -e $project/.instalado ]]; then
    local link="$HOME/.local/bin/cyberkde"
    if [[ -L $link && $(readlink -f "$link") == "$project/scripts/cyberkde" ]]; then rm -f -- "$link"; fi
    rm -rf -- "$project"  # o bash já tem este script aberto: apagar o arquivo não interrompe a execução
    echo "Programa removido de $project."
  fi
}

# --lang en (ou --idioma en), em qualquer posição: idioma das mensagens para o painel (ver t()).
args=()
while (( $# )); do
  case $1 in
    --lang | --idioma) cyberkde_lang=${2:-pt}; shift 2 || shift ;;
    --lang=* | --idioma=*) cyberkde_lang=${1#*=}; shift ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]}"
unset args

case "${1:-status}" in
  on) cmd_on "${@:2}" ;;  # trava por conta própria (precisa responder "ocupado" em JSON)
  off) cmd_off_fase "${@:2}" ;;  # sem fase: o "off" completo de sempre (trava lá dentro)
  fases) cmd_fases "${@:2}" ;;
  corp) cmd_corp "${@:2}" ;;  # trava pelo cmd_cor (a leitura e a lista não travam)
  painel) cmd_painel "${@:2}" ;;
  efeito) cmd_efeito "${@:2}" ;;  # trava só ao gravar
  # Saída fechada (ex.: "| head") com o SIGPIPE ignorado por quem chamou: sem "erro de escrita".
  status) cmd_status "${@:2}" 2> >(grep -v -E 'erro de escrita|write error' >&2 || true) ;;
  padrao) cmd_padrao "${@:2}" ;;
  papel) cmd_papel "${@:2}" ;;
  cor) shift; cmd_cor "$@" ;;  # trava por conta própria (a leitura da cor não trava)
  dolphin-build) take_lock || busy; build_patched dolphin system/dolphin ;;
  konsole-build) take_lock || busy; build_patched konsole utilities/konsole ;;
  install) take_lock || busy; install_files; painel_icone_atualizar ;;
  checar) cmd_checar "${@:2}" ;;
  latte) cmd_latte "${@:2}" ;;
  animados) cmd_animados "${@:2}" ;;
  layout) cmd_layout "${@:2}" ;;
  uninstall) take_lock || busy; cmd_uninstall ;;
  -h | --help | help | ajuda) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
