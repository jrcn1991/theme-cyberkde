#!/usr/bin/env bash
# cyberkde — aplica e reverte o tema CyberKDE por fases.
#
#   cyberkde on          liga TUDO (todas as fases, inclusive as dos módulos)
#   cyberkde on [fase] [--sem-sudo] [--json] [--progresso]
#                        aplica uma fase: dolphin, janelas (moldura + animações)
#                        carregamento (Dolphin compilado com cascata de itens), icones,
#                        konsole (tema do terminal) ou konsole-anim (Konsole compilado com animações)
#   cyberkde animados    instala o Dolphin (cascata) e o Konsole (animações) com o patch, por pacote
#                        revisado (Ubuntu 26.04); depois: cyberkde on carregamento / konsole-anim
#   cyberkde dolphin-build / konsole-build  (desenvolvimento) compila os mesmos apps nesta máquina
#   cyberkde off         devolve todas as chaves alteradas aos valores originais
#   cyberkde off <fase> [--sem-sudo] [--json] [--progresso]
#                        desliga só uma fase; chave que outra fase ligada também usa fica como está
#   cyberkde fases [--json]  lista as fases (na ordem do "on") e quais estão ligadas
#   cyberkde corp [id|--lista] [--json] [--sem-sudo] [--progresso]
#                        corporação: paleta, ícone do menu e logo da abertura (tokens/corporacoes.json;
#                        'nenhuma' = paleta do tema). Também: off --json/--progresso, checar --json, papel --json
#   cyberkde painel      abre o painel gráfico (liga e desliga as fases, escolhe a corporação)
#                        (--checar: só confere os pacotes do painel e diz a linha do apt)
#   cyberkde efeito --lista [--json]  todos os efeitos configuráveis: grupo, opções, estado e o "comando"
#   cyberkde efeito <id> [opções] [--json]  escolhe uma opção (sem opções, mostra o estado). Famílias:
#     janelas                animação de abrir e fechar: --abrir, --fechar, --primeira-vez, durações,
#                            --intensidade (--lista: as variantes e as prévias)
#     konsole-cascata, konsole-{chuva,grade,crt,varredura,hud,faiscas,erro,campainha}
#                            efeitos do Konsole animado: on|off e parâmetros (desligados por padrão)
#     estilo-*               estilos da interface (seleção, brilho, corte, abas, foco, presets...): --variante V
#     cursor <padrao|neon|minimo|mira>   cursor do tema (liga com: cyberkde on cursor)
#     som <padrao|discreto>  sons do tema
#     papel <a|b|c|d|padrao> papel de parede do tema       icones [padrao|alt|<grupo>=<padrao|alt>]
#     movimento <completo|reduzido|minimo>   nível de animação de tudo (KDE e efeitos do tema)
#     menu <padrao|lista|grade|tela-cheia>   menu iniciar
#     layout <tema|duas-telas|compacto|lateral|manter>   arranjo da barra e da dock
#     dock [--indicador linha|ponto] [--zoom on|off] [--lancamento on|off]   (Latte Dock)
#     areas <off|4|6> [--nomes cyber|simples]   áreas de trabalho como módulos
#     modal-escurecer on|off, clique on|off      efeitos do próprio KWin
#     splash <completo|curto|nenhum>, login [--entrada E] [--painel P] [--sucesso on|off] [--fundo F]
#   --lang en            (em qualquer comando) avisos, erros e checar em inglês, para o painel
#   cyberkde status [--json]  mostra o que está aplicado (--json: uma linha para programas)
#   cyberkde cor '#hex'  troca a cor de destaque do tema inteiro ('cyberkde cor padrao' volta ao vermelho)
#                        opções: --sem-sudo (nunca pede senha; login fica pendente) e --json (para programas)
#   cyberkde papel [imagem|padrao]  papel de parede próprio para a área de trabalho e o bloqueio
#                        ('padrao' volta às imagens do tema)
#   cyberkde padrao [app] abre o app (padrão: dolphin) com a aparência original, para comparar
#   cyberkde install     só instala/atualiza os arquivos do tema (cores, Kvantum, fontes)
#   cyberkde checar      confere pré-requisitos e problemas conhecidos (diz como corrigir cada um)
#   cyberkde layout [tema|duas-telas|compacto|lateral|manter] [--aplicar]  arranjo da barra e da dock
#   cyberkde latte       instala o Latte Dock NG (a dock das capturas) pelo pacote revisado (Ubuntu 26.04)
#   cyberkde uninstall   off + remove os arquivos instalados (e o próprio programa, se veio do instalar.sh)
#
# Cada chave alterada tem o valor original registrado em $state/ledger.tsv na
# primeira vez que é gravada; "off" percorre esse registro ao contrário.

set -euo pipefail

project="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
config="${XDG_CONFIG_HOME:-$HOME/.config}"
data="${XDG_DATA_HOME:-$HOME/.local/share}"
state="${XDG_STATE_HOME:-$HOME/.local/state}/cyberkde"
ledger="$state/ledger.tsv"
absent="@@CYBERKDE_ABSENT@@"
# Plugin do Kvantum: o caminho muda com a distribuição (Debian/Ubuntu usam a pasta multiarch).
kvantum_plugin=""
for f in /usr/lib/*/qt6/plugins/styles/libkvantum.so /usr/lib{64,}/qt6/plugins/styles/libkvantum.so; do
  if [[ -e $f ]]; then kvantum_plugin=$f; break; fi
done
unset f
kvantum_ok() { [[ -n $kvantum_plugin ]]; }
files="$state/files.tsv"  # arquivos criados/substituídos: destino<TAB>backup (ou -)
# De qual fase veio cada linha do ledger e do files.tsv. Fica num arquivo À PARTE, e não numa coluna a
# mais: as cópias anteriores do cyberkde leem o ledger com "read -r arquivo grupo chave original", e o
# read cola o resto da linha no último campo — a coluna nova viraria parte do valor original e o
# "off" de uma cópia antiga gravaria lixo na configuração (a ~/.local/opt/cyberkde instalada em 08/10
# lê o mesmo $state que esta). Linhas:
#   c<TAB>arquivo<TAB>grupo<TAB>chave<TAB>fases     (chave do ledger)
#   a<TAB>destino<TAB>fases                          (arquivo do files.tsv)
# "fases" é a lista, separada por vírgula, das fases que gravaram aquilo. "legado" = linha de uma
# versão anterior que nenhuma fase atual regrava; só o "off" completo a devolve.
fases_reg="$state/fases.tsv"
# Presente = toda linha do registro tem fase conhecida (o registro começou do zero com esta versão, ou
# um "on" completo marcou tudo). Sem ela o "off <fase>" não sabe o que é de quem e se recusa.
fases_ok="$state/fases-completo"
fase_atual=""  # a fase que está rodando agora (cmd_on, cmd_cor); set_key e put_file a registram
# Valor que cada fase gravou em cada chave (arquivo<TAB>grupo<TAB>chave<TAB>fase<TAB>valor). Duas fases
# podem gravar a mesma chave com valores diferentes (login e papeis-de-parede: a imagem da tela de
# bloqueio); no "on" completo vale a que roda por último. Com este registro, ligar ou desligar uma
# fase avulsa devolve à chave o valor da última fase ligada, sem rodar a fase de novo.
fases_valores="$state/fases-valores.tsv"

# Apps compilados com patch próprio ficam em ~/.local/opt/cyberkde-<app>, com lançador em ~/.local/bin/<app>.
dolphin_wrapper="$HOME/.local/bin/dolphin"

# Cor de destaque em uso (a mesma que os geradores leem em generator/cyberlib.py).
accent_file="$config/cyberkde/cor"
# A cor PEDIDA é a que fica gravada e a que o "cor" mostra de volta. A APLICADA é a
# mesma, clareada só o bastante para ler sobre o tema (ver _legivel em cyberlib.py): com superfícies
# escuras, uma cor escura como #202030 daria 1,01:1 contra a superfície, ou seja, sumiria.
accent_color() {
  python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from cyberlib import RED_PEDIDO; print(RED_PEDIDO)' "$project/generator"
}
accent_applied() {
  python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from cyberlib import RED; print(RED)' "$project/generator"
}

# Uma execução por vez de tudo que altera o sistema (on, off, cor, install...): quem chega com a
# trava tomada sai na hora com o código 3, sem esperar.
take_lock() {
  mkdir -p "$state"
  exec 9>"$state/cyberkde.lock"
  flock -n 9
}
busy() {
  echo "Outra execução do cyberkde está em andamento; tente de novo daqui a pouco." >&2
  exit 3
}

# Roda um comando SEM o descritor da trava (fd 9). O bash não marca close-on-exec, então todo filho
# herda a trava aberta com "exec 9>". Um filho que sobreviva ao script — o diálogo do askpass
# esperando a senha, um app aberto pelo "padrao" — continuaria segurando a trava depois que o
# cyberkde termina, e a execução seguinte levaria "ocupado" sem ninguém entender por quê.
# Use isto em TUDO que possa viver mais que o script.
# Fecha também os fds 3 e 4 (a saída JSON do --json e a cópia dela): um processo que sobreviva ao
# script e herde o pipe deixa preso quem lê a saída por "$(cyberkde … --json)" (o Halo), porque o
# pipe só fecha quando o último processo com ele aberto termina.
sem_travas() { "$@" 3>&- 4>&- 9>&-; }

# Registro de módulo: alguns módulos guardam o estado num .tsv próprio (papeis-de-parede.tsv), fora
# do ledger e do files.tsv. Sem olhar para eles, o "off" saía em "Nada aplicado" sem rodar os
# OFF_HOOKS e o papel de parede ficava preso no do CyberKDE.
modulo_registro() {
  local f
  for f in "$state"/*.tsv; do
    case ${f##*/} in ledger.tsv | files.tsv | fases.tsv) continue ;; esac
    if [[ -s $f ]]; then return 0; fi
  done
  [[ -e $state/appletsrc.orig ]]  # painéis guardados pela fase barra-e-dock
}

# "cyberkde cor": troca a cor de destaque do tema inteiro. Interface estável para programas que
# chamam o cyberkde (DOCUMENTACAO.md, seção "Interface do cyberkde cor"):
#   cyberkde cor [#RRGGBB|padrao] [--sem-sudo] [--json]
#   saída: 0 aplicado · 1 falha · 2 cor/opção inválida · 3 ocupado · 4 aplicado, com pendências de sudo
cor_json=0
cor_corp=""  # preenchido pelo "corp": a cor aplicada é a da corporação, não uma escolha à mão
cor_exit() {  # código mensagem
  (( BASH_SUBSHELL > 0 )) && exit "$1"  # erro dentro de $(...): quem responde é o processo principal
  trap - ERR
  local msg=$2
  if [[ $cyberkde_lang == en* ]]; then msg=$(erro_en "$2"); fi
  if (( cor_json )); then
    printf '{"erro":%s,"codigo":%d}\n' "$(json_str "$msg")" "$1" >&3
  else
    echo "$msg" >&2
  fi
  exit "$1"
}

# O "erro" dos JSON em inglês (--lang en): as mensagens que o painel mais mostra. As outras (casos
# raros, como os do AppleKDE) seguem em português.
erro_en() {
  case $1 in
    "ocupado: "*) echo "busy: another cyberkde run is in progress" ;;
    "fase desconhecida: "*) echo "unknown part: ${1#fase desconhecida: }" ;;
    "corporação desconhecida: "*) echo "unknown corporation: ${1#corporação desconhecida: }" ;;
    "cor inválida"*) echo "invalid color: use #RRGGBB or padrao" ;;
    "uso: "*) echo "usage: ${1#uso: }" ;;
    "interrompido"*) echo "interrupted: run the same command again to finish" ;;
    "falha ao "*) echo "failed (details on standard error)" ;;
    "o registro do tema é de uma versão anterior"*) echo "the theme record comes from an older version and does not say which part each key belongs to. Run 'cyberkde on' once, then try again. Nothing was turned off." ;;
    *"pela metade"*) echo "only partly done (see the messages above); run the same command again" ;;
    *) echo "$1" ;;
  esac
}
cor_marker="$state/cor-incompleta"
# SIGTERM/SIGINT/SIGHUP no meio da aplicação: garante o painel de pé e sai com o código 5. A trava
# se solta quando o processo e os filhos terminam (mande o sinal ao grupo de processos inteiro).
# A marca de "incompleta" continua lá.
cor_interrupted() {
  trap - TERM INT HUP
  pgrep -x plasmashell >/dev/null || systemctl --user start plasma-plasmashell.service >/dev/null 2>&1 || true
  cor_exit 5 "interrompido: rode o mesmo comando de novo para completar"
}
json_list() { local out="" i; for i in "$@"; do out+="${out:+,}\"$i\""; done; printf '[%s]' "$out"; }
json_list_str() { local out="" i; for i in "$@"; do out+="${out:+,}$(json_str "$i")"; done; printf '[%s]' "$out"; }

# Idioma das mensagens: o painel tem interface em inglês e pede "--lang en" (ou CYBERKDE_LANG=en).
# Vale para os "avisos" e o "erro" dos JSON, o "checar" e as mensagens dos comandos novos; o resto
# do texto do CLI continua em português.
cyberkde_lang=${CYBERKDE_LANG:-pt}
t() { if [[ $cyberkde_lang == en* ]]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }  # pt en

# Comando que completa uma aplicação que ficou pendente de sudo, para a mensagem e para o campo
# "retomar" do JSON (o comando exato; null quando não falta nada). Pelo "corp" é o próprio "corp":
# um "cor '#hex'" à mão viraria corporação "personalizada" e perderia a paleta e o logo.
cor_retomar() {
  if [[ -n $cor_corp ]]; then echo "cyberkde corp $cor_corp"
  elif [[ -s $accent_file ]]; then echo "cyberkde cor '$(accent_color)'"
  else echo "cyberkde cor padrao"; fi
}
retomar_json() {  # comando|"" -> ,"retomar":"..."|null
  if [[ -n ${1:-} ]]; then printf ',"retomar":"%s"' "${1//\"/\\\"}"; else printf ',"retomar":null'; fi
}

# Frases prontas para a tela de quem chama (campo "avisos" do --json). O "pendentesSudo" diz QUAL
# fase ficou pendente; isto diz o que se vê na tela por causa disso. Importa porque a fase "login"
# aplica o splash e a tela de bloqueio mesmo sem root, e só a tela do SDDM fica para trás: dizer só
# "login pendente" faria parecer que nada foi aplicado.
# Sem aspas nem barras invertidas nas frases: o json_list não escapa.
avisos_de() {  # fases pendentes... -> uma frase por linha
  local f
  for f in "$@"; do
    case $f in
      login) t "A tela de login continua com o tema anterior: ela fica em /usr e só muda com root. O splash e a tela de bloqueio já foram aplicados." \
        "The login screen keeps the previous theme: it lives in /usr and only changes as root. The splash and the lock screen were already applied."; echo ;;
    esac
  done
}
accent_is_default() { [[ -s $accent_file ]] && echo false || echo true; }

# "Ligado" = há chave alterada ou arquivo substituído registrado. É a mesma definição que o "cor"
# usa para decidir se reaplica as fases, e a que o "status --json" mostra. Um registro só de
# módulo (ver modulo_registro) não conta como ligado: é reversão pela metade, e o status diz isso
# no campo "reversaoPendente".
tema_ligado() { [[ -s $ledger || -s $files ]]; }

cmd_cor() {
  local value="" arg bad=0 secundaria=""
  while (( $# )); do
    arg=$1; shift
    case $arg in
      --json) cor_json=1 ;;
      --sem-sudo) CYBERKDE_SEM_SUDO=1 ;;
      --progresso) cor_progresso=1 ;;
      # Cor personalizada com secundária própria (no lugar do ciano); a alerta e o fundo ficam os do tema.
      --secundaria) secundaria=${1:-}; shift || true; [[ $secundaria =~ ^#?[0-9A-Fa-f]{6}$ ]] || bad=1 ;;
      *) if [[ -z $value && $arg != -* ]]; then value=$arg; else bad=1; fi ;;
    esac
  done
  # --json: a saída padrão fica só com a linha JSON; as mensagens vão para a saída de erro.
  if (( cor_json )); then exec 3>&1 1>&2; else exec 3>&1; fi
  (( bad == 0 )) || cor_exit 2 "uso: cyberkde cor [#RRGGBB|padrao] [--secundaria #RRGGBB] [--sem-sudo] [--json] [--progresso]"
  if [[ -n $secundaria && ( -z $value || $value == padrao || -n $cor_corp ) ]]; then
    cor_exit 2 "uso: --secundaria vale junto com uma cor: cyberkde cor '#RRGGBB' --secundaria '#RRGGBB'"
  fi
  if [[ -z $value ]]; then  # só leitura: não trava nem regenera nada
    local current aplicada ligado=false
    current=$(accent_color)
    aplicada=$(accent_applied)
    if tema_ligado; then ligado=true; fi
    local completa=true
    if [[ -e $cor_marker ]]; then completa=false; fi
    if (( cor_json )); then
      printf '{"cor":"%s","corAplicada":"%s","padrao":%s,"temaLigado":%s,"completa":%s}\n' \
        "$current" "$aplicada" "$(accent_is_default)" "$ligado" "$completa" >&3
    else
      echo "Cor de destaque: $current$([[ -s $accent_file ]] || echo ' (padrão)')"
      if [[ $aplicada != "$current" ]]; then
        echo "  (o tema usa $aplicada: a cor pedida não teria contraste para ler sobre o fundo)"
      fi
      if [[ $completa == false ]]; then
        echo "A última troca de cor foi interrompida; rode o mesmo comando de novo para completar."
      fi
    fi
    return
  fi
  [[ $value == padrao || $value =~ ^#?[0-9A-Fa-f]{6}$ ]] || cor_exit 2 "cor inválida: use #RRGGBB ou padrao"
  take_lock || cor_exit 3 "ocupado: outra execução do cyberkde está em andamento"
  # Com o CyberKDE ligado a cor reaplica fases; os dois temas ligados ao mesmo tempo é estado
  # inconsistente, e reaplicar gravaria por cima do AppleKDE.
  if tema_ligado && applekde_ligado; then
    cor_exit 1 "o AppleKDE também está ligado: rode 'cyberkde on' (ele desliga o AppleKDE antes) e depois a cor. Nada foi aplicado."
  fi
  set -E
  trap 'cor_exit 1 "falha ao aplicar a cor (detalhes na saída de erro)"' ERR
  trap cor_interrupted TERM INT HUP
  # Marca de aplicação em andamento: só é apagada no fim. Se o processo morrer no meio (mesmo com
  # SIGKILL), a leitura da cor devolve "completa":false, e basta rodar o mesmo comando de novo.
  : >"$cor_marker"
  if [[ $value == padrao ]]; then
    rm -f "$accent_file"
  else
    mkdir -p "$(dirname -- "$accent_file")"
    value=${value#\#}
    printf '#%s\n' "${value^^}" >"$accent_file"
  fi
  # A corporação vem junto: o "corp" passa a dele; uma cor escolhida à mão é "personalizada" (logo do
  # tema), e a padrão é "nenhuma". Gravada antes de regenerar: os geradores e o ícone do menu leem daqui.
  # A paleta (secundária, alerta e fundo) vem só da corporação; a cor à mão volta ao resto do padrão.
  corp_carregar
  if [[ -n $cor_corp ]]; then corp_gravar "$cor_corp"
  elif [[ $value == padrao ]]; then corp_gravar nenhuma
  else corp_gravar personalizada; fi
  corp_paleta_gravar "${cor_corp:-}"
  if [[ -n $secundaria ]]; then  # personalizada com secundária: só ela no arquivo da paleta
    secundaria=${secundaria#\#}
    printf '{"secundaria":"#%s"}\n' "${secundaria^^}" >"$paleta_file"
  fi
  local accent aplicada
  accent=$(accent_color)
  aplicada=$(accent_applied)
  local p ligado=false reiniciado=false
  local -a fases=() aplicadas=() puladas=() pendentes=()
  if tema_ligado; then ligado=true; fi
  # A mensagem só promete regenerar quando vai mesmo: com o tema desligado não há o que regenerar.
  if [[ $ligado == true ]]; then
    echo "Cor de destaque: $accent — regenerando o tema…"
  else
    echo "Cor de destaque: $accent"
  fi
  if [[ $aplicada != "$accent" ]]; then
    echo "  Contraste: $accent não leria sobre o fundo do tema; o tema usa $aplicada." \
      "A cor pedida continua sendo a sua e é a que aparece em 'cyberkde cor'."
  fi
  # Papel por corporação (papel_modo corp): o papel passa a ser o da corporação escolhida, e com ele o
  # bloqueio e o login. Com modo fixo (a pessoa escolheu outro), a corporação não mexe no papel.
  local papel_da_corp=0
  if [[ -n $cor_corp && $cor_corp != nenhuma && $(papel_modo) == corp ]] && papel_corp_suportado; then
    # A opção "corp" do módulo: quem troca a imagem é o papel_corp_seguir, antes das fases. O modo vai
    # junto, explícito: sem ele, a opção gravada pareceria uma escolha fixa da pessoa.
    papel_modo_gravar corp
    kwriteconfig6 --file "$efeitos_file" --group papel --key opcao corp
  elif [[ $cor_corp == nenhuma && $(papel_modo) == corp ]] && papel_corp_suportado &&
    [[ $(kreadconfig6 --file "$efeitos_file" --group papel --key opcao 2>/dev/null) == corp ]]; then
    papel_da_corp=1  # sem corporação: volta ao papel do tema
    kwriteconfig6 --file "$efeitos_file" --group papel --key opcao a
  fi
  for p in "${CYBERKDE_PHASES[@]}"; do
    # Qual papel de parede está na tela não muda. As imagens do tema são recoloridas pelo install_files
    # (install_papeis-de-parede); um papel próprio do usuário fica como está. Exceção: o papel que
    # acompanha a corporação, quando ela muda.
    if [[ $p != papeis-de-parede ]] || (( papel_da_corp )); then fases+=("$p"); fi
  done
  if [[ $ligado == true ]]; then
    progress_total=$(( INSTALL_STEPS + ${#CYBERKDE_INSTALLS[@]} + ${#fases[@]} + 2 ))  # + kwin e painel
  else
    progress_total=1  # nenhuma etapa; 1 e não 0 porque quem desenha a barra divide por este número
  fi
  progress inicio
  sem_sudo_pendentes="$state/sem-sudo-pendentes"  # as_needed anota aqui o que ficou sem gravar
  if [[ $ligado == true ]]; then
    # Reinício do plasmashell só no fim (ver restart_plasmashell): o do fim do "cor" já é sempre.
    rm -f -- "$plasma_adiar_marca"
    export CYBERKDE_ADIAR_PLASMA=1
    install_files
    # Papel da corporação (opção "corp", fase ligada): a imagem dela e o bloqueio, antes das fases, para
    # o login (que segue o papel, "login --fundo papel") já ver a imagem nova.
    if declare -F papel_corp_seguir >/dev/null; then
      papel_corp_seguir || echo "Aviso: o papel da corporação não foi aplicado." >&2
    fi
    # O login e o bloqueio acompanham o papel ("login --fundo papel"), sem precisar de um "on login".
    # O que ficar sem sudo (a tela do SDDM) entra nas pendências do login, no laço abaixo.
    if declare -F login_fundo_seguir >/dev/null; then login_fundo_seguir || true; fi
    # Tema ligado: reaplica as fases com a cor nova.
    for p in "${fases[@]}"; do
      progress fase "$p"
      : >"$sem_sudo_pendentes"
      fase_atual=$p
      if ("phase_$p"); then
        if [[ -s $sem_sudo_pendentes ]]; then
          pendentes+=("$p")
          echo "  … $p (pendente: precisa de sudo)"
        else
          aplicadas+=("$p")
          echo "  ✓ $p"
        fi
      else
        puladas+=("$p")
        echo "  – $p (pulada)"
      fi
    done
    fase_atual=""
    # O "cor" pula os papéis de parede; sem isto a imagem da tela de bloqueio ficava a do login, que
    # grava a mesma chave antes (no "on" completo vale a dos papéis de parede, que roda depois).
    for p in "${fases[@]}"; do chaves_reafirmar "$p"; done
    progress kwin
    reload_kwin
    unset CYBERKDE_ADIAR_PLASMA
    rm -f -- "$plasma_adiar_marca"
    progress painel  # o painel guarda cache do tema e dos ícones
    if restart_plasmashell; then reiniciado=true; fi
    if (( ${#pendentes[@]} )); then
      echo "Aplicado, menos: ${pendentes[*]} (precisa de sudo). Para completar, rode no terminal: $(cor_retomar)"
    else
      echo "Pronto. Reabra os aplicativos para ver a cor nova."
    fi
  else
    # Com o tema desligado, regenerar seria trabalho jogado fora: ninguém lê esses arquivos e o
    # "cyberkde on" chama install_files com a cor do momento (seriam ~25 s de CPU à toa).
    echo "Tema desligado: a cor vale no próximo 'cyberkde on'."
  fi
  progress fim
  rm -f "$sem_sudo_pendentes" "$cor_marker"
  painel_icone_atualizar  # o ícone do painel acompanha a cor
  trap - ERR TERM INT HUP
  if (( cor_json )); then
    local -a avisos=()
    mapfile -t avisos < <(avisos_de "${pendentes[@]}")
    # Pelo "corp", os campos da corporação vão no fim; o "cor" sozinho responde como sempre (mais o
    # "retomar", acrescentado no fim).
    local extra=""
    if [[ -n $cor_corp ]]; then extra=$(corp_json_campos); fi
    extra+=$(retomar_json "$( (( ${#pendentes[@]} )) && cor_retomar)")
    printf '{"cor":"%s","corAplicada":"%s","padrao":%s,"temaLigado":%s,"aplicadas":%s,"puladas":%s,"pendentesSudo":%s,"avisos":%s,"plasmaReiniciado":%s%s}\n' \
      "$accent" "$aplicada" "$(accent_is_default)" "$ligado" "$(json_list "${aplicadas[@]}")" \
      "$(json_list "${puladas[@]}")" "$(json_list "${pendentes[@]}")" "$(json_list_str "${avisos[@]}")" \
      "$reiniciado" "$extra" >&3
  fi
  (( ${#pendentes[@]} == 0 )) || exit 4
}

install_effect() {
  local src="$project/effects/cyberkde_scan" final="$data/kwin/effects/cyberkde_scan" dst cor_destaque cor_secundaria cor_base
  dst=$(mktemp -d)  # monta ao lado e troca de uma vez no fim (swap_dir)
  mkdir -p "$dst/contents/code" "$dst/contents/shaders"
  cp "$src/metadata.json" "$dst/"
  # Pacote já no formato do KWin (contents/code, contents/shaders...): vai como está, e o main.js
  # recebe as cores abaixo. É o caminho se o efeito passar a trazer vários arquivos próprios.
  if [[ -d $src/contents ]]; then cp -a "$src/contents/." "$dst/contents/"; fi
  # Chaves que o efeito lê do kwinrc (variante, durações, intensidade): o KWin só entrega ao
  # readConfig o que o contents/config/main.xml declara; sem ele, o efeito fica sempre no padrão.
  if [[ -f $src/main.xml ]]; then
    mkdir -p "$dst/contents/config"
    cp -- "$src/main.xml" "$dst/contents/config/main.xml"
  fi
  # Cores da paleta atual: destaque, secundária (a varredura) e superfície. Sem paleta, as mesmas do arquivo.
  local cores
  cores=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from cyberlib import RED, CYAN, BASE; print(RED, CYAN, BASE)' "$project/generator")
  read -r cor_destaque cor_secundaria cor_base <<<"$cores"
  local js="$src/main.js"
  [[ -f $js ]] || js="$dst/contents/code/main.js"
  sed -e "s/#F75049/$cor_destaque/" -e "s/#5EF6FF/$cor_secundaria/" -e "s/#12121C/$cor_base/" \
    "$js" >"$dst/contents/code/main.js.novo"
  mv -f "$dst/contents/code/main.js.novo" "$dst/contents/code/main.js"
  # Shaders: o KWin escolhe <nome>_core.frag (GLSL 1.40) ou <nome>.frag (legado) conforme o contexto
  # OpenGL. Cada .glsl vira os dois: o shader.glsl da raiz é o "scan" de sempre; os de shaders/*.glsl
  # (variantes, se a Rachael os separar) ficam com o próprio nome. Um .frag pronto em shaders/ é copiado.
  local glsl nome
  for glsl in "$src/shader.glsl" "$src"/shaders/*.glsl; do
    [[ -f $glsl ]] || continue
    nome=$(basename -- "$glsl" .glsl)
    [[ $glsl == "$src/shader.glsl" ]] && nome=scan
    { printf '#version 140\n#include "colormanagement.glsl"\n#define TEX texture\nin vec2 texcoord0;\nout vec4 fragColor;\n\n'
      cat "$glsl"; } >"$dst/contents/shaders/${nome}_core.frag"
    { printf '#include "colormanagement.glsl"\n#define TEX texture2D\n#define fragColor gl_FragColor\nvarying vec2 texcoord0;\n\n'
      cat "$glsl"; } >"$dst/contents/shaders/${nome}.frag"
  done
  for glsl in "$src"/shaders/*.frag; do
    if [[ -f $glsl ]]; then cp -- "$glsl" "$dst/contents/shaders/"; fi
  done
  chmod 755 "$dst"
  swap_dir "$dst" "$final"
  rm -rf -- "$dst"
}

# Faz o KWin reler a configuração e recarregar o efeito (necessário após reinstalar).
reload_kwin() {
  qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
  # O reconfigure não descarrega um efeito sozinho quando a chave some. Por isso o efeito do tema é
  # descarregado e recarregado conforme o kwinrc (sem chave = desligado). Os efeitos que não são do
  # tema ficam com o KWin.
  qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect cyberkde_scan >/dev/null 2>&1 || true
  if [[ $(kreadconfig6 --file kwinrc --group Plugins --key cyberkde_scanEnabled --default false) == true ]]; then
    qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect cyberkde_scan >/dev/null 2>&1 || true
  fi
}

# Reinicia o painel (o plasmashell guarda cache do tema e dos ícones). Se ele estiver rodando fora do
# serviço (iniciado à mão num terminal), um "systemctl restart" não o substitui: a instância nova vê
# a antiga e sai na hora. Nesse caso, encerra a antiga e devolve o painel ao systemd. Só retorna 0
# quando há um plasmashell novo rodando pelo serviço.
# Durante um "on" ou um "cor", o plasmashell só reinicia uma vez, no fim: uma fase ou um módulo que
# peça um reinício no meio (as fases rodam em subshell, daí a marca em arquivo) deixa o pedido
# anotado, e quem chama reinicia depois de todas as fases. Um reinício no meio derrubava o
# plasmashell justo quando a fase seguinte (a barra e a dock, os papéis de parede) precisava dele.
plasma_adiar_marca="$state/plasma-reiniciar-no-fim"
restart_plasmashell() {
  local before i pid
  if [[ ${CYBERKDE_ADIAR_PLASMA:-0} == 1 ]]; then
    mkdir -p -- "$state" && : >"$plasma_adiar_marca"
    return 0
  fi
  if [[ -n ${CYBERKDE_CENA:-} ]]; then
    # Capturas e testes num KWin virtual: o plasmashell da cena não é do systemd (o da sessão real é).
    plasmashell_parar
    setsid plasmashell --no-respawn >/dev/null 2>&1 </dev/null 3>&- 4>&- 9>&- &
    for i in {1..50}; do qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 && return 0; sleep 0.2; done
    return 1
  fi
  before=" $(pgrep -x plasmashell | tr '\n' ' ')"
  # O serviço aceita 3 partidas por minuto (StartLimitBurst): "off" e "on" seguidos passavam disso e o
  # plasmashell não voltava (tela preta, só o dock). Zerar o contador antes de cada partida.
  systemctl --user reset-failed plasma-plasmashell.service >/dev/null 2>&1 || true
  if systemctl --user is-active -q plasma-plasmashell.service; then
    # Não "systemctl restart": ele espera a saída graciosa, e um plasmashell de dias no ar (GBs, parte
    # em swap) levava 26 s só para parar (29/09, metade da troca de cor). O plasmashell_parar pede para
    # sair, espera até 5 s e encerra à força; a configuração dele já está em disco (grava ao mudar).
    plasmashell_parar
    systemctl --user start plasma-plasmashell.service || { plasmashell_sem_servico; return; }
  else
    kquitapp6 plasmashell >/dev/null 2>&1 || true
    for i in {1..50}; do pgrep -x plasmashell >/dev/null || break; sleep 0.2; done
    pkill -x plasmashell 2>/dev/null || true
    systemctl --user start plasma-plasmashell.service || { plasmashell_sem_servico; return; }
  fi
  for i in {1..50}; do
    for pid in $(pgrep -x plasmashell); do
      if [[ $before != *" $pid "* ]] && systemctl --user is-active -q plasma-plasmashell.service; then
        return 0
      fi
    done
    sleep 0.2
  done
  return 1
}

# O plasmashell está no D-Bus? Se não está, espera até ~15 s (pode estar reiniciando, por outro programa
# ou pelo próprio Plasma); se nem o processo existe, sobe o serviço e espera. 0 = respondendo.
plasmashell_garantir() {
  local i
  qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 && return 0
  if [[ -z ${CYBERKDE_CENA:-} ]] && ! pgrep -x plasmashell >/dev/null; then
    echo "  (o plasmashell não estava rodando; iniciando o serviço antes de seguir)" >&2
    systemctl --user reset-failed plasma-plasmashell.service >/dev/null 2>&1 || true
    systemctl --user start plasma-plasmashell.service >/dev/null 2>&1 || true
  fi
  for i in {1..75}; do
    qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 && return 0
    sleep 0.2
  done
  return 1
}

# Último recurso quando o systemd recusa a partida: o plasmashell direto, fora do serviço (o próximo
# "cyberkde on/off" o devolve ao serviço). Sem ele a sessão ficaria sem painel e sem área de trabalho.
plasmashell_sem_servico() {
  local i
  systemctl --user reset-failed plasma-plasmashell.service >/dev/null 2>&1 || true
  systemctl --user start plasma-plasmashell.service >/dev/null 2>&1 && return 0
  echo "Aviso: o systemd recusou reiniciar o plasmashell; iniciando fora do serviço." >&2
  setsid plasmashell >/dev/null 2>&1 </dev/null 3>&- 4>&- 9>&- &
  for i in {1..50}; do qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 && return 0; sleep 0.2; done
  echo "O painel não voltou. Para recuperar: systemctl --user reset-failed plasma-plasmashell.service &&" \
    "systemctl --user start plasma-plasmashell.service" >&2
  return 1
}

# Para o plasmashell desta sessão e espera ele sair do D-Bus. Quem chama (o "off") regrava o appletsrc
# em seguida, então não precisa esperar ele salvar: um plasmashell iniciado há pouco às vezes não sai
# no stop e o systemd esperava o TimeoutStopSec inteiro (40 s). Aqui: pede para sair, espera até 5 s e
# então encerra à força.
plasmashell_parar() {
  local i pid
  if [[ -n ${CYBERKDE_CENA:-} ]]; then
    kquitapp6 plasmashell >/dev/null 2>&1 3>&- 4>&- 9>&- &
    for i in {1..25}; do qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 || break; sleep 0.2; done
    # Só o plasmashell desta cena: o da sessão real também roda com --no-respawn.
    for pid in $(pgrep -x plasmashell || true); do
      tr '\0' '\n' 2>/dev/null <"/proc/$pid/environ" | grep -qxF "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" &&
        kill -KILL "$pid" 2>/dev/null
    done
    return 0
  fi
  # Sessão real: pede para parar sem bloquear e espera o PROCESSO sumir (não só o D-Bus ou o estado
  # do serviço: quem vem depois, como o papel de parede do "off", confere com pgrep). Com o pedido de
  # parada em andamento, o KILL encerra a parada sem o systemd reiniciar o plasmashell.
  systemctl --user reset-failed plasma-plasmashell.service >/dev/null 2>&1 || true
  systemctl --user stop --no-block plasma-plasmashell.service >/dev/null 2>&1 || true
  kquitapp6 plasmashell >/dev/null 2>&1 3>&- 4>&- 9>&- &
  for i in {1..25}; do pgrep -x plasmashell >/dev/null || break; sleep 0.2; done
  if pgrep -x plasmashell >/dev/null; then
    systemctl --user kill -s KILL plasma-plasmashell.service >/dev/null 2>&1 || true
    pkill -KILL -x plasmashell 2>/dev/null || true
    for i in {1..25}; do pgrep -x plasmashell >/dev/null || break; sleep 0.2; done
  fi
  for i in {1..25}; do
    case $(systemctl --user show -p ActiveState --value plasma-plasmashell.service 2>/dev/null) in
      inactive | failed | "") break ;;
    esac
    sleep 0.2
  done
  systemctl --user reset-failed plasma-plasmashell.service >/dev/null 2>&1 || true
  return 0
}

# O plasmashell guarda cache do tema do Plasma e dos ícones: sem reiniciar, o painel e a área de
# trabalho continuam com a aparência antiga mesmo com as chaves já gravadas.
plasma_reiniciado=false  # o último refresh_plasmashell conseguiu? (o "off --json" informa)
refresh_plasmashell() {
  if restart_plasmashell; then plasma_reiniciado=true; return 0; fi
  echo "Aviso: não consegui reiniciar o plasmashell; o painel e a área de trabalho podem continuar" \
    "com os ícones antigos. Rode: systemctl --user reset-failed plasma-plasmashell.service &&" \
    "systemctl --user restart plasma-plasmashell.service" >&2
}

# Fases cujo resultado só aparece depois de reiniciar o plasmashell. O papel de parede fica de fora:
# com o plasmashell no ar ele é aplicado por D-Bus, com efeito imediato.
phase_needs_plasmashell() {  # fase
  case $1 in icones-sistema | plasma) return 0 ;; *) return 1 ;; esac
}

# Troca uma pasta instalada pela nova quase de uma vez (cópia oculta ao lado + rename), para uma
# interrupção no meio não deixar o tema sem a pasta. Os nomes temporários são ocultos para o KDE
# não listá-los como temas.
swap_dir() {  # origem destino
  local src=$1 dst=$2 parent name
  parent=$(dirname -- "$dst")
  name=$(basename -- "$dst")
  mkdir -p "$parent"
  rm -rf -- "$parent/.$name.novo" "$parent/.$name.velho"
  cp -a -- "$src" "$parent/.$name.novo"
  if [[ -e $dst ]]; then mv -T -- "$dst" "$parent/.$name.velho"; fi
  mv -T -- "$parent/.$name.novo" "$dst"
  rm -rf -- "$parent/.$name.velho"
}

# Barra de progresso ("cyberkde cor --progresso"): uma linha no stderr anunciando cada etapa que
# começa; "feitas" conta as etapas já concluídas. Sem a opção, não imprime nada.
cor_progresso=0
progress_done=0
progress_total=0
progress() {  # etapa [nome]
  (( cor_progresso )) || return 0
  local extra=""
  if [[ -n ${2:-} ]]; then extra=",\"$([[ $1 == fase ]] && echo fase || echo item)\":\"$2\""; fi
  printf 'PROGRESSO {"etapa":"%s"%s,"feitas":%d,"total":%d}\n' "$1" "$extra" "$progress_done" "$progress_total" >&2
  if [[ $1 != inicio && $1 != fim ]]; then progress_done=$((progress_done + 1)); fi
}

INSTALL_STEPS=6  # etapas próprias de install_files; cada módulo (CYBERKDE_INSTALLS) soma mais uma
install_files() {
  corp_carregar  # logo e paleta da corporação (barra-e-dock, login): lido uma vez aqui
  progress arquivos kvantum
  python3 "$project/generator/gen_kvantum.py" >/dev/null
  install -Dm644 "$project/themes/color-schemes/CyberKDE.colors" "$data/color-schemes/CyberKDE.colors"
  install -Dm644 -t "$config/Kvantum/CyberKDE" "$project/themes/kvantum/CyberKDE/CyberKDE.kvconfig" \
    "$project/themes/kvantum/CyberKDE/CyberKDE.svg"
  progress arquivos janelas
  python3 "$project/generator/gen_aurorae.py" >/dev/null
  swap_dir "$project/themes/aurorae/CyberKDE" "$data/aurorae/themes/CyberKDE"
  progress arquivos konsole
  python3 "$project/generator/gen_konsole.py" >/dev/null
  install -Dm644 -t "$data/konsole" "$project/themes/konsole/CyberKDE.colorscheme" "$project/themes/konsole/CyberKDE.profile"
  # O perfil acabou de ser regravado: a integração do shell do konsole-erro (Command) volta, se estava
  # ligada; sem isto, um "on <outra fase>" a apagaria até o próximo "on konsole-anim".
  if grep -qsF -- "$konsole_perfil"$'\t'General$'\t'Command$'\t' "$ledger"; then
    (fase_atual=konsole-anim; konsole_efeito_aplicar erro)
  fi
  progress arquivos icones
  python3 "$project/generator/gen_icons.py" >/dev/null
  swap_dir "$project/themes/icons/CyberKDE" "$data/icons/CyberKDE"
  progress arquivos efeito
  install_effect
  progress arquivos fontes
  install -Dm644 -t "$data/fonts/CyberKDE" "$project/assets/fonts/"*.ttf
  fc-cache -f "$data/fonts" >/dev/null
  local hook
  for hook in "${CYBERKDE_INSTALLS[@]}"; do
    progress arquivos "${hook#install_}"
    "$hook"
  done
  echo "Arquivos do tema instalados."
}

# kreadconfig6/kwriteconfig6 com grupos aninhados: "A][B][C" vira --group A --group B --group C.
kcfg() {  # read|write arquivo grupo chave [argumentos...]
  local tool=kreadconfig6 file=$2 group=$3 key=$4 part
  [[ $1 == write ]] && tool=kwriteconfig6
  shift 4
  local -a groups=()
  while IFS= read -r part; do
    groups+=(--group "$part")
  done < <(printf '%s\n' "${group//\]\[/$'\n'}")
  "$tool" --file "$file" "${groups[@]}" --key "$key" "$@"
}

# Grava um valor lembrando o original (só na primeira vez) para o "off" devolver.
set_key() {  # arquivo grupo chave valor
  local file=$1 group=$2 key=$3 value=$4 orig
  mkdir -p "$state"
  touch "$ledger"
  if ! grep -qF -- "$file"$'\t'"$group"$'\t'"$key"$'\t' "$ledger"; then
    orig=$(kcfg read "$file" "$group" "$key" --default "$absent")
    printf '%s\t%s\t%s\t%s\n' "$file" "$group" "$key" "$orig" >>"$ledger"
    fase_marca novo c "$file"$'\t'"$group"$'\t'"$key"
    fase_valor novo "$file"$'\t'"$group"$'\t'"$key" "$value"
  else
    fase_marca mais c "$file"$'\t'"$group"$'\t'"$key"
    fase_valor mais "$file"$'\t'"$group"$'\t'"$key" "$value"
  fi
  kcfg write "$file" "$group" "$key" "$value"
}

# Anota no $fases_valores o valor que a fase atual gravou na chave ("novo": esquece os de antes).
fase_valor() {  # novo|mais identificação valor
  [[ $1 == novo || -n $fase_atual ]] || return 0
  touch "$fases_valores"
  ID=$2 FASE=$fase_atual VALOR=$3 MODO=$1 awk -F'\t' -v OFS='\t' '
    BEGIN { id = ENVIRON["ID"]; f = ENVIRON["FASE"] }
    { k = $1 FS $2 FS $3 }
    k == id && (ENVIRON["MODO"] == "novo" || $4 == f) { next }
    { print }
    END { if (f != "") print id, f, ENVIRON["VALOR"] }' "$fases_valores" >"$fases_valores.novo"
  mv -f -- "$fases_valores.novo" "$fases_valores"
}

# Chaves que a fase gravou e que outra fase ligada também grava: ficam com o valor da que vem por
# último na ordem do "on", como num "on" completo. Chamado depois de ligar uma fase avulsa e no "off
# <fase>" (aí com a fase já fora da lista de quem usa a chave, mas ainda com o valor anotado). Só as
# chaves dessa fase: uma chave que a pessoa mudou à mão em outro lugar não é tocada.
chaves_reafirmar() {  # fase
  [[ -s $fases_valores && -s $ledger ]] || return 0
  local file group key value atual
  while IFS=$'\t' read -r file group key value; do
    atual=$(kcfg read "$file" "$group" "$key" --default "$absent")
    if [[ $atual != "$value" ]]; then kcfg write "$file" "$group" "$key" "$value"; fi
  done < <({ registro_unido; sed 's/^/V\t/' "$fases_valores"; } |
    F=$1 ORDEM="${CYBERKDE_PHASES[*]} ${CYBERKDE_FASES_OPCIONAIS[*]}" awk -F'\t' -v OFS='\t' "$registro_awk_inicio"'
      BEGIN { n = split(ENVIRON["ORDEM"], o, " "); for (i = 1; i <= n; i++) pos[o[i]] = i }
      $1 == "V" { val[$2 FS $3 FS $4, $5] = $6; next }
      $1 == "L" && (k in t) { chaves[++nc] = k; id[k] = $2 FS $3 FS $4 }
      END {
        for (c = 1; c <= nc; c++) {
          k = chaves[c]; if (!((id[k], ENVIRON["F"]) in val)) continue
          m = split(t[k], l, ",")
          melhor = ""; for (i = 1; i <= m; i++)
            if ((id[k], l[i]) in val && (melhor == "" || pos[l[i]] > pos[melhor])) melhor = l[i]
          if (melhor != "" && melhor != ENVIRON["F"]) print id[k], val[id[k], melhor]  # a própria fase: já gravou
        }
      }')
}

# Anota no $fases_reg que a fase atual gravou a chave ou o arquivo. "novo": a linha acabou de entrar
# no registro, então qualquer anotação velha com o mesmo nome é de um registro anterior (desfeito por
# um "off" de outra cópia, por exemplo) e é trocada. "mais": a linha já existia; a fase entra na lista
# de quem depende dela. É também a migração dos registros antigos: cada "on" marca o que regrava.
fase_marca() {  # novo|mais tipo identificação
  local modo=$1 id=$2$'\t'$3
  [[ $modo == novo || -n $fase_atual ]] || return 0
  mkdir -p "$state"
  touch "$fases_reg"
  ID=$id FASE=$fase_atual MODO=$modo awk -F'\t' -v OFS='\t' '
    BEGIN { id = ENVIRON["ID"]; f = ENVIRON["FASE"]; novo = ENVIRON["MODO"] == "novo" }
    { k = $0; sub(/\t[^\t]*$/, "", k) }
    k != id { print; next }
    { achou = 1 }
    novo { next }
    { n = split($NF, l, ","); for (i = 1; i <= n; i++) if (l[i] == f) { print; next }
      $NF = $NF "," f; print }
    END { if (f != "" && (novo || !achou)) print id, f }' "$fases_reg" >"$fases_reg.novo"
  mv -f -- "$fases_reg.novo" "$fases_reg"
}

# O registro inteiro num fluxo só, cada linha com a origem na frente (S fases.tsv, L ledger, F
# files.tsv), para um awk cruzar os três. Arquivo ausente = nenhuma linha.
registro_unido() {
  if [[ -f $fases_reg ]]; then sed 's/^/S\t/' "$fases_reg"; fi
  if [[ -f $ledger ]]; then sed 's/^/L\t/' "$ledger"; fi
  if [[ -f $files ]]; then sed 's/^/F\t/' "$files"; fi
  return 0
}

# awk comum aos leitores do registro: t[identificação] = lista de fases.
registro_awk_inicio='
  $1 == "S" { k = $0; sub(/^S\t/, "", k); v = k; sub(/\t[^\t]*$/, "", k); sub(/.*\t/, "", v); t[k] = v; next }
  $1 == "L" { k = "c" FS $2 FS $3 FS $4 }
  $1 == "F" { k = "a" FS $2 }'

# Alguma linha do ledger ou do files.tsv sem fase anotada (registro de versão anterior)? Sem "exit"
# no meio do awk: com pipefail, o sed que leva SIGPIPE faria a resposta sair trocada.
registro_sem_fase() {
  registro_unido | awk -F'\t' "$registro_awk_inicio"'
    !(k in t) { r = 1 }
    END { exit !r }'
}

# O "off <fase>" sabe o que é de cada fase? Só com o registro todo anotado e marcado como completo.
registro_por_fase() { [[ -e $fases_ok ]] && ! registro_sem_fase; }

# Fases com alguma chave ou arquivo no registro, mais as que guardam estado próprio (função
# ligada_<fase> do módulo, ver modules/CONTRATO.md). Uma por linha, na ordem do "on".
fases_ligadas() {
  local -A com_registro=()
  local p
  while IFS= read -r p; do com_registro[$p]=1; done < <(registro_unido | awk -F'\t' "$registro_awk_inicio"'
    (k in t) { n = split(t[k], l, ","); for (i = 1; i <= n; i++) if (l[i] != "" && l[i] != "legado") print l[i] }')
  for p in "${CYBERKDE_PHASES[@]}" "${CYBERKDE_FASES_OPCIONAIS[@]}"; do
    if [[ -n ${com_registro[$p]:-} ]] || { declare -F "ligada_$p" >/dev/null && "ligada_$p"; }; then
      echo "$p"
    fi
  done
}
fase_ligada() { [[ $'\n'$(fases_ligadas)$'\n' == *$'\n'"$1"$'\n'* ]]; }  # sem grep -q: ver registro_sem_fase

# Ao fim de um "on" completo sem fase pulada, o que continua sem fase não é de nenhuma fase atual
# (chaves de versões antigas do tema): vira "legado", e o registro passa a valer por fase.
registro_marca_legado() {
  registro_unido | awk -F'\t' -v OFS='\t' "$registro_awk_inicio"'
    !(k in t) { print k, "legado" }' >>"$fases_reg"
  : >"$fases_ok"
}

