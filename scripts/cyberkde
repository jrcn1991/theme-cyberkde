  set_key "$config/Kvantum/kvantum.kvconfig" General theme CyberKDE
  set_key dolphinrc KDE widgetStyle kvantum
  set_key dolphinrc UiSettings ColorScheme CyberKDE
  # Fonte: fica a do sistema. A Rajdhani nos nomes de arquivo cansou a vista em uso real.
}

# Moldura de todas as janelas (Aurorae) + animação de abrir/fechar (efeito do KWin).
phase_janelas() {
  set_key kwinrc org.kde.kdecoration2 library org.kde.kwin.aurorae
  set_key kwinrc org.kde.kdecoration2 theme __aurorae__svg__CyberKDE
  set_key kwinrc Plugins cyberkde_scanEnabled true
  # Minimizar e maximizar ficam com os efeitos que o sistema já usa: a varredura só anima abrir e
  # fechar. A variante, a duração e a intensidade escolhidas ("cyberkde efeito janelas").
  efeito_janelas_aplicar
  reload_kwin
}

# Konsole: perfil padrão CyberKDE (cores ANSI, cursor ciano, JetBrains Mono) + interface só nele.
phase_konsole() {
  set_key "$config/Kvantum/kvantum.kvconfig" General theme CyberKDE
  set_key konsolerc "Desktop Entry" DefaultProfile CyberKDE.profile
  set_key konsolerc KDE widgetStyle kvantum
  # Sem [UiSettings] ColorScheme aqui: o Konsole 25.12 reescreve essa chave vazia ao abrir. As cores
  # vêm do esquema global (fase "apps").
}

# Konsole compilado com texto novo em fade e rastro/halo no cursor.
phase_konsole-anim() {
  use_patched konsole org.kde.konsole
  efeitos_konsole_aplicar  # cascata e os outros efeitos escolhidos ("cyberkde efeito konsole-...")
}

# ------------------------------------------------------------------ efeitos (preferências)
# "Cascata de dados" do Konsole animado (konsole/PEDIDO-CLI.md): as linhas que saem pelo topo viram
# uma pluma de glifos numa faixa acima do texto. Desligada por padrão.
#
# Decisão sobre o registro: o efeito é uma PREFERÊNCIA, e não uma fase. A escolha da pessoa fica em
# ~/.config/cyberkde/efeitos (como a cor e o layout), e quem grava as chaves no konsolerc é a fase
# konsole-anim, pelo set_key: com registro, como toda chave do tema. Assim:
# - o "off" (e o "off konsole-anim") devolve o konsolerc original, como a pessoa espera de um "off";
# - a escolha não se perde: o próximo "on" grava de novo o que estava escolhido;
# - sem nunca ter usado o "efeito", nada entra no konsolerc.
# Com o konsole-anim desligado, o "efeito" só guarda a escolha, que vale no próximo "on".
efeitos_file="$config/cyberkde/efeitos"
cascata_pref() {  # chave padrão
  kreadconfig6 --file "$efeitos_file" --group konsole-cascata --key "$1" --default "$2"
}

# Grava a preferência no konsolerc. Só pela fase konsole-anim (ou pelo "efeito" com ela ligada, como
# se fosse ela): o set_key anota a fase, e o "off konsole-anim" devolve as três chaves.
efeito_cascata_aplicar() {
  [[ -s $efeitos_file ]] && grep -q '^\[konsole-cascata\]' "$efeitos_file" || return 0
  # Movimento reduzido ou mínimo: a cascata fica desligada (a escolha guardada volta com o completo).
  local ligado
  ligado=$(cascata_pref ligado false)
  if [[ $(movimento_nivel) != completo ]]; then ligado=false; fi
  set_key konsolerc CyberKDE Cascata "$ligado"
  set_key konsolerc CyberKDE CascataLinhas "$(cascata_pref linhas 5)"
  set_key konsolerc CyberKDE CascataCores "$(cascata_pref cores video)"
}

# A biblioteca do Konsole no prefixo tem a marca (o nome de uma chave do patch)? Ler a biblioteca leva
# ~0,3 s, e o status --json pergunta por dez efeitos: a resposta fica num cache por arquivo, data e
# tamanho (~/.cache/cyberkde), e só um Konsole novo é lido de novo.
konsole_marcas_cache="${XDG_CACHE_HOME:-$HOME/.cache}/cyberkde/konsole-marcas"
konsole_lib_tem() {  # prefixo marca
  local f id r
  [[ -n ${1:-} && -d $1 ]] || return 1
  while IFS= read -r -d '' f; do
    id="$f"$'\t'"$(stat -c '%Y:%s' -- "$f" 2>/dev/null)"$'\t'"$2"
    r=$(grep -F -- "$id"$'\t' "$konsole_marcas_cache" 2>/dev/null | tail -1 | cut -f4)
    if [[ -z $r ]]; then
      if grep -qa -- "$2" "$f"; then r=1; else r=0; fi
      { mkdir -p -- "$(dirname -- "$konsole_marcas_cache")" && printf '%s\t%s\n' "$id" "$r" >>"$konsole_marcas_cache"; } 2>/dev/null || true
    fi
    if [[ $r == 1 ]]; then return 0; fi
  done < <(find "$1" -name 'libkonsoleprivate.so*' -type f -print0 2>/dev/null)
  return 1
}
# O Konsole tem a cascata? (teste da Rachael: a chave CascataLinhas na biblioteca)
konsole_tem_cascata() { konsole_lib_tem "${1:-}" CascataLinhas; }
# Prefixo que o lançador ~/.local/bin/konsole usa AGORA (vazio: Konsole do sistema).
konsole_prefixo_em_uso() {
  sed -n 's/^prefix="\(.*\)"$/\1/p' "$HOME/.local/bin/konsole" 2>/dev/null | head -1
}

# Estado em JSON: ligado (a escolha), linhas, cores, aplicado (o que está no konsolerc agora),
# disponivel (o Konsole do lançador tem o efeito) e disponivelAoReligar (o que o próximo "on
# konsole-anim" escolheria tem; ver patched_prefix).
cascata_json() {
  local ligado linhas cores aplicado disp=false depois=false
  ligado=$(cascata_pref ligado false) linhas=$(cascata_pref linhas 5) cores=$(cascata_pref cores video)
  aplicado=$(kreadconfig6 --file konsolerc --group CyberKDE --key Cascata --default false)
  if konsole_tem_cascata "$(konsole_prefixo_em_uso)"; then disp=true; fi
  if konsole_tem_cascata "$(patched_prefix konsole)"; then depois=true; fi
  [[ $ligado == true ]] || ligado=false
  [[ $aplicado == true ]] || aplicado=false
  [[ $linhas =~ ^[0-9]+$ ]] || linhas=5
  printf '{"ligado":%s,"linhas":%d,"cores":"%s","aplicado":%s,"disponivel":%s,"disponivelAoReligar":%s}' \
    "$ligado" "$linhas" "$cores" "$aplicado" "$disp" "$depois"
}

# "cyberkde efeito konsole-cascata [on|off] [--linhas N] [--cores video|tema] [--json]"
#   (também "... linhas N" e "... cores video|tema", como no pedido da Rachael). Sem ação: só lê.
#   --json: {"efeito":"konsole-cascata","ligado","linhas","cores","aplicado","disponivel",
#            "disponivelAoReligar","avisos":[...]}
#   saída: 0 · 1 falha · 2 uso inválido · 3 ocupado
efeito_cmd_konsole-cascata() {
  local acao="" linhas="" cores="" arg
  for (( ; $# ; )); do
    arg=$1; shift
    case $arg in
      --json) cor_json=1 ;;
      --linhas) linhas=${1:-}; shift || true ;;
      --cores) cores=${1:-}; shift || true ;;
      on | off) acao=$arg ;;
      linhas) linhas=${1:-}; shift || true ;;
      cores) cores=${1:-}; shift || true ;;
      *) acao=invalida ;;
    esac
  done
  [[ $acao != invalida ]] || cor_exit 2 "$(t "uso: cyberkde efeito konsole-cascata [on|off] [--linhas 2-20] [--cores video|tema] [--json]" "usage: cyberkde efeito konsole-cascata [on|off] [--linhas 2-20] [--cores video|tema] [--json]")"
  if [[ -n $linhas ]] && ! { [[ $linhas =~ ^[0-9]+$ ]] && (( linhas >= 2 && linhas <= 20 )); }; then
    cor_exit 2 "$(t "linhas: um número de 2 a 20" "lines: a number from 2 to 20")"
  fi
  [[ -z $cores || $cores == video || $cores == tema ]] || cor_exit 2 "$(t "cores: video ou tema" "colors: video or tema")"
  local -a avisos=()
  if [[ -n $acao$linhas$cores ]]; then
    take_lock || cor_exit 3 "$(t "ocupado: outra execução do cyberkde está em andamento" "busy: another cyberkde run is in progress")"
    local w=(kwriteconfig6 --file "$efeitos_file" --group konsole-cascata)
    mkdir -p -- "$(dirname -- "$efeitos_file")"
    # Primeira gravação: as três chaves, para o konsolerc receber o conjunto completo.
    "${w[@]}" --key ligado "$( [[ $acao == on ]] && echo true || { [[ $acao == off ]] && echo false || cascata_pref ligado false; } )"
    "${w[@]}" --key linhas "${linhas:-$(cascata_pref linhas 5)}"
    "${w[@]}" --key cores "${cores:-$(cascata_pref cores video)}"
    if fase_ligada konsole-anim; then
      (fase_atual=konsole-anim; efeito_cascata_aplicar)
      echo "$(t "Cascata de dados" "Data cascade"): $(cascata_pref ligado false) · $(cascata_pref linhas 5) $(t linhas lines) · $(cascata_pref cores video). $(t "Vale nas janelas abertas do Konsole animado em instantes." "Takes effect in open animated Konsole windows within moments.")"
    else
      avisos+=("$(t "O Konsole animado (fase konsole-anim) está desligado: a escolha foi guardada e vale no próximo cyberkde on." "The animated Konsole (konsole-anim part) is off: the choice was saved and applies on the next cyberkde on.")")
    fi
  fi
  local estado
  estado=$(cascata_json)
  if [[ $(cascata_pref ligado false) == true && $estado != *'"disponivel":true'* ]]; then
    if [[ $estado == *'"disponivelAoReligar":true'* ]]; then
      avisos+=("$(t "O Konsole do lançador ainda não tem a cascata; a compilação mais nova tem. Rode cyberkde on konsole-anim e abra um Konsole novo (os abertos continuam como estão)." "The launcher's Konsole does not have the cascade yet; the newer build does. Run cyberkde on konsole-anim and open a new Konsole (open ones stay as they are).")")
    else
      avisos+=("$(t "O Konsole animado instalado é anterior à cascata: a escolha vale depois de atualizar (cyberkde animados com o pacote novo, ou cyberkde konsole-build)." "The installed animated Konsole predates the cascade: the choice applies after updating it (cyberkde animados with the new package, or cyberkde konsole-build).")")
    fi
  fi
  if (( cor_json )); then
    local corpo=${estado#\{}
    printf '{"efeito":"konsole-cascata",%s,"avisos":%s}\n' "${corpo%\}}" "$(json_list_str "${avisos[@]}")" >&3
  else
    if [[ -z $acao$linhas$cores ]]; then
      echo "$(t "Cascata de dados no Konsole" "Konsole data cascade"): $estado"
    fi
    local a
    for a in "${avisos[@]}"; do echo "$(t Aviso Note): $a" >&2; done
  fi
}

# ------------------------------------------------------------------ registro de efeitos
# Efeitos configuráveis ("cyberkde efeito ..."): preferências que o painel monta sozinho a partir de
# "cyberkde efeito --lista --json". Cada efeito <id> registrado em CYBERKDE_EFEITOS define:
#   efeito_cmd_<id> [args...]  o comando ("cyberkde efeito <id> ..."); --json já tratado por quem chama
#   efeito_json_<id>           o item da lista: {"id","nome","nome_en","descricao","descricao_en",
#                              "tipo":"liga"|"variante","opcoes":[...],"estado":{...}}
#   efeito_estado_<id>         (opcional) só o objeto "estado", para o status --json
# Um módulo registra os seus do mesmo jeito (modules/CONTRATO.md). A escolha fica em
# ~/.config/cyberkde/efeitos; quem grava a configuração do programa é a fase dona do efeito, pelo
# set_key (o "off" devolve o original e o "on" reaplica a escolha).
CYBERKDE_EFEITOS=(janelas konsole-cascata)
# Área de cada efeito, para o painel organizar ("grupo" no efeito --lista). Quem não declara aqui pode
# pôr "grupo" no próprio efeito_json_<id>; sem nenhum dos dois, vale "sistema".
declare -A CYBERKDE_EFEITO_GRUPO=([janelas]=janelas [konsole-cascata]=terminal [cursor]=interface)
# Ordem e nomes dos grupos conhecidos; um grupo novo que um módulo usar entra no fim da lista, com o
# próprio id como nome (o painel mostra mesmo assim).
efeitos_grupos=(janelas terminal interface estilo area-de-trabalho login sistema)
declare -A efeitos_grupo_nome=([janelas]="Janelas" [terminal]="Terminal" [interface]="Interface" [estilo]="Estilo visual" [area-de-trabalho]="Área de trabalho" [login]="Login e bloqueio" [sistema]="Sistema")
declare -A efeitos_grupo_nome_en=([janelas]="Windows" [terminal]="Terminal" [interface]="Interface" [estilo]="Visual style" [area-de-trabalho]="Desktop" [login]="Login and lock screen" [sistema]="System")

# Chave que o tema gravou (está no registro) e que a escolha atual não pede mais: volta ao original
# do registro, em vez de ficar com o valor velho. Sem registro dela, nada a fazer.
chave_restaurar() {  # arquivo grupo chave
  local orig
  orig=$(F="$1" G="$2" K="$3" awk -F'\t' '$1 == ENVIRON["F"] && $2 == ENVIRON["G"] && $3 == ENVIRON["K"] {print $4; exit}' "$ledger" 2>/dev/null)
  [[ -n $orig ]] || return 0
  if [[ $orig == "$absent" ]]; then kcfg write "$1" "$2" "$3" --delete; else kcfg write "$1" "$2" "$3" "$orig"; fi
}

# O set_key grava sem --notify; quem vigia a chave pelo KConfigWatcher (apps abertos, o KWin) só
# a relê com o sinal. Emite o mesmo que o kwriteconfig6 --notify emitiria.
kconfig_avisar() {  # arquivo-relativo-a-~/.config grupo chave
  local bytes
  bytes=$(printf '%s' "$3" | od -An -tx1 | tr -s ' \n' ' ' | sed -E 's/^ //; s/ $//; s/([0-9a-f]{2})/0x\1/g; s/ /, /g')
  gdbus emit --session --object-path "/kconfig/$1" --signal org.kde.kconfig.notify.ConfigChanged \
    "{'$2': [[byte $bytes]]}" >/dev/null 2>&1 || true
}

# Nível de movimento escolhido ("cyberkde efeito movimento", modules/kwin-extras): completo, reduzido
# ou minimo. Os efeitos do tema que animam consultam isto ao gravar a própria configuração.
movimento_nivel() {
  local n
  n=$(kreadconfig6 --file "$efeitos_file" --group movimento --key nivel --default completo 2>/dev/null)
  case $n in reduzido | minimo) echo "$n" ;; *) echo completo ;; esac
}

#   cyberkde efeito --lista [--json]
#   cyberkde efeito <id> [opções] [--json]
cmd_efeito() {
  local id="" arg lista=0
  local -a resto=()
  for arg in "$@"; do
    case $arg in
      --json) cor_json=1 ;;
      --lista) if [[ -z $id ]]; then lista=1; else resto+=("$arg"); fi ;;
      *) if [[ -z $id && $lista == 0 ]]; then id=$arg; else resto+=("$arg"); fi ;;
    esac
  done
  if (( cor_json )); then exec 3>&1 1>&2; else exec 3>&1; fi
  local disponiveis="${CYBERKDE_EFEITOS[*]}"
  if (( lista )); then
    local itens="" e item g grupos=""
    for e in "${CYBERKDE_EFEITOS[@]}"; do
      item=$("efeito_json_$e")
      # O grupo do registro entra se o próprio efeito não trouxer um.
      if [[ $item != *'"grupo":'* ]]; then item="{\"grupo\":\"${CYBERKDE_EFEITO_GRUPO[$e]:-sistema}\",${item#\{}"; fi
      itens+="${itens:+,}$item"
    done
    local -a todos=("${efeitos_grupos[@]}")
    while IFS= read -r g; do
      [[ -n $g && " ${todos[*]} " != *" $g "* ]] && todos+=("$g")
    done < <(grep -o '"grupo":"[^"]*"' <<<"$itens" | cut -d'"' -f4)
    for g in "${todos[@]}"; do
      grupos+="${grupos:+,}{\"id\":\"$g\",\"nome\":$(json_str "${efeitos_grupo_nome[$g]:-$g}"),\"nome_en\":$(json_str "${efeitos_grupo_nome_en[$g]:-$g}")}"
    done
    if (( cor_json )); then
      printf '{"efeitos":[%s],"grupos":[%s]}\n' "$itens" "$grupos" | efeitos_com_forma >&3
    else
      for e in "${CYBERKDE_EFEITOS[@]}"; do echo "  $e"; done
    fi
    return
  fi
  if [[ -z $id ]] && (( ! cor_json )); then  # "cyberkde efeito" sozinho: os ids, e onde ver o resto
    echo "$(t "Efeitos (cyberkde efeito <id> [opções]; detalhes: cyberkde efeito --lista --json):" "Effects (cyberkde efeito <id> [options]; details: cyberkde efeito --lista --json):")"
    printf '  %s\n' "${CYBERKDE_EFEITOS[@]}" | column -c 100 2>/dev/null || printf '  %s\n' "${CYBERKDE_EFEITOS[@]}"
    return 0
  fi
  if [[ -z $id || " $disponiveis " != *" $id "* ]] || ! declare -F "efeito_cmd_$id" >/dev/null; then
    cor_exit 2 "$(t "efeito desconhecido: ${id:-(nenhum)} (há: ${disponiveis// /, })" "unknown effect: ${id:-(none)} (available: ${disponiveis// /, })")"
  fi
  "efeito_cmd_$id" "${resto[@]}"
}

# "comando" e "forma" de cada efeito do --lista (pedido 12 do painel), para ninguém deduzir a sintaxe:
#   "forma": {"liga": true|false, "opcoes": {"<opção>": "posicional"|"flag"|"igual"}}
#     liga: aceita on|off como primeiro argumento; posicional: só o valor ("efeito cursor neon");
#     flag: "--<opção> valor"; igual: "<opção>=valor" (os grupos do efeito icones).
#   "comando": o modelo, com {opção} no lugar do valor e [] no que é opcional; por exemplo
#     "cyberkde efeito areas [{numero}] [--nomes {nomes}]". O --json fica por conta de quem chama.
# Um efeito que já traga "comando"/"forma" no próprio JSON não é tocado. Só roda no --lista, nunca no
# status --json (é um Python a mais).
efeitos_com_forma() {
  python3 -c '
import json, sys
d = json.load(sys.stdin)
POSICIONAL = {"cursor": "variante", "movimento": "nivel", "layout": "preset", "menu": "modo", "papel": "opcao",
              "som": "variante", "splash": "modo", "areas": "numero"}
LIGA = {"konsole-cascata", "modal-escurecer", "clique"}
for e in d["efeitos"]:
    if "comando" in e and "forma" in e:
        continue
    i = e["id"]
    liga = e.get("tipo") == "liga" or i in LIGA or i.startswith("estilo-")
    ops = [o["id"] for o in e.get("opcoes", []) if isinstance(o, dict) and "id" in o]
    forma = {}
    if i.startswith("estilo-"):
        forma["variante"] = "flag"
    for o in ops:
        if POSICIONAL.get(i) == o:
            forma[o] = "posicional"
        elif i == "icones":
            forma[o] = "igual"
        else:
            forma[o] = "flag"
    partes = ["cyberkde efeito", i] + (["[on|off]"] if liga else [])
    for o, f in forma.items():
        # Tudo opcional: sem valor, o comando só lê o estado; com só uma das opções, as outras ficam
        # como estão (ex.: "efeito areas --nomes simples" não precisa repetir o número de áreas).
        partes.append("[{%s}]" % o if f == "posicional" else ("[%s={%s}]" % (o, o) if f == "igual" else "[--%s {%s}]" % (o, o)))
    e.setdefault("forma", {"liga": liga, "opcoes": forma})
    e.setdefault("comando", " ".join(partes))
json.dump(d, sys.stdout, ensure_ascii=False, separators=(",", ":"))
print()'
}

# Estado de todos os efeitos para o status --json: {"konsoleCascata":{...},"janelas":{...}}.
# O nome da chave é o id em camelCase (konsole-cascata -> konsoleCascata).
# Estados em lote (opcional): um módulo com muitos efeitos que custam um processo cada (ex.: o estilo,
# em Python) registra em CYBERKDE_EFEITOS_LOTE uma função que imprime "id<TAB>objeto-json" por linha;
# o status usa essas respostas em vez de chamar um efeito_estado_<id> por vez.
CYBERKDE_EFEITOS_LOTE=()
efeitos_status_json() {
  local e chave out="" f id js
  local -A lote=()
  for f in "${CYBERKDE_EFEITOS_LOTE[@]}"; do
    declare -F "$f" >/dev/null || continue
    while IFS=$'\t' read -r id js; do [[ -n $id && -n $js ]] && lote[$id]=$js; done < <("$f" 2>/dev/null || true)
  done
  for e in "${CYBERKDE_EFEITOS[@]}"; do
    chave=$(sed -E 's/-([a-z])/\U\1/g' <<<"$e")
    if [[ -n ${lote[$e]:-} ]]; then
      out+="${out:+,}\"$chave\":${lote[$e]}"
    elif declare -F "efeito_estado_$e" >/dev/null; then
      out+="${out:+,}\"$chave\":$("efeito_estado_$e")"
    fi
  done
  printf '{%s}' "$out"
}

efeito_estado_konsole-cascata() { cascata_json; }
efeito_json_konsole-cascata() {
  printf '{"id":"konsole-cascata","nome":%s,"nome_en":%s,"descricao":%s,"descricao_en":%s,"tipo":"liga","opcoes":[%s,%s],"estado":%s}' \
    "$(json_str "Cascata de dados no Konsole")" "$(json_str "Konsole data cascade")" \
    "$(json_str "Uma faixa acima do texto mostra as linhas que saem da tela subindo como uma pluma colorida que se desintegra. O texto não é coberto.")" \
    "$(json_str "A strip above the text shows the lines leaving the screen rising as a colored plume that breaks apart. The text is never covered.")" \
    '{"id":"linhas","nome":"Altura (linhas)","nome_en":"Height (lines)","tipo":"inteiro","min":2,"max":20,"padrao":5}' \
    '{"id":"cores","nome":"Cores","nome_en":"Colors","tipo":"escolha","padrao":"video","valores":[{"id":"video","nome":"Vídeo","nome_en":"Video"},{"id":"tema","nome":"Cores do tema","nome_en":"Theme colors"}]}' \
    "$(cascata_json)"
}

# ------------------------------------------------------------------ efeito "janelas"
# Animação de abrir e fechar janelas: o efeito cyberkde_scan do KWin, com as variantes que a Rachael
# descreve em effects/cyberkde_scan/variantes.json:
#   [{"id","nome","nome_en","descricao","descricao_en","abrir","fechar","duracaoAbrir","duracaoFechar",
#     "referencia"}]   (abrir/fechar: a variante serve para abrir/fechar; durações em ms)
# Configuração do efeito em kwinrc [Effect-cyberkde_scan]: AbrirVariante, FecharVariante, OpenDuration,
# CloseDuration, Intensidade (0 a 100) (effects/cyberkde_scan/PEDIDO.md). Quem grava é a fase janelas
# (set_key, com registro); a escolha fica em ~/.config/cyberkde/efeitos [janelas]. Só vai para o
# kwinrc o que a pessoa escolheu: sem a chave, o próprio efeito usa o padrão (scan; fechar = a de
# abrir; a duração da variante no catálogo; intensidade 60). "nenhuma" = sem animação.
# Prévias: assets/previas/janelas/<id>-abrir.webp e <id>-fechar.webp.
janelas_catalogo="$project/effects/cyberkde_scan/variantes.json"
janelas_grupo_kwin="Effect-cyberkde_scan"
janelas_pref() { kreadconfig6 --file "$efeitos_file" --group janelas --key "$1" --default "${2:-}"; }

# O catálogo em linhas TSV "id abrir(0|1) fechar(0|1) duracaoAbrir duracaoFechar", para o bash, ou o
# catálogo em JSON (com as prévias em caminho absoluto), para a lista. Sem catálogo: nada / [].
janelas_catalogo_py() {  # tsv|json
  [[ -s $janelas_catalogo ]] || { [[ $1 == json ]] && echo '[]'; return 0; }
  python3 - "$1" "$janelas_catalogo" "$project/assets/previas/janelas" <<'PY'
import json, os, sys
modo, arq, previas = sys.argv[1:]
try:
    dados = json.load(open(arq, encoding="utf-8"))
except (OSError, ValueError) as e:
    print(f"variantes.json ilegível: {e}", file=sys.stderr)
    dados = []
if isinstance(dados, dict):  # aceita também {"variantes":[...]}
    dados = dados.get("variantes", [])
itens = [v for v in dados if isinstance(v, dict) and v.get("id")]
num = lambda v, p: int(v) if isinstance(v, (int, float)) and not isinstance(v, bool) else p
if modo == "tsv":
    for v in itens:
        print("\t".join([str(v["id"]), "1" if v.get("abrir", True) else "0", "1" if v.get("fechar", True) else "0",
                         str(num(v.get("duracaoAbrir"), 0)), str(num(v.get("duracaoFechar"), 0))]))
else:
    for v in itens:
        for lado in ("abrir", "fechar"):
            f = os.path.join(previas, f"{v['id']}-{lado}.webp")
            v["previa" + lado.capitalize()] = f if os.path.isfile(f) else None
    print(json.dumps(itens, ensure_ascii=False))
PY
}

janelas_variante() {  # id abrir|fechar -> 0 se a variante existe e serve para isso
  local id=$1 lado=$2 v a f _
  while IFS=$'\t' read -r v a f _; do
    if [[ $v == "$id" ]]; then [[ $lado == abrir && $a == 1 || $lado == fechar && $f == 1 ]]; return; fi
  done < <(janelas_catalogo_py tsv)
  return 1
}

# O que vai para o kwinrc: só o que foi escolhido. Uma linha "Chave<TAB>valor" por chave.
janelas_chaves() {
  local abrir fechar da df int pv
  abrir=$(janelas_pref abrir) fechar=$(janelas_pref fechar)
  da=$(janelas_pref duracao-abrir) df=$(janelas_pref duracao-fechar) int=$(janelas_pref intensidade)
  pv=$(janelas_pref primeira-vez)
  local dpv
  dpv=$(janelas_pref duracao-primeira-vez)
  # Movimento reduzido: só uma dissolução curta, sem deslocamento, varredura nem glitch. Vale a
  # variante "fade" se o catálogo tiver; senão, nenhuma animação. A escolha da pessoa fica guardada e
  # volta com o movimento completo.
  if [[ $(movimento_nivel) == reduzido ]]; then
    if janelas_variante fade abrir; then abrir=fade fechar=fade; else abrir=nenhuma fechar=nenhuma; fi
    da="" df="" pv="" dpv=""
  fi
  if [[ -n $pv ]]; then printf 'PrimeiraVezVariante\t%s\n' "$pv"; fi
  if [[ -n $pv && -n $dpv ]]; then printf 'PrimeiraVezDuration\t%s\n' "$dpv"; fi
  if [[ -n $abrir ]]; then printf 'AbrirVariante\t%s\n' "$abrir"; fi
  if [[ -n $fechar ]]; then printf 'FecharVariante\t%s\n' "$fechar"; fi
  if [[ -n $da ]]; then printf 'OpenDuration\t%s\n' "$da"; fi
  if [[ -n $df ]]; then printf 'CloseDuration\t%s\n' "$df"; fi
  if [[ -n $int ]]; then printf 'Intensidade\t%s\n' "$int"; fi
}

# Pela fase janelas (ou pelo "efeito janelas" com ela ligada, como se fosse ela).
efeito_janelas_aplicar() {
  { [[ -s $efeitos_file ]] && grep -q '^\[janelas\]' "$efeitos_file"; } || [[ $(movimento_nivel) == reduzido ]] || return 0
  local chave valor orig escolhidas
  escolhidas=$(janelas_chaves)
  while IFS=$'\t' read -r chave valor; do
    [[ -n $chave ]] && set_key kwinrc "$janelas_grupo_kwin" "$chave" "$valor"
  done <<<"$escolhidas"
  # Chave que o tema gravou antes e que agora não é mais escolhida (ex.: CloseDuration depois de
  # "--fechar nenhuma"): volta ao original do registro, em vez de ficar com o valor velho.
  for chave in AbrirVariante FecharVariante OpenDuration CloseDuration Intensidade PrimeiraVezVariante PrimeiraVezDuration; do
    [[ $'\n'$escolhidas == *$'\n'"$chave"$'\t'* ]] && continue
    chave_restaurar kwinrc "$janelas_grupo_kwin" "$chave"
  done
}

# Só o efeito relê a configuração: reconfigureEffect; sem ele (KWin antigo), descarrega e carrega.
janelas_recarregar_efeito() {
  [[ $(kreadconfig6 --file kwinrc --group Plugins --key cyberkde_scanEnabled --default false) == true ]] || return 0
  qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.reconfigureEffect cyberkde_scan >/dev/null 2>&1 && return 0
  qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect cyberkde_scan >/dev/null 2>&1 || true
  qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect cyberkde_scan >/dev/null 2>&1 || true
}

# Estado: a escolha, o que está no kwinrc e se o efeito instalado entende as variantes.
efeito_estado_janelas() {
  local k campos="" v
  for k in abrir:abrir fechar:fechar primeira-vez:primeiraVez; do
    v=$(janelas_pref "${k%%:*}")
    campos+=",\"${k#*:}\":$( [[ -n $v ]] && json_str "$v" || echo null)"
  done
  for k in duracao-abrir:duracaoAbrir duracao-fechar:duracaoFechar intensidade:intensidade duracao-primeira-vez:duracaoPrimeiraVez; do
    v=$(janelas_pref "${k%%:*}")
    campos+=",\"${k#*:}\":$( [[ $v =~ ^[0-9]+$ ]] && echo "$v" || echo null)"
  done
  local aplicado="" chave
  for chave in AbrirVariante FecharVariante OpenDuration CloseDuration Intensidade PrimeiraVezVariante PrimeiraVezDuration; do
    v=$(kreadconfig6 --file kwinrc --group "$janelas_grupo_kwin" --key "$chave")
    aplicado+="${aplicado:+,}\"$chave\":$( [[ -n $v ]] && json_str "$v" || echo null)"
  done
  local disp=false
  local inst="$data/kwin/effects/cyberkde_scan/contents"
  if [[ -s $janelas_catalogo && -f $inst/config/main.xml ]] && grep -qs AbrirVariante "$inst/code/main.js"; then disp=true; fi
  # primeiraVezDisponivel: o efeito instalado declara a chave (a lógica é do main.js da Rachael).
  local pvd=false
  if grep -qs PrimeiraVezVariante "$inst/config/main.xml"; then pvd=true; fi
  printf '{%s,"aplicado":{%s},"disponivel":%s,"catalogo":%s,"primeiraVezDisponivel":%s,"movimento":"%s"}' "${campos#,}" "$aplicado" "$disp" \
    "$([[ -s $janelas_catalogo ]] && echo true || echo false)" "$pvd" "$(movimento_nivel)"
}

efeito_json_janelas() {
  local cat abrir="" fechar="" v a f _
  cat=$(janelas_catalogo_py json)
  while IFS=$'\t' read -r v a f _; do
    [[ $a == 1 ]] && abrir+="${abrir:+,}$(json_str "$v")"
    [[ $f == 1 ]] && fechar+="${fechar:+,}$(json_str "$v")"
  done < <(janelas_catalogo_py tsv)
  printf '{"id":"janelas","nome":%s,"nome_en":%s,"descricao":%s,"descricao_en":%s,"tipo":"variante","opcoes":[%s],"variantes":%s,"estado":%s}' \
    "$(json_str "Animação de janelas")" "$(json_str "Window animation")" \
    "$(json_str "Como as janelas aparecem ao abrir e somem ao fechar.")" \
    "$(json_str "How windows appear when they open and vanish when they close.")" \
    "{\"id\":\"abrir\",\"nome\":\"Ao abrir\",\"nome_en\":\"On open\",\"tipo\":\"variante\",\"valores\":[${abrir}${abrir:+,}\"nenhuma\"]},{\"id\":\"fechar\",\"nome\":\"Ao fechar\",\"nome_en\":\"On close\",\"tipo\":\"variante\",\"valores\":[${fechar}${fechar:+,}\"nenhuma\"]},{\"id\":\"primeira-vez\",\"nome\":\"Na primeira abertura de cada app\",\"nome_en\":\"First time each app opens\",\"tipo\":\"variante\",\"valores\":[${abrir}${abrir:+,}\"nenhuma\"]},{\"id\":\"duracao-primeira-vez\",\"nome\":\"Duração na primeira abertura\",\"nome_en\":\"First-open duration\",\"tipo\":\"inteiro\",\"min\":50,\"max\":2000,\"unidade\":\"ms\"},{\"id\":\"duracao-abrir\",\"nome\":\"Duração ao abrir\",\"nome_en\":\"Open duration\",\"tipo\":\"inteiro\",\"min\":50,\"max\":2000,\"unidade\":\"ms\"},{\"id\":\"duracao-fechar\",\"nome\":\"Duração ao fechar\",\"nome_en\":\"Close duration\",\"tipo\":\"inteiro\",\"min\":50,\"max\":2000,\"unidade\":\"ms\"},{\"id\":\"intensidade\",\"nome\":\"Intensidade\",\"nome_en\":\"Intensity\",\"tipo\":\"inteiro\",\"min\":0,\"max\":100}" \
    "$cat" "$(efeito_estado_janelas)"
}

#   cyberkde efeito janelas [--abrir id|nenhuma] [--fechar id|nenhuma] [--primeira-vez id|nenhuma]
#                           [--duracao-abrir ms|padrao]
#                           [--duracao-fechar ms|padrao] [--intensidade 0-100|padrao] [--json]
#   cyberkde efeito janelas --lista --json   catálogo: {"variantes":[... "previaAbrir","previaFechar"],"estado"}
#   --json (sem --lista): {"efeito":"janelas",<estado>,"avisos":[...]}. Saída: 0 · 2 uso · 3 ocupado
efeito_cmd_janelas() {
  local abrir="" fechar="" da="" df="" int="" pv="" dpv="" lista=0 bad=0 arg
  while (( $# )); do
    arg=$1; shift
    case $arg in
      --abrir) abrir=${1:-}; shift || true ;;
      --primeira-vez) pv=${1:-}; shift || true ;;
      --duracao-primeira-vez) dpv=${1:-}; shift || true ;;
      --fechar) fechar=${1:-}; shift || true ;;
      --duracao-abrir) da=${1:-}; shift || true ;;
      --duracao-fechar) df=${1:-}; shift || true ;;
      --intensidade) int=${1:-}; shift || true ;;
      --lista) lista=1 ;;
      *) bad=1 ;;
    esac
  done
  local uso
  uso=$(t "uso: cyberkde efeito janelas [--abrir id|nenhuma] [--fechar id|nenhuma] [--primeira-vez id|nenhuma] [--duracao-primeira-vez ms] [--duracao-abrir ms] [--duracao-fechar ms] [--intensidade 0-100] [--lista] [--json]" \
    "usage: cyberkde efeito janelas [--abrir id|nenhuma] [--fechar id|nenhuma] [--primeira-vez id|nenhuma] [--duracao-primeira-vez ms] [--duracao-abrir ms] [--duracao-fechar ms] [--intensidade 0-100] [--lista] [--json]")
  (( bad == 0 )) || cor_exit 2 "$uso"
  if (( lista )); then
    if (( cor_json )); then
      printf '{"variantes":%s,"estado":%s}\n' "$(janelas_catalogo_py json)" "$(efeito_estado_janelas)" >&3
    else
      local v a f da0 df0
      while IFS=$'\t' read -r v a f da0 df0; do
        echo "  $v  ($( [[ $a == 1 ]] && t abrir open)$( [[ $a == 1 && $f == 1 ]] && echo ' · ')$( [[ $f == 1 ]] && t fechar close))"
      done < <(janelas_catalogo_py tsv)
    fi
    return
  fi
  if [[ -n $abrir$fechar ]] && [[ ! -s $janelas_catalogo ]]; then
    cor_exit 2 "$(t "o catálogo de variantes (effects/cyberkde_scan/variantes.json) ainda não existe nesta versão" "the variant catalog (effects/cyberkde_scan/variantes.json) does not exist in this version yet")"
  fi
  if [[ -n $abrir && $abrir != nenhuma ]] && ! janelas_variante "$abrir" abrir; then
    cor_exit 2 "$(t "variante de abrir desconhecida: $abrir (veja: cyberkde efeito janelas --lista)" "unknown open variant: $abrir (see: cyberkde efeito janelas --lista)")"
  fi
  if [[ -n $pv && $pv != nenhuma && $pv != padrao ]] && ! janelas_variante "$pv" abrir; then
    cor_exit 2 "$(t "variante de primeira abertura desconhecida: $pv (veja: cyberkde efeito janelas --lista)" "unknown first-open variant: $pv (see: cyberkde efeito janelas --lista)")"
  fi
  if [[ -n $fechar && $fechar != nenhuma ]] && ! janelas_variante "$fechar" fechar; then
    cor_exit 2 "$(t "variante de fechar desconhecida: $fechar (veja: cyberkde efeito janelas --lista)" "unknown close variant: $fechar (see: cyberkde efeito janelas --lista)")"
  fi
  local x
  for x in "$da" "$df" "$dpv"; do
    if [[ -n $x && $x != padrao ]] && ! { [[ $x =~ ^[0-9]+$ ]] && (( x >= 50 && x <= 2000 )); }; then
      cor_exit 2 "$(t "duração: de 50 a 2000 ms, ou padrao" "duration: 50 to 2000 ms, or padrao")"
    fi
  done
  if [[ -n $int && $int != padrao ]] && ! { [[ $int =~ ^[0-9]+$ ]] && (( int <= 100 )); }; then
    cor_exit 2 "$(t "intensidade: de 0 a 100, ou padrao" "intensity: 0 to 100, or padrao")"
  fi
  local -a avisos=()
  if [[ -n $abrir$fechar$da$df$int$pv$dpv ]]; then
    take_lock || cor_exit 3 "$(t "ocupado: outra execução do cyberkde está em andamento" "busy: another cyberkde run is in progress")"
    mkdir -p -- "$(dirname -- "$efeitos_file")"
    local par chave valor
    # "--primeira-vez nenhuma" fica gravado como escolha ("nenhuma" no estado; null = nunca escolhido) e
    # vai assim para o kwinrc, onde vale o mesmo que sem a chave. "padrao" apaga a escolha.
    for par in "abrir=$abrir" "fechar=$fechar" "duracao-abrir=$da" "duracao-fechar=$df" "intensidade=$int" "primeira-vez=$pv" "duracao-primeira-vez=$dpv"; do
      chave=${par%%=*} valor=${par#*=}
      [[ -n $valor ]] || continue
      if [[ $valor == padrao ]]; then
        kwriteconfig6 --file "$efeitos_file" --group janelas --key "$chave" --delete
      else
        kwriteconfig6 --file "$efeitos_file" --group janelas --key "$chave" "$valor"
      fi
    done
    # Grupo vazio ainda marca "janelas configurado": o kwriteconfig6 apaga o grupo sem chaves.
    kwriteconfig6 --file "$efeitos_file" --group janelas --key escolhido true
    if fase_ligada janelas; then
      (fase_atual=janelas; efeito_janelas_aplicar)
      janelas_recarregar_efeito
    else
      avisos+=("$(t "A animação de janelas (fase janelas) está desligada: a escolha foi guardada e vale no próximo cyberkde on." "The window animation (janelas part) is off: the choice was saved and applies on the next cyberkde on.")")
    fi
  fi
  local estado
  estado=$(efeito_estado_janelas)
  if [[ $(movimento_nivel) == reduzido && -n $abrir$fechar$pv ]]; then
    avisos+=("$(t "Movimento reduzido: as janelas usam só uma dissolução curta; a escolha volta com cyberkde efeito movimento completo." "Reduced motion: windows use only a short fade; the choice comes back with cyberkde efeito movimento completo.")")
  fi
  if [[ -n $pv && $pv != padrao && $pv != nenhuma && $estado == *'"primeiraVezDisponivel":false'* ]]; then
    avisos+=("$(t "O efeito instalado ainda não distingue a primeira abertura: a escolha foi gravada e vale quando ele passar a ler PrimeiraVezVariante." "The installed effect does not tell the first open apart yet: the choice was saved and applies once it reads PrimeiraVezVariante.")")
  fi
  if [[ -s $janelas_catalogo && $estado == *'"disponivel":false'* ]]; then
    avisos+=("$(t "O efeito instalado ainda não tem as variantes: elas valem depois do próximo cyberkde on (ou cyberkde install)." "The installed effect does not have the variants yet: they apply after the next cyberkde on (or cyberkde install).")")
  fi
  if (( cor_json )); then
    local corpo=${estado#\{}
    printf '{"efeito":"janelas",%s,"avisos":%s}\n' "${corpo%\}}" "$(json_list_str "${avisos[@]}")" >&3
  else
    echo "$(t "Animação de janelas" "Window animation"): $estado"
    local a
    for a in "${avisos[@]}"; do echo "$(t Aviso Note): $a" >&2; done
  fi
}

# Todos os apps Qt/KDE: estilo Kvantum e esquema de cores CyberKDE no kdeglobals (o mesmo que o Tema
# Global da loja aplica). Sem isto, só o Dolphin e o Konsole mudam e o resto fica no Breeze claro.
phase_apps() {
  if kvantum_ok; then
    set_key "$config/Kvantum/kvantum.kvconfig" General theme CyberKDE
    set_key kdeglobals KDE widgetStyle kvantum
  fi
  set_key kdeglobals General ColorScheme CyberKDE
  apply_colorscheme CyberKDE
}

# O plasma-apply-colorscheme copia as cores do esquema para o kdeglobals e avisa os apps abertos. Ele
# não faz nada se o nome já for o atual, e o CyberKDE.colors muda com a cor de destaque: por isso o
# nome é trocado antes, para forçar a cópia.
apply_colorscheme() {  # esquema
  command -v plasma-apply-colorscheme >/dev/null || return 0
  kwriteconfig6 --file kdeglobals --group General --key ColorScheme __cyberkde__
  plasma-apply-colorscheme "$1" >/dev/null 2>&1 || kwriteconfig6 --file kdeglobals --group General --key ColorScheme "$1"
}

# O "off" já devolveu a chave ColorScheme; falta copiar de volta as cores do esquema original (sem a
# chave, o padrão do Plasma: BreezeLight).
off_apps() {
  local orig
  orig=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme --default BreezeLight)
  [[ $orig == CyberKDE || $orig == __cyberkde__ ]] && orig=BreezeLight
  if [[ -f $data/color-schemes/$orig.colors || -f /usr/share/color-schemes/$orig.colors ]]; then
    local had
    had=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme)
    apply_colorscheme "$orig"
    # Sem chave antes do tema: continua sem chave (o padrão do sistema vale).
    [[ -n $had ]] || kwriteconfig6 --file kdeglobals --group General --key ColorScheme --delete
  fi
}

# Ícones de pastas e locais gerados com IA, por enquanto só no Dolphin.
phase_icones() {
  set_key dolphinrc Icons Theme CyberKDE
}

# Executa como root só quando o destino não é gravável pelo usuário (arquivos do sistema).
as_needed() {  # destino comando...
  local dst=$1 dir
  shift
  dir=$(dirname -- "$dst")
  while [[ ! -e $dir ]]; do dir=$(dirname -- "$dir"); done
  if [[ -w $dir && (! -e $dst || -w $dst) ]]; then
    "$@"
  elif [[ ${CYBERKDE_SEM_SUDO:-0} == 1 ]] ||
    { [[ ! -t 0 && -z ${SUDO_ASKPASS:-} ]] && ! sudo -n true 2>/dev/null; }; then
    # Sem terminal e sem SUDO_ASKPASS o sudo não tem como pedir a senha: em vez de falhar calado (a
    # fase saía com "✓"), fica pendente, como no modo sem sudo.
    # Modo sem sudo (cyberkde cor --sem-sudo, ou CYBERKDE_SEM_SUDO=1): nunca pede senha; o destino
    # fica sem gravar e é informado como pendente.
    if [[ -n ${sem_sudo_pendentes:-} ]]; then
      printf '%s\n' "$dst" >>"$sem_sudo_pendentes"
      # O "off" também avisa no stderr; no "cor" o stderr fica só para as linhas PROGRESSO.
      if [[ ${sem_sudo_avisa:-0} == 1 ]]; then echo "Pendente (sem sudo): $dst" >&2; fi
    else
      echo "Pendente (sem sudo): $dst" >&2
    fi
  else
    # Com SUDO_ASKPASS definido (execução sem terminal), a senha vem do auxiliar.
    # umask 022: um umask restritivo (ex.: 007) deixaria arquivos do sistema ilegíveis para quem roda
    # sem ser root (ex.: o SDDM lendo o tema em /usr/share).
    # sem_travas: o "sudo -A" abre o diálogo do askpass, que fica vivo esperando a senha.
    if ! sem_travas sudo ${SUDO_ASKPASS:+-A} sh -c 'umask 022; exec "$@"' sh "$@"; then
      # Senha errada ou sudo negado: pendente, para a fase não aparecer como aplicada.
      if [[ -n ${sem_sudo_pendentes:-} ]]; then printf '%s\n' "$dst" >>"$sem_sudo_pendentes"; fi
      echo "Não gravado (o sudo falhou): $dst" >&2
      return 1
    fi
  fi
}

# Registra o destino na primeira vez, guardando uma cópia do original (ou "-" se não existia).
remember_path() {  # destino
  local dst=$1 backup=-
  mkdir -p "$state/files"
  touch "$files"
  if grep -qF -- "$dst"$'\t' "$files"; then fase_marca mais a "$dst"; return; fi
  if [[ -e $dst || -L $dst ]]; then
    backup="$state/files/$(printf '%s' "$dst" | md5sum | cut -c1-16)"
    cp -a -- "$dst" "$backup"
  fi
  printf '%s\t%s\n' "$dst" "$backup" >>"$files"
  fase_marca novo a "$dst"
}

# Grava um arquivo (conteúdo pela entrada padrão) guardando o original, para o "off" devolver.
put_file() {  # destino
  local dst=$1 tmp
  tmp=$(mktemp)
  cat >"$tmp"
  remember_path "$dst"
  # Conteúdo igual ao que já está lá: nada a gravar (e nada de sudo).
  if [[ -f $dst ]] && cmp -s -- "$tmp" "$dst"; then
    rm -f -- "$tmp"
    return 0
  fi
  as_needed "$dst" mkdir -p -- "$(dirname -- "$dst")"
  as_needed "$dst" rm -f -- "$dst"
  as_needed "$dst" tee -- "$dst" <"$tmp" >/dev/null
  rm -f -- "$tmp"
}

# Copia uma pasta inteira para o destino guardando a original, para o "off" devolver.
put_dir() {  # origem destino
  local src=$1 dst=$2
  remember_path "$dst"
  # Pasta idêntica à que já está lá: nada a gravar (e nada de sudo).
  diff -rq --no-dereference -- "$src" "$dst" >/dev/null 2>&1 && return 0
  as_needed "$dst" rm -rf -- "$dst"
  as_needed "$dst" mkdir -p -- "$(dirname -- "$dst")"
  as_needed "$dst" cp -r --preserve=mode,timestamps -- "$src" "$dst"
}

# Memória livre agora, em MB (MemAvailable).
mem_livre_mb() { awk '/^MemAvailable:/ {print int($2 / 1024)}' /proc/meminfo; }

# Compila sem derrubar a sessão: jobs pela memória livre (~800 MB por compilador; o Latte com -O2 e
# 2 processos teve pico de 1,4 GB), prioridade
# baixa e, com o systemd, um limite de memória só para a compilação. Sem isso o ninja abre nproc+2
# compiladores e, numa máquina de 4 GB, o OOM-killer levou junto o KWin e o plasmashell (VM, 25/09).
compilar() {  # pasta-de-build
  local livre jobs cpus limite
  livre=$(mem_livre_mb)
  cpus=$(nproc)
  limite=$(( livre * 70 / 100 ))
  jobs=$(( limite / 800 ))
  (( jobs < 1 )) && jobs=1
  (( jobs > cpus )) && jobs=$cpus
  echo "Compilando com $jobs processo(s) (${livre} MB livres; limite de ${limite} MB para a compilação)."
  local -a baixo=(nice -n 19)
  command -v ionice >/dev/null && baixo+=(ionice -c3)
  if [[ -z ${CYBERKDE_CENA:-} ]] && systemd-run --user --scope --quiet -p MemoryMax=64M true 2>/dev/null; then
    # Estourou o limite: o kernel mata só a compilação, não a sessão.
    systemd-run --user --scope --quiet -p MemoryMax="${limite}M" -p MemorySwapMax=0 \
      "${baixo[@]}" cmake --build "$1" -j "$jobs"
  else
    "${baixo[@]}" cmake --build "$1" -j "$jobs"
  fi
}

# Dependências de compilação do app antes de baixar o código. No Ubuntu/Debian vêm do "apt-get
# build-dep", que precisa do código-fonte do apt (deb-src) habilitado; o tema não mexe nas fontes do
# apt por conta própria: diz o comando. Sem apt, só confere as ferramentas básicas.
build_deps() {  # pacote-fonte
  local falta=() c
  for c in git cmake ninja g++; do command -v "$c" >/dev/null || falta+=("$c"); done
  if command -v apt-get >/dev/null; then
    if apt-cache showsrc "$1" 2>/dev/null | grep -q '^Package:'; then
      if apt-get -s build-dep "$1" 2>/dev/null | grep -q '^Inst ' || (( ${#falta[@]} )); then
        echo "Instalando as dependências de compilação do $1 (pede a senha)…"
        sem_travas sudo ${SUDO_ASKPASS:+-A} apt-get build-dep -y "$1" &&
          sem_travas sudo ${SUDO_ASKPASS:+-A} apt-get install -y git ninja-build ||
          { echo "Não consegui instalar as dependências de compilação do $1." >&2; return 1; }
      fi
      return 0
    fi
    if (( ${#falta[@]} )); then
      echo "Para compilar o $1 faltam as ferramentas e bibliotecas de compilação. Elas vêm do código-fonte" \
        "do apt (deb-src), que está desligado. Para ligar (Ubuntu 26.04) e rodar de novo:" >&2
      echo "  sudo sed -i 's/^Types: deb\$/Types: deb deb-src/' /etc/apt/sources.list.d/ubuntu.sources && sudo apt update" >&2
      echo "  cyberkde $2-build" >&2
      return 1
    fi
    return 0  # ferramentas presentes: segue; se faltar biblioteca, o cmake diz qual
  fi
  if (( ${#falta[@]} )); then
    echo "Para compilar o $1 faltam: ${falta[*]} (e os pacotes de desenvolvimento do KF6/Qt6)." >&2
    return 1
  fi
}

# Baixa o código da mesma versão do app do sistema, aplica os patches de <app>/*.patch e
# compila em ~/.local/opt/cyberkde-<app>. Uso: build_patched <app> <repositório no invent.kde.org>.
build_patched() {
  local app=$1 repo=$2 version tag
  local src="$project/$app/src" build="$project/$app/build" prefix="$HOME/.local/opt/cyberkde-$app" multiarch
  # Pasta de bibliotecas do prefixo: lib/<multiarch> no Debian/Ubuntu; lib64 ou lib nas outras.
  multiarch=$(dpkg-architecture -qDEB_HOST_MULTIARCH 2>/dev/null || true)
  version=$(QT_QPA_PLATFORM=offscreen "/usr/bin/$app" --version 2>/dev/null | awk '{print $2}')
  tag="v$version"
  build_deps "$app" "$app" || exit 1
  if [[ ! -d $src/.git ]]; then
    git clone -q --depth 1 -b "$tag" "https://invent.kde.org/$repo.git" "$src"
  elif [[ $(git -C "$src" describe --tags 2>/dev/null) != "$tag" ]]; then
    git -C "$src" fetch -q --depth 1 origin tag "$tag"
    git -C "$src" checkout -q -f "$tag"
  fi
  git -C "$src" checkout -q -f -- .
  git -C "$src" apply "$project/$app/"*.patch
  cmake -S "$src" -B "$build" -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    -DCMAKE_INSTALL_PREFIX="$prefix" -DCMAKE_INSTALL_RPATH="${multiarch:+$prefix/lib/$multiarch;}$prefix/lib64;$prefix/lib" >/dev/null
  compilar "$build"
  rm -rf "$prefix"
  cmake --install "$build" >/dev/null
  echo "$version" >"$prefix/.cyberkde-version"
  echo "$app $version com patch CyberKDE instalado em $prefix."
}

# Qual app com patch usar: o pacote (/opt, "cyberkde animados") ou a compilação local (~/.local/opt,
# "cyberkde <app>-build"). Antes valia sempre o pacote, e uma compilação mais nova (um efeito novo, como
# a cascata do Konsole) ficava invisível enquanto o pacote antigo estivesse instalado. Agora:
# - só uma das duas existe: ela;
# - as duas: a que foi feita para a versão do app do sistema; se as duas forem (ou nenhuma), a MAIS
#   NOVA (data do binário: a do pacote é a da compilação no CI, preservada pelo dpkg).
# Um pacote novo instalado pelo "animados" volta a ser o mais novo; uma compilação local nova passa na
# frente dele. Quem troca é o lançador (~/.local/bin/<app>), na próxima aplicação da fase: nenhum app
# aberto é encerrado, e a troca vale para os que abrirem depois.
# Versão do app do sistema ("<app> --version" sobe o Qt: ~0,25 s). Em cache pela data do binário, porque
# o status --json pergunta por vários efeitos do Konsole de uma vez.
app_versao_sistema() {  # app
  local bin="/usr/bin/$1" cache="${XDG_CACHE_HOME:-$HOME/.cache}/cyberkde/versao-$1" chave v
  [[ -x $bin ]] || return 0
  chave=$(stat -c '%Y:%s' -- "$bin" 2>/dev/null)
  if [[ -s $cache && $(head -1 "$cache") == "$chave" ]]; then sed -n 2p "$cache"; return 0; fi
  # offscreen: fora de uma sessão gráfica (testes, TTY) o Qt abortava sem tela e deixava core dump.
  v=$(QT_QPA_PLATFORM=offscreen "$bin" --version 2>/dev/null | awk '{print $2}' || true)
  if [[ -n $v ]]; then
    { mkdir -p -- "$(dirname -- "$cache")" && printf '%s\n%s\n' "$chave" "$v" >"$cache"; } 2>/dev/null || true
  fi
  printf '%s\n' "$v"
}

patched_prefix() {  # app -> prefixo, ou nada
  local app=$1 pkg=/opt/cyberkde-$1 loc=$HOME/.local/opt/cyberkde-$1 sistema pv lv
  if [[ ! -x $pkg/bin/$app ]]; then pkg=""; fi
  if [[ ! -x $loc/bin/$app ]]; then loc=""; fi
  if [[ -z $pkg || -z $loc ]]; then
    if [[ -n $pkg$loc ]]; then echo "${pkg:-$loc}"; fi
    return 0
  fi
  sistema=$(app_versao_sistema "$app")
  pv=$(cat "$pkg/.cyberkde-version" 2>/dev/null || true)
  lv=$(cat "$loc/.cyberkde-version" 2>/dev/null || true)
  if [[ -n $sistema && $pv == "$sistema" && $lv != "$sistema" ]]; then echo "$pkg"
  elif [[ -n $sistema && $lv == "$sistema" && $pv != "$sistema" ]]; then echo "$loc"
  elif [[ $loc/bin/$app -nt $pkg/bin/$app ]]; then echo "$loc"
  else echo "$pkg"; fi
}

# Aponta o comando e o atalho do app para a versão compilada (originais guardados).
use_patched() {  # app id-do-atalho
  local app=$1 desktop=$2 prefix wrapper="$HOME/.local/bin/$1"
  prefix=$(patched_prefix "$app")
  if [[ -z $prefix || ! -x $prefix/bin/$app ]]; then
    echo "Opcional: $app animado não instalado (cyberkde animados)." >&2
    exit 1
  fi
  local system_version plugins
  plugins=$(find "$prefix"/lib* -maxdepth 2 -type d -name plugins -print -quit 2>/dev/null || true)
  system_version=$(app_versao_sistema "$app")
  if [[ $(cat "$prefix/.cyberkde-version") != "$system_version" ]]; then
    echo "Aviso: o $app do sistema foi atualizado para $system_version; rode 'cyberkde $app-build'." >&2
  fi
  put_file "$wrapper" <<EOF
#!/bin/sh
# CyberKDE: $app com patch próprio (compilado por 'cyberkde $app-build').
prefix="$prefix"
export QT_PLUGIN_PATH="${plugins:-$prefix/lib/plugins}\${QT_PLUGIN_PATH:+:\$QT_PLUGIN_PATH}"
exec "\$prefix/bin/$app" "\$@"
EOF
  chmod +x "$wrapper"
  sed "s|^Exec=$app|Exec=$wrapper|" "/usr/share/applications/$desktop.desktop" |
    put_file "$data/applications/$desktop.desktop"
}

# Dolphin com cascata de carregamento: atalho, comando e serviço D-Bus "Mostrar na pasta".
phase_carregamento() {
  use_patched dolphin org.kde.dolphin
  local service
  for service in org.freedesktop.FileManager1 org.kde.dolphin.FileManager1; do
    # Sem SystemdService, o D-Bus usa o Exec abaixo em vez do serviço do sistema.
    printf '[D-BUS Service]\nName=org.freedesktop.FileManager1\nExec=%s --daemon\n' "$dolphin_wrapper" |
      put_file "$data/dbus-1/services/$service.service"
  done
}

# Fases na ordem do "cyberkde on" (tudo); os módulos acrescentam as suas ao serem carregados.
CYBERKDE_PHASES=(dolphin apps janelas carregamento icones konsole konsole-anim)
CYBERKDE_FASES_OPCIONAIS=()   # fases fora do "on" (tudo), só com "cyberkde on <fase>"
CYBERKDE_INSTALLS=()  # funções install_<módulo>, chamadas por install_files
CYBERKDE_OFF_HOOKS=(off_apps) # funções off_<módulo>, chamadas no fim do "off"
CYBERKDE_PRE_OFF_HOOKS=()     # chamadas no começo do "off", antes de devolver chaves e arquivos

# O que o painel e o "cyberkde fases" mostram de cada fase. Os módulos descrevem as suas ao carregar.
declare -A CYBERKDE_FASE_NOME=() CYBERKDE_FASE_GRUPO=() CYBERKDE_FASE_SUDO=() CYBERKDE_FASE_DESC=() CYBERKDE_FASE_NOME_EN=() CYBERKDE_FASE_DESC_EN=()
# grupo: apps | janelas | sistema | login. sudo: sim quando a fase grava fora da pasta do usuário.
declare -A CYBERKDE_GRUPO_NOME=([apps]="Aplicativos" [janelas]="Janelas" [sistema]="Sistema" [login]="Login e bloqueio")
declare -A CYBERKDE_GRUPO_NOME_EN=([apps]="Applications" [janelas]="Windows" [sistema]="System" [login]="Login and lock screen")
# Sem aspas nem barras invertidas no nome e na descrição: vão para o JSON sem escape.
# Os dois últimos (opcionais) são o nome e a descrição em inglês, para o painel em inglês.
descreve_fase() {  # id nome grupo sim|nao descrição [nome-en descrição-en]
  CYBERKDE_FASE_NOME[$1]=$2
  CYBERKDE_FASE_GRUPO[$1]=$3
  CYBERKDE_FASE_SUDO[$1]=$4
  CYBERKDE_FASE_DESC[$1]=$5
  CYBERKDE_FASE_NOME_EN[$1]=${6:-$2}
  CYBERKDE_FASE_DESC_EN[$1]=${7:-$5}
}
descreve_fase dolphin "Dolphin" apps nao "Estilo e cores do tema no gerenciador de arquivos." \
  "Dolphin" "Theme style and colors in the file manager."
descreve_fase apps "Aplicativos" apps nao "Estilo chanfrado e cores do tema em todos os apps Qt e KDE." \
  "Applications" "Chamfered style and theme colors in every Qt and KDE app."
descreve_fase janelas "Janelas" janelas nao "Moldura das janelas e animação ao abrir e fechar." \
  "Windows" "Window frames and the open and close animation."
descreve_fase carregamento "Dolphin animado" apps nao "Cascata de itens ao abrir pastas (pede o cyberkde animados)." \
  "Animated Dolphin" "Items cascade in when a folder opens (needs cyberkde animados)."
descreve_fase icones "Ícones do Dolphin" apps nao "Ícones de pastas e locais do tema, só no Dolphin." \
  "Dolphin icons" "Theme icons for folders and places, in Dolphin only."
descreve_fase konsole "Konsole" apps nao "Perfil e cores do tema no terminal." \
  "Konsole" "Theme profile and colors in the terminal."
descreve_fase konsole-anim "Konsole animado" apps nao "Texto e cursor animados no terminal (pede o cyberkde animados)." \
  "Animated Konsole" "Animated text and cursor in the terminal (needs cyberkde animados)."

# A fase pode rodar nesta máquina? (app compilado presente, layout escolhido.) Não diz se está ligada.
fase_disponivel() {  # fase
  case $1 in
    carregamento) [[ -x /opt/cyberkde-dolphin/bin/dolphin || -x $HOME/.local/opt/cyberkde-dolphin/bin/dolphin ]] ;;
    konsole-anim) [[ -x /opt/cyberkde-konsole/bin/konsole || -x $HOME/.local/opt/cyberkde-konsole/bin/konsole ]] ;;
    barra-e-dock) layout_tema ;;
    *) return 0 ;;
  esac
}

# Módulos em modules/<nome>/phase.sh (contrato em modules/CONTRATO.md).
for module in "$project"/modules/*/phase.sh; do
  [[ -f $module ]] && source "$module"
done
# A barra e a dock por último: o Latte (re)iniciado por ela tem de subir já com o tema de ícones e o
# tema do Plasma aplicados, senão fica com os ícones antigos até reiniciar.
fases_ordenadas=()
for p in "${CYBERKDE_PHASES[@]}"; do [[ $p == barra-e-dock ]] || fases_ordenadas+=("$p"); done
if [[ " ${CYBERKDE_PHASES[*]} " == *" barra-e-dock "* ]]; then fases_ordenadas+=(barra-e-dock); fi
CYBERKDE_PHASES=("${fases_ordenadas[@]}")
unset fases_ordenadas p

